@using System.Globalization
@using ControleAnaliseDesembolso.Modelos
@using ControleAnaliseDesembolso.Service

<div class="drp">

    <div class="drp-subfiltros">
        <button class="drp-subfiltro @(_subFiltro == "drp" ? "drp-subfiltro-ativo" : "")" @onclick='() => SelecionarSubFiltro("drp")'>
            Aguardando Baixa (DRP)
        </button>
        <button class="drp-subfiltro @(_subFiltro == "rejeitado" ? "drp-subfiltro-ativo" : "")" @onclick='() => SelecionarSubFiltro("rejeitado")'>
            Rejeitado/Cancelado
        </button>
        <button class="drp-subfiltro @(_subFiltro == "desembolsados" ? "drp-subfiltro-ativo" : "")" @onclick='() => SelecionarSubFiltro("desembolsados")'>
            Desembolsados
        </button>

        @if (_subFiltro == "drp")
        {
            <button class="drp-btn-baixa drp-btn-baixa-subfiltro" @onclick="AbrirBaixaSelecionados"
                    disabled="@(_selecionados.Count == 0)"
                    title="@(_selecionados.Count == 0 ? "Selecione ao menos um registro" : "Baixar selecionados")">
                <i class="bi bi-check2-square"></i>
                <span>Baixa</span>
                @if (_selecionados.Count > 0)
                {
                    <span class="drp-btn-baixa-num">@_selecionados.Count</span>
                }
            </button>
        }
    </div>

    <div class="drp-topo">
        <div class="drp-topo-info">
            <span class="drp-topo-titulo">Relatórios · DRP</span>
            <span class="drp-topo-sub">
                @_registrosFiltrados.Count de @_registrosDoSubFiltro.Count @(_registrosDoSubFiltro.Count == 1 ? "registro" : "registros")
                @if (_selecionados.Count > 0)
                {
                    <span class="drp-topo-selecao">· @_selecionados.Count selecionado@(_selecionados.Count > 1 ? "s" : "")</span>
                }
            </span>
        </div>

        <div class="drp-topo-filtros">
            <select class="select-periodo" value="@_periodoFiltro" @onchange="@((ChangeEventArgs e) => SelecionarPeriodo((string)e.Value!))" title="Filtrar por período">
                <option value="5">Últimos 5 dias</option>
                <option value="15">Últimos 15 dias</option>
                <option value="30">Últimos 30 dias</option>
                <option value="todos">Todos</option>
            </select>

            <div class="busca-tabela">
                <i class="bi bi-search"></i>
                <input type="text" placeholder="Buscar..." @bind="_textoBusca" @bind:event="oninput" @bind:after="() => _paginaAtual = 1" />
            </div>
        </div>
    </div>

    @if (_carregando)
    {
        <div class="drp-vazio"><i class="bi bi-arrow-repeat spin"></i> <span>Carregando…</span></div>
    }
    else
    {
    <div class="drp-scroll">
        <table class="drp-tabela">
            <thead>
                <tr>
                    <th class="drp-col-check">
                        <input type="checkbox"
                               checked="@TodosSelecionados"
                               @onchange="AlternarTodos"
                               title="Selecionar todos aguardando baixa" />
                    </th>
                    <th class="drp-center drp-th-ordenavel" @onclick='() => OrdenarPor("gigov")'>GIGOV @IconeOrdenacao("gigov")</th>
                    <th>Contrato AF</th>
                    <th class="drp-center drp-th-ordenavel" @onclick='() => OrdenarPor("tipo")'>Tipo @IconeOrdenacao("tipo")</th>
                    <th class="drp-num drp-th-ordenavel" @onclick='() => OrdenarPor("valor")'>Valor FGTS @IconeOrdenacao("valor")</th>
                    <th class="drp-th-ordenavel" @onclick='() => OrdenarPor("solicitacao")'>Solicitação @IconeOrdenacao("solicitacao")</th>
                    <th class="drp-th-ordenavel" @onclick='() => OrdenarPor("responsavel")'>Responsável @IconeOrdenacao("responsavel")</th>
                    <th class="drp-th-ordenavel" @onclick='() => OrdenarPor("gestor")'>Gestor @IconeOrdenacao("gestor")</th>
                    <th class="drp-center drp-th-ordenavel" @onclick='() => OrdenarPor("status")'>Status @IconeOrdenacao("status")</th>
                    <th class="drp-col-acao drp-center"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in _registrosPaginados)
                {
                    <tr class="drp-linha-clicavel @(_selecionados.Contains(r.Id) ? "drp-linha-sel" : "") @(r.Baixado || r.Rejeitado || r.Cancelado ? "drp-linha-baixada" : "")"
                        @onclick="() => AbrirResumo(r)">
                        <td class="drp-col-check" @onclick:stopPropagation>
                            <input type="checkbox"
                                   checked="@_selecionados.Contains(r.Id)"
                                   disabled="@(r.Baixado || r.Rejeitado || r.Cancelado)"
                                   @onchange="() => AlternarSelecao(r.Id)" />
                        </td>
                        <td class="drp-center"><span class="drp-gigov">@r.Gigov</span></td>
                        <td class="drp-mono">@r.ContratoDv</td>
                        <td class="drp-center">
                            <span class="drp-tipo drp-tipo-@r.TipoDesembolso">
                                @(r.TipoDesembolso == "ADIANTAMENTO" ? "Adiantamento" : "Corrente")
                            </span>
                        </td>
                        <td class="drp-num drp-valor">@r.ValorFgts.ToString("C", _br)</td>
                        <td class="drp-mono-dim">@r.DataSolicitacao.ToString("dd/MM/yyyy")</td>
                        <td class="drp-matricula">@r.ResponsavelBaixa</td>
                        <td class="drp-matricula">@r.Gestor</td>
                        <td class="drp-center">
                            @if (r.Baixado)
                            {
                                <span class="drp-status drp-status-ok" title="Baixado por @r.ResponsavelDesembolso">
                                    <i class="bi bi-check-circle-fill"></i> Baixado
                                    <span class="drp-status-por">@r.ResponsavelDesembolso</span>
                                </span>
                            }
                            else if (r.Rejeitado)
                            {
                                <span class="drp-status drp-status-rejeitado" title="Rejeitado por @r.ResponsavelBaixa">
                                    <i class="bi bi-x-circle-fill"></i> Rejeitado
                                </span>
                            }
                            else if (r.Cancelado)
                            {
                                <span class="drp-status drp-status-rejeitado" title="Cancelado">
                                    <i class="bi bi-slash-circle-fill"></i> Cancelado
                                </span>
                            }
                            else
                            {
                                <span class="drp-status drp-status-aguardando">
                                    <i class="bi bi-clock"></i> Aguardando
                                </span>
                            }
                        </td>
                        <td class="drp-col-acao drp-center" @onclick:stopPropagation>
                            <div class="drp-acoes-linha">
                                @if (!r.Baixado && !r.Rejeitado && !r.Cancelado)
                                {
                                    <button class="drp-acao-linha" @onclick="() => AbrirBaixaUnico(r.Id)" title="Baixar este">
                                        <i class="bi bi-check2"></i>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (!_registrosFiltrados.Any())
    {
        <div class="drp-vazio">
            <i class="bi bi-search"></i>
            <span>Nenhum registro encontrado para esse filtro.</span>
        </div>
    }

    @if (_registrosFiltrados.Any() && _totalPaginas > 1)
    {
        <div class="paginacao">
            <button class="btn-pagina" disabled="@(_paginaAtual <= 1)" @onclick="() => _paginaAtual--">
                <i class="bi bi-chevron-left"></i>
            </button>
            <span class="paginacao-info">Página @_paginaAtual de @_totalPaginas (@_registrosFiltrados.Count no total)</span>
            <button class="btn-pagina" disabled="@(_paginaAtual >= _totalPaginas)" @onclick="() => _paginaAtual++">
                <i class="bi bi-chevron-right"></i>
            </button>
        </div>
    }
    }
</div>

@if (_dialogAberto)
{
    <DialogSenhaBaixa Quantidade="_idsParaBaixar.Count"
                      AoCancelar="FecharDialog"
                      AoConfirmar="ConfirmarBaixa" />
}

@if (_resumoDesembolso is not null)
{
    <DialogResumoDrp Desembolso="_resumoDesembolso"
                     Todos="_desembolsosParaResumo"
                     AoFechar="() => _resumoDesembolso = null"
                     AoNavegar="id => _resumoDesembolso = _desembolsosParaResumo.FirstOrDefault(d => d.Id == id)" />
}

@inject ControleAnaliseDesembolsoService Service
@inject ServicoUsuarioUI ServicoUsuario

@code {
    private static readonly CultureInfo _br = new("pt-BR");

    private List<RegistroDrp> _registros = [];
    private readonly HashSet<int> _selecionados = [];
    private bool _dialogAberto;
    private List<int> _idsParaBaixar = [];
    private bool _carregando = true;

    private List<DesembolsoCAD> _desembolsosParaResumo = [];
    private DesembolsoCAD? _resumoDesembolso;

    private const int ItensPorPagina = 10;
    private int    _paginaAtual   = 1;
    private string _periodoFiltro = "todos";
    private string _textoBusca    = "";

    private string _subFiltro = "drp";

    private void SelecionarSubFiltro(string filtro)
    {
        _subFiltro = filtro;
        _paginaAtual = 1;
    }

    private List<RegistroDrp> _registrosDoSubFiltro => _subFiltro switch
    {
        "rejeitado"     => _registros.Where(r => r.Rejeitado || r.Cancelado).ToList(),
        "desembolsados" => _registros.Where(r => r.Baixado).ToList(),
        _               => _registros.Where(r => !r.Baixado && !r.Rejeitado && !r.Cancelado).ToList(),
    };

    private List<RegistroDrp> _registrosFiltrados => AplicarOrdenacao(AplicarBusca(AplicarFiltroPeriodo(_registrosDoSubFiltro)));

    private string _colunaOrdenacao = "";
    private bool   _ordemAscendente = true;

    private void OrdenarPor(string coluna)
    {
        if (_colunaOrdenacao == coluna)
            _ordemAscendente = !_ordemAscendente;
        else
        {
            _colunaOrdenacao = coluna;
            _ordemAscendente = true;
        }
    }

    private MarkupString IconeOrdenacao(string coluna)
    {
        if (_colunaOrdenacao != coluna) return (MarkupString)"";
        var icone = _ordemAscendente ? "bi-caret-up-fill" : "bi-caret-down-fill";
        return (MarkupString)$"<i class=\"bi {icone} drp-icone-ordenacao\"></i>";
    }

    private List<RegistroDrp> AplicarOrdenacao(List<RegistroDrp> lista)
    {
        if (string.IsNullOrEmpty(_colunaOrdenacao)) return lista;

        IOrderedEnumerable<RegistroDrp> ordenado = _colunaOrdenacao switch
        {
            "gigov"       => lista.OrderBy(r => r.Gigov, StringComparer.OrdinalIgnoreCase),
            "tipo"        => lista.OrderBy(r => r.TipoDesembolso, StringComparer.OrdinalIgnoreCase),
            "valor"       => lista.OrderBy(r => r.ValorFgts),
            "solicitacao" => lista.OrderBy(r => r.DataSolicitacao),
            "responsavel" => lista.OrderBy(r => ValorNumericoMatricula(r.ResponsavelBaixa)),
            "gestor"      => lista.OrderBy(r => ValorNumericoMatricula(r.Gestor)),
            "status"      => lista.OrderBy(r => r.Baixado),
            _             => lista.OrderBy(r => 0)
        };

        return _ordemAscendente ? ordenado.ToList() : ordenado.Reverse().ToList();
    }

    private static long ValorNumericoMatricula(string matricula)
    {
        var digitos = new string(matricula.Where(char.IsDigit).ToArray());
        return long.TryParse(digitos, out var numero) ? numero : 0;
    }

    private int _totalPaginas => Math.Max(1, (int)Math.Ceiling(_registrosFiltrados.Count / (double)ItensPorPagina));

    private List<RegistroDrp> _registrosPaginados =>
        _registrosFiltrados.Skip((PaginaAtualValidada - 1) * ItensPorPagina).Take(ItensPorPagina).ToList();

    private int PaginaAtualValidada => Math.Min(_paginaAtual, _totalPaginas);

    private void SelecionarPeriodo(string periodo)
    {
        _periodoFiltro = periodo;
        _paginaAtual = 1;
    }

    private List<RegistroDrp> AplicarFiltroPeriodo(List<RegistroDrp> lista)
    {
        if (_periodoFiltro == "todos") return lista;
        var dias = int.Parse(_periodoFiltro);
        var limite = DateTime.Today.AddDays(-dias);
        return lista.Where(r => r.DataSolicitacao >= limite).ToList();
    }

    private List<RegistroDrp> AplicarBusca(List<RegistroDrp> lista)
    {
        if (string.IsNullOrWhiteSpace(_textoBusca)) return lista;
        var termo = _textoBusca.Trim();
        return lista.Where(r =>
            r.ContratoDv.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
            r.Gigov.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
            r.ResponsavelBaixa.Contains(termo, StringComparison.OrdinalIgnoreCase) ||
            r.Gestor.Contains(termo, StringComparison.OrdinalIgnoreCase)
        ).ToList();
    }

    protected override async Task OnInitializedAsync()
    {
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        try
        {
            _registros = await Service.ObterRegistrosDrpAsync();

            var idsDrp = _registros.Select(r => r.Id.ToString()).ToHashSet();
            _desembolsosParaResumo = (await Service.ObterTodosAsync())
                .Where(d => idsDrp.Contains(d.Id))
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DRP] Falha ao carregar: {ex.Message}");
            _registros = [];
            _desembolsosParaResumo = [];
        }
        finally
        {
            _carregando = false;
        }
    }

    private void AbrirResumo(RegistroDrp r)
    {
        _resumoDesembolso = _desembolsosParaResumo.FirstOrDefault(d => d.Id == r.Id.ToString());
    }

    private IEnumerable<RegistroDrp> Baixaveis => _registros.Where(r => !r.Baixado && !r.Rejeitado && !r.Cancelado);
    private bool TodosSelecionados => Baixaveis.Any() && Baixaveis.All(r => _selecionados.Contains(r.Id));

    private void AlternarSelecao(int id)
    {
        if (!_selecionados.Remove(id))
            _selecionados.Add(id);
    }

    private void AlternarTodos()
    {
        if (TodosSelecionados)
            _selecionados.Clear();
        else
            foreach (var r in Baixaveis)
                _selecionados.Add(r.Id);
    }

    private void AbrirBaixaSelecionados()
    {
        if (_selecionados.Count == 0) return;
        _idsParaBaixar = _selecionados.ToList();
        _dialogAberto = true;
    }

    private void AbrirBaixaUnico(int id)
    {
        _idsParaBaixar = [id];
        _dialogAberto = true;
    }

    private void FecharDialog()
    {
        _dialogAberto = false;
        _idsParaBaixar = [];
    }

    private async Task ConfirmarBaixa(string senha)
    {
        try
        {
            await Service.BaixarDrpAsync(_idsParaBaixar, senha);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DRP] Falha ao baixar: {ex.Message}");
        }

        foreach (var id in _idsParaBaixar)
            _selecionados.Remove(id);

        FecharDialog();
        await CarregarAsync();
    }
}


<style>
.drp {
    background: #fff;
    border: 1px solid var(--ink-100);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    overflow: hidden;
}

.drp-subfiltros {
    display: flex;
    gap: 6px;
    padding: 10px 18px 0;
}
.drp-subfiltro {
    border-radius: var(--radius-full);
    padding: 6px 14px;
    font-size: 11.5px;
    font-weight: 700;
    font-family: inherit;
    color: var(--ink-500);
    background: var(--ink-100);
    border: none;
    cursor: pointer;
    transition: background .15s, color .15s;
}
.drp-subfiltro:hover { background: var(--ink-200); }
.drp-subfiltro-ativo { background: var(--brand-700); color: #fff; }
.drp-subfiltro-ativo:hover { background: var(--brand-800, #004F93); color: #fff; }
.drp-btn-baixa-subfiltro { margin-left: auto; }

.drp-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 18px;
    border-bottom: 1px solid var(--ink-100);
    background: #FAFBFC;
}
.drp-topo-info { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
.drp-topo-titulo {
    font-size: 12.5px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .1em; color: var(--ink-500);
}
.drp-topo-sub { font-size: 11.5px; color: var(--ink-400, var(--ink-300)); }
.drp-topo-selecao { color: var(--brand-700); font-weight: 600; }

.drp-topo-filtros { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }

.select-periodo {
    border-radius: var(--radius-lg);
    border: 1px solid var(--ink-100);
    background: #fff;
    padding: 6px 10px;
    box-shadow: var(--shadow-card);
    font-size: 11.5px;
    font-weight: 600;
    color: var(--ink-700);
    font-family: inherit;
    cursor: pointer;
}

.busca-tabela {
    display: flex;
    align-items: center;
    gap: 6px;
    border-radius: var(--radius-lg);
    border: 1px solid var(--ink-100);
    background: #fff;
    padding: 6px 10px;
    box-shadow: var(--shadow-card);
}
.busca-tabela i { font-size: 12px; color: var(--ink-400, var(--ink-300)); }
.busca-tabela input {
    border: none;
    outline: none;
    font-size: 11.5px;
    font-family: inherit;
    color: var(--ink-900);
    width: 140px;
}

.drp-vazio {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 28px 0;
    color: var(--ink-400, var(--ink-300));
    font-size: 12.5px;
}
.drp-vazio .spin { display: inline-block; animation: drp-girar .8s linear infinite; }
@@keyframes drp-girar { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.paginacao {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 16px 0 4px;
}

.btn-pagina {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-md);
    border: 1px solid var(--ink-100);
    background: #fff;
    color: var(--ink-700);
    cursor: pointer;
    transition: background .15s;
}
.btn-pagina:hover:not(:disabled) { background: var(--ink-50); }
.btn-pagina:disabled { opacity: .4; cursor: not-allowed; }

.paginacao-info { font-size: 11.5px; font-weight: 600; color: var(--ink-500); }

.drp-btn-baixa {
    display: inline-flex; align-items: center; gap: 6px;
    background: var(--brand-700); color: #fff;
    border-radius: var(--radius-lg);
    padding: 8px 16px;
    font-size: 12.5px; font-weight: 700; font-family: inherit;
    box-shadow: var(--shadow-card);
    transition: background .15s, opacity .15s;
    flex-shrink: 0;
}
.drp-btn-baixa:hover:not(:disabled) { background: var(--brand-800, #004F93); }
.drp-btn-baixa:disabled { opacity: .4; cursor: not-allowed; }
.drp-btn-baixa-num {
    display: inline-flex; align-items: center; justify-content: center;
    background: #fff;
    color: var(--brand-700);
    border-radius: var(--radius-full);
    padding: 0 6px; font-size: 11.5px; font-weight: 700;
    min-width: 18px; height: 18px; text-align: center;
    font-variant-numeric: tabular-nums;
}

.drp-scroll { overflow-x: auto; }

.drp-tabela {
    width: 100%;
    border-collapse: collapse;
    font-size: 12.5px;
    min-width: 860px;
}
.drp-tabela thead th {
    text-align: left;
    padding: 10px 12px;
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: var(--ink-500);
    background: #fff;
    border-bottom: 1px solid var(--ink-200);
    white-space: nowrap;
}
.drp-tabela thead th.drp-center,
.drp-tabela thead th.drp-col-check { text-align: center; }
.drp-tabela thead th.drp-num { text-align: right; }
.drp-th-ordenavel { cursor: pointer; user-select: none; }
.drp-th-ordenavel:hover { color: var(--brand-700); }
.drp-icone-ordenacao { margin-left: 4px; font-size: 9px; color: var(--brand-700); }
.drp-tabela tbody td {
    padding: 11px 12px;
    border-bottom: 1px solid var(--ink-50);
    color: var(--ink-900);
    white-space: nowrap;
}
.drp-linha-clicavel { cursor: pointer; }
.drp-tabela tbody tr:hover { background: var(--brand-50); }
.drp-tabela tbody tr.drp-linha-sel { background: var(--brand-50); }
.drp-tabela tbody tr.drp-linha-sel:hover { background: var(--brand-100); }
.drp-tabela tbody tr.drp-linha-baixada { opacity: .62; }

.drp-col-check { width: 36px; text-align: center; }
.drp-col-check input { width: 15px; height: 15px; accent-color: var(--brand-700); cursor: pointer; }
.drp-col-check input:disabled { cursor: not-allowed; }
.drp-col-acao { width: 70px; }

.drp-num { text-align: right; }
.drp-valor { font-weight: 700; font-variant-numeric: tabular-nums; }
.drp-center { text-align: center; }

.drp-gigov {
    font-size: 10.5px; font-weight: 700; color: var(--brand-700);
    background: var(--brand-50);
    padding: 2px 8px; border-radius: var(--radius-full);
}
.drp-mono     { font-family: var(--font-mono, monospace); font-variant-numeric: tabular-nums; }
.drp-mono-dim { font-variant-numeric: tabular-nums; color: var(--ink-700); }
.drp-matricula {
    font-family: var(--font-mono, monospace);
    color: var(--ink-700);
    letter-spacing: .02em;
}

.drp-tipo {
    font-size: 10.5px; font-weight: 600;
    padding: 2px 8px; border-radius: var(--radius-full);
