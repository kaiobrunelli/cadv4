@inject ServicoUsuarioUI ServicoUsuario
@inject ControleAnaliseDesembolsoService Service
@inject ISnackbar Snackbar
@using System.Net.Http.Json
@using System.Globalization
@using ControleAnaliseDesembolso.Modelos
@using ControleAnaliseDesembolso.Service

<div class="overlay-dfp" @onclick="FecharDialog">
    <div class="dfp" @onclick:stopPropagation role="dialog" aria-modal="true">

        <div class="dfp-topbar">
            <div class="dfp-id">
                <i class="bi bi-file-text"></i>
                <span class="dfp-id-label">Desembolso ID</span>
                <span class="dfp-id-num">@Desembolso.NumId</span>
                @if (!string.IsNullOrEmpty(Desembolso.Gigov))
                {
                    <span class="dfp-id-separador">-</span>
                    <span class="dfp-id-label">GIGOV</span>
                    <span class="dfp-id-num">@Desembolso.Gigov</span>
                }
            </div>
            <div class="dfp-topbar-right">
                <div class="nav-pill-group">
                    <button class="btn-nav" @onclick="Anterior" disabled="@(!TemAnterior)" title="Anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="nav-pos">@(IndiceAtual + 1)/@Todos.Count</span>
                    <button class="btn-nav" @onclick="Proximo" disabled="@(!TemProximo)" title="Próximo">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                <button class="btn-fechar" @onclick="FecharDialog" title="Fechar (Esc)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        @if (_carregandoDetalhe)
        {
            <div class="dfp-painel-placeholder" style="padding:60px;">
                <i class="bi bi-arrow-repeat spin"></i>
                <p>Carregando…</p>
            </div>
        }
        else if (_detalhe is null)
        {
            <div class="dfp-painel-placeholder" style="padding:60px;">
                <i class="bi bi-exclamation-triangle"></i>
                <p>Não foi possível carregar este desembolso.</p>
            </div>
        }
        else
        {
            var checklist = MontarChecklist();
            var totalValidas = checklist.Count(v => v.Status == "valido");
            var totalInvalidas = checklist.Count(v => v.Status == "invalido");
            var totalPendentes = checklist.Count(v => v.Status == "pendente");
            var podeAprovar = totalInvalidas == 0 && totalPendentes == 0;
            // Usa _detalhe.Status (recarregado por CarregarDetalheAsync a cada
            // ação), não Desembolso.Status — esse é um [Parameter] passado
            // pelo componente pai UMA vez, na hora de abrir o dialog, e nunca
            // mais atualizado enquanto o dialog fica aberto. Usar ele aqui
            // fazia macroJaRodou continuar "false" mesmo logo depois de
            // validar (1 = Pendente, o único status onde a macro ainda não
            // rodou) — só corrigia fechando e reabrindo o dialog, porque aí
            // sim o componente pai relia a lista inteira com o status novo.
            var macroJaRodou = _detalhe.Status != 1;
            // Mesmo motivo: a pilula do cabeçalho usava Desembolso.Status
            // (stale) e continuava mostrando "Pendência" mesmo depois de
            // validar, até fechar e reabrir o dialog.
            var statusAtual = ControleAnaliseDesembolsoService.MapearStatus(_detalhe.Status);

            <div class="fpd-stepper">
                @StepHeader(1, "bi-file-earmark-text", "Dados do Contrato")
                <div class="fpd-step-linha @(_etapaAtual > 1 ? "concluida" : "")"></div>
                @StepHeader(2, "bi-check2-square", "Validações")
                <div class="fpd-step-linha @(_etapaAtual > 2 ? "concluida" : "")"></div>
                @StepHeader(3, "bi-clock-history", "Histórico")
            </div>

            @if (_etapaAtual == 1)
            {
                <div class="dfp-header dfp-header-etapa">
                    <div class="dfp-titulo-row">
                        <div class="dfp-titulo-left">
                            <div class="dfp-name-row">
                                <h2 class="dfp-mutuario" title="@_detalhe.MutuarioFinal">@_detalhe.MutuarioFinal</h2>
                            </div>
                            <div class="dfp-meta-row">
                                <PilulhaStatus Status="@statusAtual" Tamanho="sm" />
                                <span class="dfp-prazo-chip">
                                    <i class="bi bi-calendar3"></i>
                                    Prazo:&nbsp;<strong>@_detalhe.DtPrazo.ToString("dd MMM", new CultureInfo("pt-BR"))</strong>
                                </span>
                                @if (_detalhe.PrimeiroDesembolso)
                                {
                                    <span class="dfp-badge-destaque"><i class="bi bi-flag-fill"></i> Primeiro desembolso</span>
                                }
                                @if (_detalhe.UltimoDesembolso)
                                {
                                    <span class="dfp-badge-destaque"><i class="bi bi-flag-fill"></i> Último desembolso</span>
                                }
                                @if (_detalhe.TipoDesembolso == "ADIANTAMENTO" || (!_detalhe.PrimeiroDesembolso && !_detalhe.UltimoDesembolso))
                                {
                                    <span class="dfp-badge-tipo @(_detalhe.TipoDesembolso == "ADIANTAMENTO" ? "adiantamento" : "")">
                                        @(_detalhe.TipoDesembolso == "ADIANTAMENTO" ? "Adiantamento" : "Normal")
                                    </span>
                                }
                                @if (Analista is not null)
                                {
                                    <div class="analista-mini" style="background: @Analista.Cor">@Analista.Iniciais</div>
                                    <span class="dfp-analista-nome">@Analista.Nome</span>
                                }
                            </div>
                        </div>
                        <div class="dfp-acoes">
                            @if (ServicoUsuario.EhGigov && Desembolso.Status is "pendencia" or "pendente")
                            {
                                <button class="btn-editar-gigov" @onclick="() => _editarFpdAberto = true" title="Editar os dados da FPD (renova o prazo)">
                                    <i class="bi bi-pencil-square"></i> Editar
                                </button>
                            }
                            @if (!ServicoUsuario.EhGigov && !_apenasLeitura)
                            {
                                <button class="btn-validar-macro @(macroJaRodou && !_validandoMacro ? "ja-validado" : "")" @onclick="ExecutarValidacaoMacro" disabled="@(_validandoMacro || macroJaRodou)"
                                        title="@(macroJaRodou ? "Já validado — só roda de novo se a FPD for editada e reenviada" : "Roda a validação automática só pra este desembolso")">
                                    @if (_validandoMacro)
                                    {
                                        <i class="bi bi-arrow-repeat spinner"></i> <span>Validando…</span>
                                    }
                                    else if (macroJaRodou)
                                    {
                                        <i class="bi bi-check2-circle"></i> <span>Já validado</span>
                                    }
                                    else
                                    {
                                        <i class="bi bi-shield-check"></i> <span>Validar</span>
                                    }
                                </button>
                                <button class="btn-vincular" @onclick="() => _popoverAberto = !_popoverAberto">
                                    <i class="bi bi-person"></i>
                                    @(Analista is null ? "Vincular" : "Alterar vínculo")
                                    <i class="bi bi-chevron-down btn-chevron"></i>
                                </button>
                            }
                        </div>
                    </div>

                    <div class="dfp-dados-grid">
                        <div class="dfp-coluna">
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Criado em</span>
                                <span class="dfp-valor dfp-mono">@_detalhe.DtSolicitado.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Contrato AF</span>
                                <span class="dfp-valor dfp-mono">@Desembolso.Contrato</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Contrato AO</span>
                                <span class="dfp-valor dfp-mono @(string.IsNullOrWhiteSpace(_detalhe.ContratoAo) ? "dfp-valor-vazio" : "")">@ExibirTexto(_detalhe.ContratoAo)</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Agente Financeiro</span>
                                <span class="dfp-valor dfp-valor-truncar @(string.IsNullOrWhiteSpace(_detalhe.AgenteFinanceiro) ? "dfp-valor-vazio" : "")" title="@ExibirTexto(_detalhe.AgenteFinanceiro)">@ExibirTexto(_detalhe.AgenteFinanceiro)</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Agente Promotor</span>
                                <span class="dfp-valor dfp-valor-truncar @(string.IsNullOrWhiteSpace(_detalhe.AgentePromotor) ? "dfp-valor-vazio" : "")" title="@ExibirTexto(_detalhe.AgentePromotor)">@ExibirTexto(_detalhe.AgentePromotor)</span>
                            </div>
                            <div class="dfp-linha dfp-linha-last">
                                <span class="dfp-rotulo">Programa</span>
                                <span class="dfp-valor">@ProgramaExibicao(_detalhe.Programa)</span>
                            </div>
                        </div>

                        <div class="dfp-divisor-v"></div>

                        <div class="dfp-coluna">
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Agente Técnico</span>
                                <span class="dfp-valor dfp-valor-truncar @(string.IsNullOrWhiteSpace(_detalhe.AgenteTecnicoOperador) ? "dfp-valor-vazio" : "")" title="@ExibirTexto(_detalhe.AgenteTecnicoOperador)">@ExibirTexto(_detalhe.AgenteTecnicoOperador)</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Tomador / Mutuário</span>
                                <span class="dfp-valor dfp-valor-truncar @(string.IsNullOrWhiteSpace(_detalhe.MutuarioFinal) ? "dfp-valor-vazio" : "")" title="@ExibirTexto(_detalhe.MutuarioFinal)">@ExibirTexto(_detalhe.MutuarioFinal)</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Situação da obra</span>
                                <span class="dfp-valor">@SituacaoObraExibicao(_detalhe.SituacaoObra)</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">DT Engenharia</span>
                                <span class="dfp-valor dfp-mono">@_detalhe.DtEngenharia.ToString("dd/MM/yyyy")</span>
                            </div>
                            <div class="dfp-linha dfp-linha-last">
                                <span class="dfp-rotulo">Matrícula do Gestor</span>
                                <span class="dfp-valor dfp-mono">@_detalhe.MatriculaGestor</span>
                            </div>
                        </div>
                    </div>

                    <div class="dfp-valores">
                        <div class="dfp-secao-titulo">Valores</div>
                        <div class="dfp-valores-split">
                            <div class="dfp-valores-col">
                                <div class="dfp-valores-col-titulo">Desembolso</div>
                                <div class="dfp-linha dfp-linha-destaque">
                                    <span class="dfp-rotulo">Valor solicitado (parcela)</span>
                                    <span class="dfp-valor dfp-mono dfp-valor-destaque">@ServicoMock.FormatarBRL(_detalhe.SolicitadoVi)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">VE (Valor Empréstimo)</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalhe.ValorEmprestimo)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Participação FGTS</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalhe.ParticipacaoFgts)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Desembolsado</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalhe.Desembolsado)</span>
                                </div>
                                <div class="dfp-linha dfp-linha-last">
                                    <span class="dfp-rotulo" title="Calculado: VE - Desembolsado">Saldo a desembolsar</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalhe.ValorEmprestimo - _detalhe.Desembolsado)</span>
                                </div>
                            </div>
                            <div class="dfp-valores-divisor"></div>
                            <div class="dfp-valores-col">
                                <div class="dfp-valores-col-titulo">Contrapartida</div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Contrapartida</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalhe.Contrapartida)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Contrapartida Atual</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalhe.ContrapartidaAtual)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Integralizado</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalhe.Integralizado)</span>
                                </div>
                                <div class="dfp-linha dfp-linha-last">
                                    <span class="dfp-rotulo">Saldo a integralizar</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalhe.SaldoIntegralizar)</span>
                                </div>
                            </div>
                        </div>
                        <div class="dfp-resumo-perc">
                            <div class="dfp-resumo-perc-titulo">Resumo de percentuais</div>
                            <div class="dfp-resumo-perc-grid">
                                <div class="dfp-resumo-perc-item">
                                    <span class="dfp-resumo-perc-rotulo">Obra concluída (BM)</span>
                                    <strong><i class="bi bi-graph-up dfp-resumo-perc-icone"></i>@_detalhe.PercentualObra.ToString("0.000", new CultureInfo("pt-BR"))%</strong>
                                </div>
                                <div class="dfp-resumo-perc-item">
                                    <span class="dfp-resumo-perc-rotulo" title="(Desembolsado + Solicitado VI) / VE">Execução financeira</span>
                                    <strong class="@ClassePercComparado(PercExecucaoFinanceira, _detalhe.PercentualObra)"><i class="bi bi-graph-up dfp-resumo-perc-icone"></i>@FmtPerc(PercExecucaoFinanceira)</strong>
                                </div>
                                <div class="dfp-resumo-perc-item">
                                    <span class="dfp-resumo-perc-rotulo" title="Integralizado / CP Atual">Contrapartida integralizada</span>
                                    <strong><i class="bi bi-graph-up dfp-resumo-perc-icone"></i>@FmtPerc(PercContrapartidaIntegralizada)</strong>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_detalhe.Mensagem))
                        {
                            <div class="dfp-obs-af">
                                <span class="dfp-obs-af-titulo"><i class="bi bi-chat-left-text"></i> OBS AF</span>
                                <p class="dfp-obs-af-texto">@_detalhe.Mensagem</p>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(_detalhe.MotivoRejeicao))
                        {
                            <div class="dfp-obs-af dfp-motivo-rejeicao">
                                <span class="dfp-obs-af-titulo"><i class="bi bi-x-circle"></i> Motivo da rejeição</span>
                                <p class="dfp-obs-af-texto">@_detalhe.MotivoRejeicao</p>
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_etapaAtual == 2)
            {
                <div class="dfp-tabs">
                    <button class="dfp-tab ativa">
                        <i class="bi bi-list-check"></i> Validações
                        <span class="dfp-tab-badge @(totalInvalidas + totalPendentes > 0 ? "pendente" : "ok")">
                            @totalValidas/@checklist.Count
                        </span>
                    </button>
                </div>

                <div class="dfp-etapa-validacoes">
                    @if (!checklist.Any())
                    {
                        <p class="dfp-acc-detalhe">Nenhum item de checklist ativo pra este desembolso.</p>
                    }
                    @foreach (var v in checklist)
                    {
                        var chave = v.CoValidacao.ToString();
                        var aberta = _validacoesAbertas.Contains(chave);

                        <div class="dfp-acc @(aberta ? "aberta" : "")">
                            <button class="dfp-acc-header" @onclick="() => AlternarValidacao(chave)">
                                <span class="dfp-acc-titulo">@v.Titulo</span>
                                @{ var temCampoFicha = TemCampoFicha(v.Titulo, out var respostaFicha); }
                                @if (temCampoFicha)
                                {
                                    <span class="dfp-ficha-pill @(respostaFicha switch { true => "sim", false => "nao", _ => "pendente" })">
                                        @(respostaFicha switch { true => "Sim", false => "Não", _ => "Não respondido" })
                                    </span>
                                }
                                <span class="dfp-acc-spacer"></span>
                                <PilulhaStatus Status="@v.Status" Tamanho="sm" />
                                @if (v.Comentarios.Any())
                                {
                                    <i class="bi bi-chat-text-fill dfp-acc-comm">@v.Comentarios.Count</i>
                                }
                                <i class="bi bi-chevron-down dfp-acc-chevron"></i>
                            </button>
                            <div class="dfp-acc-body">
                                <div class="dfp-acc-inner">
                                    <div class="dfp-acc-corpo">
                                        <FioComentario Comentarios="@v.Comentarios" ApenasLeitura="@(_apenasLeitura || (!ServicoUsuario.EhGigov && !macroJaRodou))"
                                                       ApenasInformativo="@ServicoUsuario.EhGigov"
                                                       AoAdicionarComentario="@(c => AdicionarComentario(v.CoValidacao, c))"
                                                       AoEditarComentario="@(c => EditarComentario(v.CoValidacao, c))"
                                                       AoRemoverComentario="@(c => RemoverComentario(v.CoValidacao, c))" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (_etapaAtual == 3)
            {
                <div class="dfp-corpo">
                    <div class="dfp-timeline">
                        @foreach (var evento in MontarTimeline(checklist))
                        {
                            <div class="dfp-evento @evento.Tipo">
                                <div class="dfp-evento-ponto"><i class="bi @evento.Icone"></i></div>
                                <div class="dfp-evento-corpo">
                                    <div class="dfp-evento-texto">@((MarkupString)evento.Texto)</div>
                                    <div class="dfp-evento-quando">@evento.Quando</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="dfp-rodape">
                @if (_modoRejeicao)
                {
                    <div class="rejeicao-campos">
                        <textarea class="input-justificativa" rows="2" placeholder="Escreva o motivo da rejeição"
                                  @bind="_justificativaRejeicao" @bind:event="oninput"></textarea>
                    </div>
                    <button class="btn-recusar-cancelar" @onclick="CancelarRejeicao">Cancelar</button>
                    <button class="btn-recusar" @onclick="RejeitarDesembolso"
                            disabled="@(string.IsNullOrWhiteSpace(_justificativaRejeicao) || _processandoAcao)">
                        <i class="bi bi-x-circle"></i> Confirmar rejeição
                    </button>
                }
                else
                {
                    <div class="dfp-rodape-status">
                        @if (_apenasLeitura)
                        {
                            <i class="bi @(Desembolso.Status == "aprovado" ? "bi-patch-check ok" : "bi-x-octagon falha")"></i>
                            <span>Desembolso @(Desembolso.Status == "aprovado" ? "aprovado" : "rejeitado") — somente visualização</span>
                        }
                        else if (podeAprovar)
                        {
                            <i class="bi bi-check-circle-fill ok"></i>
                            <span>Todas as validações concluídas — pronto para aprovar</span>
                        }
                        else
                        {
                            <i class="bi bi-lock-fill falha"></i>
                            <span>
                                @if (totalInvalidas > 0) { <text><strong>@totalInvalidas inválida@(totalInvalidas > 1 ? "s" : "")</strong></text> }
                                @if (totalInvalidas > 0 && totalPendentes > 0) { <text> e </text> }
                                @if (totalPendentes > 0) { <text><strong>@totalPendentes em análise</strong></text> }
                                @((totalInvalidas + totalPendentes) > 1 ? " bloqueiam" : " bloqueia") a aprovação
                            </span>
                        }
                    </div>
                    @if (_etapaAtual > 1)
                    {
                        <button class="btn-fpd-etapa-voltar" @onclick="() => _etapaAtual--">
                            <i class="bi bi-chevron-left"></i> <span>Etapa anterior</span>
                        </button>
                    }
                    @if (_etapaAtual < 3)
                    {
                        <button class="btn-fpd-etapa-proxima" @onclick="() => _etapaAtual++">
                            <span>Próxima etapa</span> <i class="bi bi-chevron-right"></i>
                        </button>
                    }
                    @if (!ServicoUsuario.EhGigov && !_apenasLeitura)
                    {
                        <button class="btn-recusar" @onclick="() => _modoRejeicao = true" disabled="@_processandoAcao">
                            <i class="bi bi-x-circle"></i> Recusar desembolso
                        </button>
                        <button class="btn-aprovar" disabled="@(!podeAprovar || _processandoAcao)" @onclick="AprovarDesembolso">
                            @if (_processandoAcao)
                            {
                                <i class="bi bi-arrow-repeat spinner"></i>
                                <span>Processando…</span>
                            }
                            else
                            {
                                <i class="bi @(podeAprovar ? "bi-check-circle" : "bi-lock")"></i>
                                <span>Aprovar desembolso</span>
                            }
                        </button>
                    }
                }
            </div>

            @if (_popoverAberto)
            {
                <div class="overlay-atribuicao" @onclick="() => _popoverAberto = false"></div>
                <div class="popover-atribuicao" @onclick:stopPropagation>
                    <div class="popover-titulo">Atribuir analista</div>
                    <div class="popover-lista">
                        @foreach (var f in Analistas)
                        {
                            <button class="popover-item" @onclick="() => AtribuirAnalista(f)" title="@f.Nome">
                                <div class="popover-avatar" style="background: @f.Cor">@f.Iniciais</div>
                                <span class="popover-item-nome">@f.Nome</span>
                            </button>
                        }
                    </div>
                    @if (Analista is not null)
                    {
                        <button class="popover-remover" @onclick="RemoverAnalista">Remover atribuição</button>
                    }
                </div>
            }
        }
    </div>
</div>

@if (_editarFpdAberto)
{
    <DialogEditarFpd Desembolso="Desembolso"
                      AoFechar="() => _editarFpdAberto = false"
                      AoSalvar="AoSalvarEdicaoFpd" />
}

@code {
    private static readonly Dictionary<string, string> _rotulosPrograma = new()
    {
        ["Pro_Transporte"] = "Pró-Transporte",
        ["Pro_Moradia"]    = "Pró-Moradia",
        ["Saneamento"]     = "Saneamento Para Todos",
        ["Saude"]          = "FGTS-Saúde",
    };

    private static string ProgramaExibicao(string? nomeBruto) =>
        nomeBruto is not null && _rotulosPrograma.TryGetValue(nomeBruto, out var rotulo) ? rotulo : nomeBruto ?? "—";

    private static readonly Dictionary<string, string> _rotulosSituacaoObra = new()
    {
        ["NORMAL"]   = "Normal",
        ["ATRASADO"] = "Atrasado",
    };

    private static string SituacaoObraExibicao(string? nomeBruto) =>
        nomeBruto is not null && _rotulosSituacaoObra.TryGetValue(nomeBruto, out var rotulo) ? rotulo : nomeBruto ?? "—";

    [Parameter, EditorRequired] public DesembolsoCAD       Desembolso { get; set; } = null!;
    [Parameter, EditorRequired] public List<DesembolsoCAD> Todos      { get; set; } = [];
    [Parameter] public Funcionario?  Analista    { get; set; }
    [Parameter] public List<Funcionario> Analistas { get; set; } = [];
    [Parameter] public EventCallback AoFechar    { get; set; }
    [Parameter] public EventCallback<string>       AoNavegar  { get; set; }
    [Parameter] public EventCallback<Funcionario?> AoAtribuir { get; set; }

    private DesembolsoDetalheDto? _detalhe;
    private bool _carregandoDetalhe = true;

    // Quanto do VE já foi (ou está sendo, com esse pedido) desembolsado —
    // comparado com PercentualObra pra ver se o pedido não está pedindo
    // mais do que já foi fisicamente executado na obra.
    private decimal? PercExecucaoFinanceira =>
        _detalhe is { ValorEmprestimo: > 0 }
            ? Math.Round((_detalhe.Desembolsado + _detalhe.SolicitadoVi) / _detalhe.ValorEmprestimo * 100, 3)
            : null;

    // Quanto da contrapartida total do contrato (ContrapartidaAtual) já foi
    // integralizado até agora.
    private decimal? PercContrapartidaIntegralizada =>
        _detalhe is { ContrapartidaAtual: > 0 }
            ? Math.Round(_detalhe.Integralizado / _detalhe.ContrapartidaAtual * 100, 3)
            : null;

    private static string FmtPerc(decimal? p) => p is null ? "—" : $"{p.Value.ToString("0.000", new CultureInfo("pt-BR"))}%";
    private static string ClassePercComparado(decimal? valor, decimal? referencia) =>
        valor is null || referencia is null ? "" : valor <= referencia ? "dfp-perc-ok" : "dfp-perc-alerta";
    private static string ExibirTexto(string? valor) => string.IsNullOrWhiteSpace(valor) ? "Não informado" : valor;
    private int _etapaAtual = 1;
    private readonly HashSet<string> _validacoesAbertas = [];

    private bool _apenasLeitura => Desembolso.Status is "aprovado" or "negado";

    private bool _popoverAberto;
    private bool _modoRejeicao;
    private bool _processandoAcao;
    private bool _validandoMacro;
    private string _justificativaRejeicao = "";
    private bool _editarFpdAberto;

    protected override async Task OnInitializedAsync() => await CarregarDetalheAsync();

    private async Task CarregarDetalheAsync()
    {
        _carregandoDetalhe = true;
        try
        {
            _detalhe = await Service.ObterDetalheDesembolsoAsync(Desembolso.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DialogFPD] Falha ao carregar detalhe: {ex.Message}");
        }
        finally
        {
            _carregandoDetalhe = false;
        }
    }

    private async Task AoSalvarEdicaoFpd()
    {
        _editarFpdAberto = false;
        await AoFechar.InvokeAsync();
    }

    private RenderFragment StepHeader(int numero, string icone, string titulo) =>
        @<button type="button" class="fpd-step @(EstadoEtapa(numero))" @onclick="() => _etapaAtual = numero">
            <span class="fpd-step-num">
                @if (numero < _etapaAtual) { <i class="bi bi-check-lg"></i> } else { @numero }
            </span>
            <span class="fpd-step-titulo">@titulo</span>
        </button>
    ;

    private string EstadoEtapa(int numero) =>
        numero == _etapaAtual ? "atual" : numero < _etapaAtual ? "concluida" : "";

    private void AlternarValidacao(string chave)
    {
        if (!_validacoesAbertas.Add(chave))
            _validacoesAbertas.Remove(chave);
    }

    private sealed class ItemChecklist
    {
        public int CoValidacao { get; set; }
        public string Titulo { get; set; } = "";
        public string Status { get; set; } = "";
        public List<Comentario> Comentarios { get; set; } = [];
    }

    private static string MapSituacao(int situacao) => situacao switch
    {
        1 => "valido",
        2 => "invalido",
        _ => "pendente",
    };

    private List<ItemChecklist> MontarChecklist()
    {
        if (_detalhe is null) return [];
        return _detalhe.Checklist
            .OrderBy(v => v.CoValidacao)
            .Select(v => new ItemChecklist
            {
                CoValidacao = v.CoValidacao,
                Titulo = v.DeValidacao ?? $"Validação {v.CoValidacao}",
                Status = MapSituacao(v.Situacao),
                Comentarios = v.Comentarios.Select(c => new Comentario
                {
                    Id = c.CoMensagem,
                    Tipo = c.TipoMensagem,
                    Texto = c.Texto ?? "",
                    Autor = c.NomeAutor ?? "",
                    MatriculaAutor = c.MatriculaAutor ?? "",
                    UnidadeAutor = c.UnidadeAutor,
                    Timestamp = c.DtCriacao,
                }).ToList(),
            })
            .ToList();
    }

    private bool TemCampoFicha(string? titulo, out bool? resposta)
    {
        resposta = titulo switch
        {
            "Licença de operação" => _detalhe?.LicensaOperacao,
            "Licença de instalação" => _detalhe?.LicensaInstalacao,
            "Amortização" => _detalhe?.Amortizacao,
            "Retorno parcial" => _detalhe?.RetornoParcial,
            "Placa local" => _detalhe?.PlacaLocal,
            "Excepcionalização" => _detalhe?.Excepcionalizado,
            "CP alterada" => _detalhe?.ContrapartidaAlterada,
            _ => null,
        };
        return titulo is "Licença de operação" or "Licença de instalação" or "Amortização"
            or "Retorno parcial" or "Placa local" or "Excepcionalização" or "CP alterada";
    }

    private record EventoTimeline(string Icone, string Texto, string Quando, string Tipo);

    private List<EventoTimeline> MontarTimeline(List<ItemChecklist> checklist)
    {
        var cultura = new CultureInfo("pt-BR");
        var eventos = new List<EventoTimeline>
        {
            new("bi-inbox", $"Desembolso <strong>{Desembolso.Id}</strong> recebido para análise",
                (_detalhe?.DtSolicitado ?? Desembolso.PrazoFinal).ToString("dd MMM yyyy", cultura), "neutro"),
        };

        if (Analista is not null)
            eventos.Add(new("bi-person-check", $"Atribuído a <strong>{Analista.Nome}</strong>", "", "info"));

        var todosComentarios = checklist
            .SelectMany(v => v.Comentarios.Select(c => (Item: (string?)v.Titulo, Comentario: c)))
            .Concat((_detalhe?.ComentariosGerais ?? []).Select(c => (Item: (string?)null, Comentario: new Comentario
            {
                Tipo = c.TipoMensagem,
                Texto = c.Texto ?? "",
                Autor = c.NomeAutor ?? "",
                UnidadeAutor = c.UnidadeAutor,
                Timestamp = c.DtCriacao,
            })))
            .OrderBy(x => x.Comentario.Timestamp);

        foreach (var (item, c) in todosComentarios)
        {
            var alvo = item is null ? "" : $" em <strong>{item}</strong>";
            eventos.Add(new(
                c.Tipo == "justificativa" ? "bi-check-circle" : c.Tipo == "parecer" ? "bi-x-circle" : "bi-chat-text",
                $"<strong>{c.Autor}</strong> comentou{alvo}: “{c.Texto}”",
                ServicoMock.FormatarTempo(c.Timestamp),
                c.Tipo == "parecer" ? "falha" : c.Tipo == "justificativa" ? "ok" : "info"));
        }

        eventos.Add(Desembolso.Status switch
        {
            "aprovado" => new("bi-patch-check", "Desembolso <strong>aprovado</strong>", "", "ok"),
            "negado" => new("bi-x-octagon",
                string.IsNullOrWhiteSpace(_detalhe?.MotivoRejeicao)
                    ? "Desembolso <strong>rejeitado</strong>"
                    : $"Desembolso <strong>rejeitado</strong>: “{_detalhe.MotivoRejeicao}”",
                "", "falha"),
            "pendencia" => new("bi-hourglass", "<strong>Aguardando</strong> a 1ª análise", "agora", "neutro"),
            _ => new("bi-hourglass-split", "Em análise — <strong>aguardando decisão</strong>", "agora", "neutro"),
        });

        return eventos;
    }

    private async Task ExecutarValidacaoMacro()
    {
        if (_validandoMacro) return;
        _validandoMacro = true;
        StateHasChanged();
        try
        {
            await Service.ValidarAsync(Desembolso.Id);
            await CarregarDetalheAsync();
        }
        catch (Exception ex) { Console.WriteLine($"[DialogFPD] Validar automaticamente: {ex.Message}"); }
        finally
        {
            _validandoMacro = false;
            StateHasChanged();
        }
    }

    private int IndiceAtual  => Todos.FindIndex(d => d.Id == Desembolso.Id);
    private bool TemAnterior => IndiceAtual > 0;
    private bool TemProximo  => IndiceAtual < Todos.Count - 1;

    private async Task Anterior() { if (TemAnterior) await AoNavegar.InvokeAsync(Todos[IndiceAtual - 1].Id); }
    private async Task Proximo()  { if (TemProximo)  await AoNavegar.InvokeAsync(Todos[IndiceAtual + 1].Id); }
    private async Task FecharDialog() => await AoFechar.InvokeAsync();


    private async Task AdicionarComentario(int coValidacao, Comentario c)
    {
        try
        {
            var resposta = await Service.AdicionarComentarioAsync(Desembolso.Id, coValidacao, c.Texto,
                c.Tipo, ServicoUsuario.Matricula, ServicoUsuario.Nome, ServicoUsuario.UnidadeUsuario);
            if (resposta.IsSuccessStatusCode)
                Snackbar.Add("Comentário adicionado com sucesso.", Severity.Success);
            else
            {
                var mensagem = await ControleAnaliseDesembolsoService.ExtrairMensagemDeErroAsync(resposta);
                Console.WriteLine($"[DialogFPD] Adicionar comentário falhou: {mensagem}");
                Snackbar.Add(mensagem, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DialogFPD] Adicionar comentário: {ex.Message}");
            Snackbar.Add("Falha ao adicionar comentário. Tente novamente.", Severity.Error);
        }
        finally { await CarregarDetalheAsync(); }
    }


    private async Task EditarComentario(int coValidacao, Comentario editado)
    {
        try
        {
            var resposta = await Service.EditarComentarioAsync(Desembolso.Id, coValidacao, editado.Id, editado.Texto, ServicoUsuario.Matricula);
            if (resposta.IsSuccessStatusCode)
                Snackbar.Add("Comentário editado com sucesso.", Severity.Success);
            else
                Snackbar.Add(await ControleAnaliseDesembolsoService.ExtrairMensagemDeErroAsync(resposta), Severity.Error);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DialogFPD] Editar comentário: {ex.Message}");
            Snackbar.Add("Falha ao editar comentário. Tente novamente.", Severity.Error);
        }
        finally { await CarregarDetalheAsync(); }
    }

    private async Task RemoverComentario(int coValidacao, Comentario c)
    {
        try
        {
            var resposta = await Service.RemoverComentarioAsync(Desembolso.Id, coValidacao, c.Id, ServicoUsuario.Matricula);
            if (resposta.IsSuccessStatusCode)
                Snackbar.Add("Comentário removido com sucesso.", Severity.Success);
            else
            {
                var mensagem = await ControleAnaliseDesembolsoService.ExtrairMensagemDeErroAsync(resposta);
                Console.WriteLine($"[DialogFPD] Remover comentário falhou: {mensagem}");
                Snackbar.Add(mensagem, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DialogFPD] Remover comentário: {ex.Message}");
            Snackbar.Add("Falha ao remover comentário. Tente novamente.", Severity.Error);
        }
        finally { await CarregarDetalheAsync(); }
    }

    private async Task AprovarDesembolso()
    {
        _processandoAcao = true;
        StateHasChanged();
        try
        {
            var resposta = await Service.AprovarAsync(Desembolso.Id, ServicoUsuario.Matricula, ServicoUsuario.Nome);
            var ok = resposta.IsSuccessStatusCode;
            Snackbar.Add(ok ? "Desembolso aprovado com sucesso." : await ControleAnaliseDesembolsoService.ExtrairMensagemDeErroAsync(resposta),
                ok ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DialogFPD] Erro ao aprovar: {ex.Message}");
            Snackbar.Add("Falha ao aprovar. Tente novamente.", Severity.Error);
        }
        finally { _processandoAcao = false; }
        await AoFechar.InvokeAsync();
    }

    private void CancelarRejeicao()
    {
        _modoRejeicao = false;
        _justificativaRejeicao = "";
    }

    private async Task RejeitarDesembolso()
    {
        if (string.IsNullOrWhiteSpace(_justificativaRejeicao))
        {
            Snackbar.Add("Escreva a justificativa antes de confirmar a rejeição.", Severity.Warning);
            return;
        }
        _processandoAcao = true;
        StateHasChanged();
        try
        {
            var ok = await Service.RejeitarAsync(Desembolso.Id, ServicoUsuario.Matricula, ServicoUsuario.Nome, "CEFGA06", _justificativaRejeicao);
            Snackbar.Add(ok ? "Desembolso rejeitado com sucesso." : "Não foi possível rejeitar o desembolso.",
                ok ? Severity.Success : Severity.Error);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[DialogFPD] Erro ao rejeitar: {ex.Message}");
            Snackbar.Add("Falha ao rejeitar. Tente novamente.", Severity.Error);
        }
        finally
        {
            _processandoAcao = false;
            _modoRejeicao = false;
            _justificativaRejeicao = "";
        }
        await AoFechar.InvokeAsync();
    }

    private async Task AtribuirAnalista(Funcionario f)
    {
        _popoverAberto = false;
        await AoAtribuir.InvokeAsync(f);
    }

    private async Task RemoverAnalista()
    {
        _popoverAberto = false;
        await AoAtribuir.InvokeAsync(null);
    }
}

