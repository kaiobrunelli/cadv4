@using System.Globalization
@using ControleAnaliseDesembolso.Modelos
@using ControleAnaliseDesembolso.Service
@inject ControleAnaliseDesembolsoService Service


<div class="overlay-dfp" @onclick="FecharDialog">
    <div class="dfp" @onclick:stopPropagation role="dialog" aria-modal="true">

        @{
            var checklist = MontarChecklistReal();
        }

        <div class="dfp-topbar">
            <div class="dfp-id">
                <i class="bi bi-file-text"></i>
                <span class="dfp-id-label">Desembolso ID</span>
                <span class="dfp-id-num">@Desembolso.NumId</span>
                @if (!string.IsNullOrEmpty(Desembolso.Gigov))
                {
                    <span class="dfp-id-separador">-</span>
                    <span class="dfp-id-label">GIGOV</span>
                    <span class="dfp-id-num">@Desembolso.Gigov</span>
                }
            </div>
            <div class="dfp-topbar-right">
                <div class="nav-pill-group">
                    <button class="btn-nav" @onclick="Anterior" disabled="@(!TemAnterior)" title="Anterior">
                        <i class="bi bi-chevron-left"></i>
                    </button>
                    <span class="nav-pos">@(IndiceAtual + 1)/@Todos.Count</span>
                    <button class="btn-nav" @onclick="Proximo" disabled="@(!TemProximo)" title="Próximo">
                        <i class="bi bi-chevron-right"></i>
                    </button>
                </div>
                <button class="btn-fechar" @onclick="FecharDialog" title="Fechar (Esc)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>

        <div class="fpd-stepper">
            @StepHeader(1, "bi-file-earmark-text", "Dados do Contrato")
            <div class="fpd-step-linha @(_etapaAtual > 1 ? "concluida" : "")"></div>
            @StepHeader(2, "bi-check2-square", "Validações")
            <div class="fpd-step-linha @(_etapaAtual > 2 ? "concluida" : "")"></div>
            @StepHeader(3, "bi-clock-history", "Histórico")
        </div>

        @if (_etapaAtual == 1)
        {
            @if (_carregandoReal)
            {
                <div class="dfp-painel-placeholder" style="padding:60px;">
                    <i class="bi bi-arrow-repeat spin"></i>
                    <p>Carregando…</p>
                </div>
            }
            else if (_detalheReal is null)
            {
                <div class="dfp-painel-placeholder" style="padding:60px;">
                    <i class="bi bi-exclamation-triangle"></i>
                    <p>Não foi possível carregar este desembolso.</p>
                </div>
            }
            else
            {
                <div class="dfp-header dfp-header-etapa">

                    <div class="dfp-titulo-row">
                        <div class="dfp-titulo-left">
                            <div class="dfp-name-row">
                                <h2 class="dfp-mutuario" title="@Desembolso.Mutuario">@Desembolso.Mutuario</h2>
                                <span class="dfp-dsb-id">@Desembolso.Id</span>
                                @if (!string.IsNullOrEmpty(Desembolso.Gigov))
                                {
                                    <span class="dfp-gigov">@Desembolso.Gigov</span>
                                }
                            </div>
                            <div class="dfp-meta-row">
                                <PilulhaStatus Status="@Desembolso.Status" Tamanho="sm" />
                                <span class="dfp-prazo-chip">
                                    <i class="bi bi-calendar3"></i>
                                    Prazo:&nbsp;<strong>@Desembolso.PrazoFinal.ToString("dd MMM", new CultureInfo("pt-BR"))</strong>
                                </span>
                                @if (_detalheReal.PrimeiroDesembolso)
                                {
                                    <span class="dfp-badge-destaque"><i class="bi bi-flag-fill"></i> Primeiro desembolso</span>
                                }
                                @if (_detalheReal.TipoDesembolso == "ADIANTAMENTO" || !_detalheReal.PrimeiroDesembolso)
                                {
                                    <span class="dfp-badge-tipo @(_detalheReal.TipoDesembolso == "ADIANTAMENTO" ? "adiantamento" : "")">
                                        @(_detalheReal.TipoDesembolso == "ADIANTAMENTO" ? "Adiantamento" : "Normal")
                                    </span>
                                }
                                @if (Analista is not null)
                                {
                                    <div class="analista-mini" style="background: @Analista.Cor">@Analista.Iniciais</div>
                                    <span class="dfp-analista-nome">@Analista.Nome</span>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="dfp-dados-grid">
                        <div class="dfp-coluna">
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Contrato AF</span>
                                <span class="dfp-valor dfp-mono">@Desembolso.Contrato</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Contrato AO</span>
                                <span class="dfp-valor dfp-mono @(string.IsNullOrWhiteSpace(_detalheReal.ContratoAo) ? "dfp-valor-vazio" : "")">@ExibirTexto(CombinarContrato(_detalheReal.ContratoAo, _detalheReal.ContratoAoDv))</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Agente Financeiro</span>
                                <span class="dfp-valor dfp-valor-truncar @(string.IsNullOrWhiteSpace(_detalheReal.AgenteFinanceiro) ? "dfp-valor-vazio" : "")" title="@ExibirTexto(_detalheReal.AgenteFinanceiro)">@ExibirTexto(_detalheReal.AgenteFinanceiro)</span>
                            </div>
                            <div class="dfp-linha dfp-linha-last">
                                <span class="dfp-rotulo">Agente Promotor</span>
                                <span class="dfp-valor dfp-valor-truncar @(string.IsNullOrWhiteSpace(_detalheReal.AgentePromotor) ? "dfp-valor-vazio" : "")" title="@ExibirTexto(_detalheReal.AgentePromotor)">@ExibirTexto(_detalheReal.AgentePromotor)</span>
                            </div>
                        </div>

                        <div class="dfp-divisor-v"></div>

                        <div class="dfp-coluna">
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Agente Técnico</span>
                                <span class="dfp-valor dfp-valor-truncar @(string.IsNullOrWhiteSpace(_detalheReal.AgenteTecnicoOperador) ? "dfp-valor-vazio" : "")" title="@ExibirTexto(_detalheReal.AgenteTecnicoOperador)">@ExibirTexto(_detalheReal.AgenteTecnicoOperador)</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Tomador / Mutuário</span>
                                <span class="dfp-valor dfp-valor-truncar @(string.IsNullOrWhiteSpace(_detalheReal.MutuarioFinal) ? "dfp-valor-vazio" : "")" title="@ExibirTexto(_detalheReal.MutuarioFinal)">@ExibirTexto(_detalheReal.MutuarioFinal)</span>
                            </div>
                            <div class="dfp-linha">
                                <span class="dfp-rotulo">Nº Desembolso</span>
                                <span class="dfp-valor">@_detalheReal.NuDesembolso</span>
                            </div>
                            <div class="dfp-linha dfp-linha-last">
                                <span class="dfp-rotulo">Programa</span>
                                <span class="dfp-valor">@_detalheReal.Programa</span>
                            </div>
                        </div>
                    </div>

                    <div class="dfp-valores">
                        <div class="dfp-secao-titulo">Valores</div>
                        <div class="dfp-valores-split">
                            <div class="dfp-valores-col">
                                <div class="dfp-valores-col-titulo">Desembolso</div>
                                <div class="dfp-linha dfp-linha-destaque">
                                    <span class="dfp-rotulo">Valor solicitado (parcela)</span>
                                    <span class="dfp-valor dfp-mono dfp-valor-destaque">@ServicoMock.FormatarBRL(_detalheReal.SolicitadoVi)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">VE (Valor Empréstimo)</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalheReal.ValorEmprestimo)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Participação FGTS</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalheReal.ParticipacaoFgts)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Desembolsado</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalheReal.Desembolsado)</span>
                                </div>
                                <div class="dfp-linha dfp-linha-last">
                                    <span class="dfp-rotulo" title="Calculado: VE - Desembolsado">Saldo a desembolsar</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalheReal.ValorEmprestimo - _detalheReal.Desembolsado)</span>
                                </div>
                            </div>
                            <div class="dfp-valores-divisor"></div>
                            <div class="dfp-valores-col">
                                <div class="dfp-valores-col-titulo">Contrapartida</div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Contrapartida</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalheReal.Contrapartida)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Contrapartida Atual</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalheReal.ContrapartidaAtual)</span>
                                </div>
                                <div class="dfp-linha">
                                    <span class="dfp-rotulo">Integralizado</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalheReal.Integralizado)</span>
                                </div>
                                <div class="dfp-linha dfp-linha-last">
                                    <span class="dfp-rotulo">Saldo a integralizar</span>
                                    <span class="dfp-valor dfp-mono">@ServicoMock.FormatarBRL(_detalheReal.SaldoIntegralizar)</span>
                                </div>
                            </div>
                        </div>
                        <div class="dfp-resumo-perc">
                            <div class="dfp-resumo-perc-titulo">Resumo de percentuais</div>
                            <div class="dfp-resumo-perc-grid">
                                <div class="dfp-resumo-perc-item">
                                    <span class="dfp-resumo-perc-rotulo">Obra concluída (BM)</span>
                                    <strong><i class="bi bi-graph-up dfp-resumo-perc-icone"></i>@_detalheReal.PercentualObra.ToString("0.000", new CultureInfo("pt-BR"))%</strong>
                                </div>
                                <div class="dfp-resumo-perc-item">
                                    <span class="dfp-resumo-perc-rotulo" title="(Desembolsado + Solicitado VI) / VE">Execução financeira</span>
                                    <strong class="@ClassePercComparado(PercExecucaoFinanceira, _detalheReal.PercentualObra)"><i class="bi bi-graph-up dfp-resumo-perc-icone"></i>@FmtPerc(PercExecucaoFinanceira)</strong>
                                </div>
                                <div class="dfp-resumo-perc-item">
                                    <span class="dfp-resumo-perc-rotulo" title="Integralizado / CP Atual">Contrapartida integralizada</span>
                                    <strong><i class="bi bi-graph-up dfp-resumo-perc-icone"></i>@FmtPerc(PercContrapartidaIntegralizada)</strong>
                                </div>
                            </div>
                            </div>
                    </div>
                </div>
            }
        }
        else if (_etapaAtual == 2)
        {
            <div class="dfp-etapa-validacoes">
                @if (_carregandoReal)
                {
                    <p class="dfp-acc-detalhe"><i class="bi bi-arrow-repeat spin"></i> Carregando histórico de validações…</p>
                }
                else
                {
                    <div class="dfp-etapa-validacoes-topo">
                        <span class="dfp-etapa-validacoes-contagem ok">
                            <i class="bi bi-check-circle-fill"></i> @checklist.Count(v => v.Status == "valido") validações aprovadas
                        </span>
                        @if (TotalComComentario > 0)
                        {
                            <div class="dfp-resumo-aviso">
                                <i class="bi bi-chat-text-fill"></i>
                                <span><strong>@TotalComComentario</strong> com histórico de respostas</span>
                            </div>
                        }
                    </div>

                    @if (!checklist.Any())
                    {
                        <p class="dfp-acc-detalhe">Nenhuma validação carregada pra este desembolso.</p>
                    }

                    @foreach (var v in checklist)
                    {
                        var chave = $"v{v.CoValidacao}";
                        var aberta = _validacoesAbertas.Contains(chave);

                        <div class="dfp-acc @(aberta ? "aberta" : "")">
                            <button class="dfp-acc-header" @onclick="() => AlternarValidacao(chave)">
                                <span class="dfp-acc-titulo">@v.Titulo</span>
                                @{ var temResposta = TemRespostaFicha(v.Titulo, out var resposta); }
                                @if (temResposta)
                                {
                                    <span class="dfp-ficha-pill @(resposta switch { true => "sim", false => "nao", _ => "pendente" })">
                                        @(resposta switch { true => "Sim", false => "Não", _ => "Não respondido" })
                                    </span>
                                }
                                <span class="dfp-acc-spacer"></span>
                                @if (v.Comentarios.Any())
                                {
                                    <i class="bi bi-chat-text-fill dfp-acc-comm">@v.Comentarios.Count</i>
                                }
                                <PilulhaStatus Status="@v.Status" Tamanho="sm" />
                                <i class="bi bi-chevron-down dfp-acc-chevron"></i>
                            </button>
                            <div class="dfp-acc-body">
                                <div class="dfp-acc-inner">
                                    <div class="dfp-acc-corpo">
                                        <FioComentario Comentarios="@v.Comentarios" ApenasLeitura="true" />
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        }
        else
        {
            <div class="dfp-corpo">
                <div class="dfp-timeline">
                    @foreach (var evento in MontarTimeline())
                    {
                        <div class="dfp-evento @evento.Tipo">
                            <div class="dfp-evento-ponto"><i class="bi @evento.Icone"></i></div>
                            <div class="dfp-evento-corpo">
                                <div class="dfp-evento-texto">@((MarkupString)evento.Texto)</div>
                                <div class="dfp-evento-quando">@evento.Quando</div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="dfp-rodape">
            <div class="dfp-rodape-status">
                <i class="bi bi-clipboard-check ok"></i>
                <span>Checagem final — somente visualização</span>
            </div>

            @if (_etapaAtual > 1)
            {
                <button class="btn-fpd-etapa-voltar" @onclick="EtapaAnterior">
                    <i class="bi bi-chevron-left"></i> <span>Etapa anterior</span>
                </button>
            }
            @if (_etapaAtual < 3)
            {
                <button class="btn-fpd-etapa-proxima" @onclick="ProximaEtapa">
                    <span>Próxima etapa</span> <i class="bi bi-chevron-right"></i>
                </button>
            }
            <button class="btn-recusar-cancelar" @onclick="FecharDialog">Fechar</button>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DesembolsoCAD       Desembolso { get; set; } = null!;
    [Parameter, EditorRequired] public List<DesembolsoCAD> Todos      { get; set; } = [];
    [Parameter] public Funcionario?  Analista  { get; set; }
    [Parameter] public EventCallback AoFechar  { get; set; }
    [Parameter] public EventCallback<string> AoNavegar { get; set; }

    private int _etapaAtual = 1;
    private readonly HashSet<string> _validacoesAbertas = [];

    private DesembolsoDetalheDto? _detalheReal;
    private string? _idCarregado;
    private bool _carregandoReal = true;

    protected override async Task OnParametersSetAsync()
    {
        if (_idCarregado == Desembolso.Id) return;
        _carregandoReal = true;
        try
        {
            _detalheReal = await Service.ObterDetalheDesembolsoAsync(Desembolso.Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ResumoDrp] Falha ao carregar validações reais: {ex.Message}");
            _detalheReal = null;
        }
        finally
        {
            _idCarregado = Desembolso.Id;
            _carregandoReal = false;
        }
    }

    private decimal? PercExecucaoFinanceira =>
        _detalheReal is { ValorEmprestimo: > 0 }
            ? Math.Round((_detalheReal.Desembolsado + _detalheReal.SolicitadoVi) / _detalheReal.ValorEmprestimo * 100, 3)
            : null;

    private decimal? PercContrapartidaIntegralizada =>
        _detalheReal is { ContrapartidaAtual: > 0 }
            ? Math.Round(_detalheReal.Integralizado / _detalheReal.ContrapartidaAtual * 100, 3)
            : null;

    private static string FmtPerc(decimal? p) => p is null ? "—" : $"{p.Value.ToString("0.000", new CultureInfo("pt-BR"))}%";
    private static string ClassePercComparado(decimal? valor, decimal? referencia) =>
        valor is null || referencia is null ? "" : valor <= referencia ? "dfp-perc-ok" : "dfp-perc-alerta";
    private static string ExibirTexto(string? valor) => string.IsNullOrWhiteSpace(valor) ? "Não informado" : valor;
    private static string CombinarContrato(string? contrato, string? dv) =>
        string.IsNullOrWhiteSpace(contrato) ? "" : string.IsNullOrWhiteSpace(dv) ? contrato : $"{contrato}-{dv}";

    private int IndiceAtual  => Todos.FindIndex(d => d.Id == Desembolso.Id);
    private bool TemAnterior => IndiceAtual > 0;
    private bool TemProximo  => IndiceAtual < Todos.Count - 1;

    private async Task Anterior() { if (TemAnterior) await AoNavegar.InvokeAsync(Todos[IndiceAtual - 1].Id); }
    private async Task Proximo()  { if (TemProximo)  await AoNavegar.InvokeAsync(Todos[IndiceAtual + 1].Id); }
    private async Task FecharDialog() => await AoFechar.InvokeAsync();

    private RenderFragment StepHeader(int numero, string icone, string titulo) =>
        @<button type="button" class="fpd-step @(EstadoEtapa(numero))" @onclick="() => _etapaAtual = numero">
            <span class="fpd-step-num">
                @if (numero < _etapaAtual) { <i class="bi bi-check-lg"></i> } else { @numero }
            </span>
            <span class="fpd-step-titulo">@titulo</span>
        </button>;

    private string EstadoEtapa(int numero) =>
        numero == _etapaAtual ? "atual" : numero < _etapaAtual ? "concluida" : "";

    private void ProximaEtapa()  { if (_etapaAtual < 3) _etapaAtual++; }
    private void EtapaAnterior() { if (_etapaAtual > 1) _etapaAtual--; }

    private int TotalComComentario => MontarChecklistReal().Count(v => v.Comentarios.Any());

    private void AlternarValidacao(string chave)
    {
        if (!_validacoesAbertas.Add(chave))
            _validacoesAbertas.Remove(chave);
    }

    private sealed class ItemChecklistReal
    {
        public int CoValidacao { get; set; }
        public string Titulo { get; set; } = "";
        public string Status { get; set; } = "";
        public List<Comentario> Comentarios { get; set; } = [];
    }

    private static string MapSituacao(int situacao) => situacao switch
    {
        1 => "valido",
        2 => "invalido",
        _ => "pendente",
    };

    private bool TemRespostaFicha(string? titulo, out bool? resposta)
    {
        resposta = titulo switch
        {
            "Licença de operação" => _detalheReal?.LicensaOperacao,
            "Licença de instalação" => _detalheReal?.LicensaInstalacao,
            "Amortização" => _detalheReal?.Amortizacao,
            "Retorno parcial" => _detalheReal?.RetornoParcial,
            "Placa local" => _detalheReal?.PlacaLocal,
            "Excepcionalização" => _detalheReal?.Excepcionalizado,
            "CP alterada" => _detalheReal?.ContrapartidaAlterada,
            _ => null,
        };
        return titulo is "Licença de operação" or "Licença de instalação" or "Amortização"
            or "Retorno parcial" or "Placa local" or "Excepcionalização" or "CP alterada";
    }

    private List<ItemChecklistReal> MontarChecklistReal()
    {
        if (_detalheReal is null) return [];
        return _detalheReal.Checklist
            .OrderBy(v => v.CoValidacao)
            .Select(v => new ItemChecklistReal
            {
                CoValidacao = v.CoValidacao,
                Titulo = v.DeValidacao ?? "",
                Status = MapSituacao(v.Situacao),
                Comentarios = v.Comentarios
                    .OrderBy(c => c.DtCriacao)
                    .Select(c => new Comentario
                    {
                        Id = c.CoMensagem,
                        Tipo = c.TipoMensagem,
                        Texto = c.Texto ?? "",
                        Autor = c.NomeAutor ?? c.MatriculaAutor ?? "",
                        MatriculaAutor = c.MatriculaAutor ?? "",
                        UnidadeAutor = c.UnidadeAutor,
                        Timestamp = c.DtCriacao,
                    }).ToList(),
            }).ToList();
    }

    private record EventoTimeline(string Icone, string Texto, string Quando, string Tipo);

    private List<EventoTimeline> MontarTimeline()
    {
        var cultura = new CultureInfo("pt-BR");
        var criacao = Desembolso.PrazoFinal.AddDays(-21);
        var eventos = new List<EventoTimeline>
        {
            new("bi-inbox", $"Desembolso <strong>{Desembolso.Id}</strong> recebido para análise",
                criacao.ToString("dd MMM yyyy", cultura), "neutro"),
        };

        if (Analista is not null)
            eventos.Add(new("bi-person-check", $"Atribuído a <strong>{Analista.Nome}</strong>",
                criacao.AddDays(1).ToString("dd MMM yyyy", cultura), "info"));

        foreach (var v in MontarChecklistReal())
            foreach (var c in v.Comentarios)
                eventos.Add(new(
                    c.Tipo == "justificativa" ? "bi-check-circle" : c.Tipo == "parecer" ? "bi-x-circle" : "bi-chat-text",
                    $"<strong>{c.Autor}</strong> comentou em <strong>{v.Titulo}</strong>: “{c.Texto}”",
                    ServicoMock.FormatarTempo(c.Timestamp),
                    c.Tipo == "parecer" ? "falha" : c.Tipo == "justificativa" ? "ok" : "info"));

        eventos.Add(Desembolso.Status switch
        {
            "aprovado" => new("bi-patch-check", "Desembolso <strong>aprovado</strong>",
                DateTime.Today.ToString("dd MMM yyyy", cultura), "ok"),
            "pendencia" => new("bi-exclamation-triangle", "Pendências identificadas — <strong>aguardando tratativa</strong>",
                "agora", "falha"),
            _ => new("bi-hourglass-split", "Em análise — <strong>aguardando decisão</strong>", "agora", "neutro")
        });

        return eventos;
    }
}

<style>
.overlay-dfp {
    position: fixed; inset: 0;
    background: rgba(34,41,46,.45);
    z-index: 2000;
    display: flex; align-items: flex-start; justify-content: center;
    padding: 16px; overflow-y: auto;
    animation: fadeIn .18s ease;
}

.dfp {
    position: relative;
    width: 100%; max-width: 960px;
    background: #fff;
    border-radius: var(--radius-xl, 10px);
    box-shadow: var(--shadow-pop);
    display: flex; flex-direction: column;
    animation: popIn .22s ease;
    max-height: calc(100vh - 32px);
    overflow: hidden;
    margin: auto;
}

