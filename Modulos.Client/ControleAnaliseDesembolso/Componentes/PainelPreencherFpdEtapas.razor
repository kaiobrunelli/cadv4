    private void DefinirItem(string chave, string? valor, Action<string?> set)
    {
        set(valor);
        StateHasChanged();
    }

    private async Task AlternarItem(string chave)
    {
        if (_itensAbertos.Remove(chave)) return;

        _itensAbertos.Add(chave);

        StateHasChanged();
        await Task.Delay(120);
        await JS.InvokeVoidAsync("scrollSubItemIntoView", $"fpd-item-{chave}");
    }

    private async Task BuscarContrato()
    {
        if (_buscando || string.IsNullOrWhiteSpace(_fpd.ContratoAf)) return;
        _buscando = true; _msgBusca = null; StateHasChanged();
        try
        {
            var (coContrato, coContratoDV) = SepararContratoDv(_fpd.ContratoAf);

            var response = await ControleAnaliseDesembolsoService.BuscarContratoAFAsync(coContrato, coContratoDV);

            if (response.IsSuccessStatusCode)
            {
                var contratoAF = await response.Content.ReadFromJsonAsync<ContratoAFResponse>();
                if (contratoAF is not null) PreencherDeContrato(contratoAF);
                _buscaOk = true;
                _msgBusca = "Contrato encontrado — campos preenchidos.";
            }
            else { _buscaOk = false; _msgBusca = "Contrato não encontrado — preencha manualmente."; }
        }
        catch (Exception ex) { _buscaOk = false; _msgBusca = "Falha na consulta."; Console.WriteLine($"[FPD] {ex.Message}"); }
        finally { _buscando = false; StateHasChanged(); }
    }

