@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using ControleAnaliseDesembolso.Modelos
@using Microsoft.AspNetCore.Components.Forms

@inject ServicoUsuarioUI ServicoUsuario
@inject ControleAnaliseDesembolsoService ControleAnaliseDesembolsoService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<div class="overlay-fpd" @onclick="AoVoltar"></div>

<div class="dialog-fpd" @onclick:stopPropagation>

    <div class="dialog-fpd-header">
        <div class="dialog-fpd-icone"><i class="bi @(ModoEdicao ? "bi-pencil-square" : "bi-clipboard-plus")"></i></div>
        @if (ModoEdicao)
        {
            <div>
                <div class="dialog-fpd-titulo">Editar FPD - @_fpd.AgenteFinanceiro</div>
                <div class="dialog-fpd-subtitulo">Número do Contrato AF: @_fpd.ContratoAf</div>
            </div>
        }
        else
        {
            <div>
                <div class="dialog-fpd-titulo">Preencher FPD-AF</div>
                <div class="dialog-fpd-subtitulo">Ficha de Previsão de Desembolso · em etapas</div>
            </div>
        }
        <button class="dialog-fpd-fechar" @onclick="AoVoltar" title="Fechar"><i class="bi bi-x-lg"></i></button>
    </div>

    <div class="fpd-stepper">
        @StepHeader(1, "bi-file-earmark-text", "Dados do contrato")
        <div class="fpd-step-linha @(_etapaAtual > 1 ? "concluida" : "")"></div>
        @StepHeader(2, "bi-check2-square", "Verificações")
        <div class="fpd-step-linha @(_etapaAtual > 2 ? "concluida" : "")"></div>
        @StepHeader(3, "bi-cash-stack", "Valores")
    </div>

    <div class="dialog-fpd-corpo" @ref="_corpoRef">

        @if (_etapaAtual == 1)
        {
            <div class="fpd-grupo-campos">
                <div class="fpd-ident">
                    <div class="fpd-campo fpd-campo-af">
                        <label class="fpd-label">Contrato AF <span class="fpd-obrigatorio">*</span></label>
                        <div class="fpd-af-linha">
                            <input class="fpd-input @(_erroContratoAf is not null ? "fpd-input-erro" : "")" placeholder="Ex.: 0558698-45"
                                   value="@_fpd.ContratoAf" @oninput="FormatarContratoAfEnquantoDigita" @onblur="ValidarContratoAf" />
                            <button class="fpd-btn-buscar" @onclick="BuscarContrato" disabled="@(_buscando || _fpd.PrimeiroDesembolso)">
                                @if (_buscando) { <i class="bi bi-arrow-repeat spin"></i> } else { <i class="bi bi-search"></i> }
                                <span>Buscar</span>
                            </button>
                        </div>
                        @if (_erroContratoAf is not null) { <span class="fpd-erro-campo">@_erroContratoAf</span> }
                        else if (!string.IsNullOrEmpty(_msgBusca)) { <span class="fpd-msg-busca @(_buscaOk ? "ok" : "falha")">@_msgBusca</span> }
                    </div>
                    <div class="fpd-campo"><label class="fpd-label">GIGOV</label>
                        <input class="fpd-input @(_erroGigov is not null ? "fpd-input-erro" : "")" @bind="_fpd.Gigov" @bind:event="oninput" @onblur="ValidarGigov" />
                        @if (_erroGigov is not null) { <span class="fpd-erro-campo">@_erroGigov</span> }
                    </div>
                    <div class="fpd-campo"><label class="fpd-label">Solicitante</label>
                        <input class="fpd-input" value="@_fpd.Solicitante" readonly /></div>
                    <div class="fpd-campo"><label class="fpd-label">Gestor</label>
                        <div class="campo-c-wrap @(_erroGestor is not null ? "fpd-input-erro" : "")">
                            <span class="campo-c-prefixo">C</span>
                            <input class="campo-c-input" inputmode="numeric" placeholder="000000"
                                   @bind="_fpd.Gestor" @bind:event="oninput" @onblur="ValidarGestor" />
                        </div>
                        @if (_erroGestor is not null) { <span class="fpd-erro-campo">@_erroGestor</span> }
                    </div>
                    @if (ModoEdicao)
                    {
                        <div class="fpd-campo" title="Preenchido pela CEFGA ao clicar em Validar">
                            <label class="fpd-label">Contrato AO</label>
                            <input class="fpd-input @(string.IsNullOrWhiteSpace(_fpd.ContratoAo) ? "fpd-input-vazio" : "")" value="@_fpd.ContratoAoExibicao" readonly />
                        </div>
                    }
                </div>

                <div class="fpd-excl-opcoes">
                    <label class="fpd-check">
                        <input type="checkbox" checked="@(_fpd.OpcaoExclusiva == "primeiro")" @onchange='() => DefinirOpcaoExclusiva("primeiro")' />
                        <span>Primeiro desembolso</span>
                    </label>
                    <label class="fpd-check">
                        <input type="checkbox" checked="@(_fpd.OpcaoExclusiva == "ultimo")" @onchange='() => DefinirOpcaoExclusiva("ultimo")' />
                        <span>Último desembolso</span>
                    </label>
                    <label class="fpd-check">
                        <input type="checkbox" checked="@(_fpd.OpcaoExclusiva == "adiantamento")" @onchange='() => DefinirOpcaoExclusiva("adiantamento")' />
                        <span>Adiantamento</span>
                    </label>
                    <label class="fpd-check">
                        <input type="checkbox" checked="@(_fpd.OpcaoExclusiva == "recorrente")" @onchange='() => DefinirOpcaoExclusiva("recorrente")' />
                        <span>Recorrente</span>
                    </label>
                </div>

                @if (_fpd.UltimoDesembolsoSelecionado)
                {
                    <div class="fpd-subtoggles">
                        <div class="fpd-sn-item"><label class="fpd-label">Funcionalidade</label>
                            <ToggleSimNao @bind-Value="_fpd.Funcionalidade" /></div>
                        <div class="fpd-sn-item"><label class="fpd-label">Conclusão</label>
                            <ToggleSimNao @bind-Value="_fpd.Conclusao" /></div>
                    </div>
                }

                @if (_fpd.PrimeiroDesembolso)
                {
                    <div class="fpd-subtoggles">
                        <div class="fpd-sn-item"><label class="fpd-label">Destinação da coleta de resíduos sólidos</label>
                            <ToggleSimNao @bind-Value="_fpd.DestinacaoColetaResiduosSolidos" /></div>
                    </div>
                }

                <div class="fpd-agentes">
                    @CampoAgente("Agente Financeiro", _fpd.AgenteFinanceiro, v => _fpd.AgenteFinanceiro = v, _fpd.CnpjAgenteFinanceiro, v => _fpd.CnpjAgenteFinanceiro = v, _erroAgenteFinanceiro, ValidarAgenteFinanceiro)
                    @CampoAgente("Tomador / Mutuário", _fpd.Tomador, v => _fpd.Tomador = v, _fpd.CnpjTomador, v => _fpd.CnpjTomador = v)
                    @CampoAgente("Agente Promotor", _fpd.AgentePromotor, v => _fpd.AgentePromotor = v, _fpd.CnpjAgentePromotor, v => _fpd.CnpjAgentePromotor = v)
                </div>

                <div class="fpd-grid4">
                    <div class="fpd-campo"><label class="fpd-label">DT Emissão Eng.</label>
                        <input class="fpd-input" type="date" @bind="_fpd.DataEmissaoEng" /></div>
                    <div class="fpd-campo"><label class="fpd-label">Situação de obra</label>
                        <select class="fpd-input" @bind="SituacaoObraSelecionada">
                            @foreach (var opcao in _situacoesObra)
                            {
                                <option value="@opcao.EnumNome">@opcao.Rotulo</option>
                            }
                        </select>
                    </div>
                    <div class="fpd-campo">
                        <label class="fpd-label">DT Sócio-ambiental</label>
                        <div class="fpd-data-nsa">
                            <input class="fpd-input" type="date" @bind="_fpd.DataEmissaoSocioAmb" disabled="@_fpd.Nsa" />
                            <label class="fpd-check fpd-check-inline">
                                <input type="checkbox" @bind="_fpd.Nsa" /> <span>NSA</span>
                            </label>
                        </div>
                    </div>
                    <div class="fpd-campo"><label class="fpd-label">% de obra</label>
                        <input class="fpd-input" inputmode="numeric" placeholder="0"
                               value="@_percObraTexto" @oninput="FormatarPercObraEnquantoDigita" /></div>
                </div>

                <div class="fpd-subtoggles">
                    <div class="fpd-campo"><label class="fpd-label">Data de início da obra</label>
                        <input class="fpd-input" type="date" @bind="_fpd.DataInicioObra" /></div>
                    <div class="fpd-campo fpd-campo-programa"><label class="fpd-label">Programa</label>
                        <select class="fpd-input" @bind="ProgramaSelecionado">
                            <option value="">Selecione…</option>
                            @foreach (var opcao in _programas)
                            {
                                <option value="@opcao.Rotulo">@opcao.Rotulo</option>
                            }
                        </select>
                    </div>
                    @if (EhProTransporte)
                    {
                        <div class="fpd-sn-item"><label class="fpd-label">Tem carroceria</label>
                            <ToggleSimNao @bind-Value="_fpd.TemCarroceria" /></div>
                        <div class="fpd-sn-item"><label class="fpd-label">Veículo possui adesivos</label>
                            <ToggleSimNao @bind-Value="_fpd.VeiculoPossuiAdesivos" /></div>
                    }
                </div>

                <div class="fpd-campo fpd-campo-cheio" style="margin-top:10px">
                    <label class="fpd-label">OBS AF</label>
                    <textarea class="fpd-input fpd-textarea" @bind="_fpd.Mensagem" @bind:event="oninput"></textarea>
                </div>

                <div class="fpd-campo fpd-campo-cheio" style="margin-top:10px">
                    <label class="fpd-label">Anexos</label>
                    <input type="file" @ref="_inputArquivoRef" style="display:none" multiple />
                    <button type="button" class="fpd-btn-anexar" @onclick="AbrirSeletorDeArquivo">
                        <i class="bi bi-paperclip"></i> <span>Anexar arquivo</span>
                    </button>
                </div>
            </div>
        }
        else if (_etapaAtual == 2)
        {
            <div class="fpd-grupo-head fpd-grupo-head-topo"><i class="bi bi-check2-square"></i><span>Verificações</span>
                <span class="fpd-grupo-hint">clique no item para comentar</span></div>
            <div class="fpd-arvore">
                @ItemToggle("2.1", "licoperacao", "Licença de operação", () => _fpd.LicencaOperacao, v => _fpd.LicencaOperacao = v, true, AnexosLicencaOperacao)
                @ItemToggle("2.2", "licinstalacao", "Licença de instalação", () => _fpd.LicencaInstalacao, v => _fpd.LicencaInstalacao = v, true, null)
                @ItemToggle("2.3", "retorno", "Retorno parcial", () => _fpd.RetornoParcial, v => _fpd.RetornoParcial = v, false, null)
                @ItemToggle("2.4", "placa", "Placa local", () => _fpd.PlacaLocal, v => _fpd.PlacaLocal = v, false, null)
                @ItemToggle("2.5", "excep", "Excepcionalização", () => _fpd.Excepcionalizacao, v => _fpd.Excepcionalizacao = v, false, null)
                @ItemToggle("2.6", "cndinss", "CND INSS Válida", () => _fpd.CndValido, v => _fpd.CndValido = v, false, null)
                @ItemToggle("2.7", "crp", "CRP Válida", () => _fpd.CrpValido, v => _fpd.CrpValido = v, true, null)
                @ItemToggle("2.8", "cpalterada", "CP alterada", () => _fpd.CpAlterada, v => _fpd.CpAlterada = v, false, null)
            </div>
        }
        else
        {
            <div class="fpd-grupo-campos">
                <div class="fpd-valores-topo">
                    <div class="fpd-campo"><label class="fpd-label" title="Valor total da parcela solicitada (FGTS + contrapartida desta parcela)">Solicitado VI</label><CampoMoeda @bind-Value="_fpd.SolicitadoVi" /></div>
                    <div class="fpd-campo"><label class="fpd-label" title="Valor da parcela glosado (não aceito)">Glosado VI</label><CampoMoeda @bind-Value="_fpd.GlosadoVi" /></div>
                    <div class="fpd-campo"><label class="fpd-label" title="Valor da parcela efetivamente aceito">Aceito VI</label><CampoMoeda @bind-Value="_fpd.AceitoVi" /></div>
                </div>
                <div class="fpd-valores-split">
                    <div class="fpd-valores-col">
                        <div class="fpd-grid2">
                            <div class="fpd-campo"><label class="fpd-label" title="Quanto do desembolso vem do FGTS">Participação FGTS</label><CampoMoeda @bind-Value="_fpd.ParticipacaoFgts" /></div>
                            <div class="fpd-campo"><label class="fpd-label" title="Valor total do empréstimo contratado, sem somar a contrapartida">VE (Valor Empréstimo)</label><CampoMoeda @bind-Value="_fpd.Ve" /></div>
                            <div class="fpd-campo"><label class="fpd-label" title="Total já desembolsado até agora (sigla Rede Caixa: VD) — vem do contrato ao buscar; no 1º desembolso é sempre 0, pois ainda não existe valor desembolsado">Desembolsado</label><CampoMoeda @bind-Value="_fpd.Desembolsado" ReadOnly="@_fpd.PrimeiroDesembolso" /></div>
                            <div class="fpd-campo"><label class="fpd-label" title="Calculado automaticamente: VE - Desembolsado">Saldo a desembolsar</label><CampoMoeda Value="_fpd.SaldoDesembolsar" ReadOnly="true" /></div>
                        </div>
                    </div>
                    <div class="fpd-valores-divisor"></div>
                    <div class="fpd-valores-col">
                        <div class="fpd-grid2">
                            <div class="fpd-campo"><label class="fpd-label" title="Valor da contrapartida desta parcela (recurso próprio do agente)">Contrapartida</label><CampoMoeda @bind-Value="_fpd.Contrapartida" /></div>
                            <div class="fpd-campo"><label class="fpd-label" title="Contrapartida total a ser integralizada até o fim do contrato">CP Atual</label><CampoMoeda @bind-Value="_fpd.CpAtual" /></div>
                            <div class="fpd-campo"><label class="fpd-label" title="Quanto da contrapartida já foi integralizado até agora — só leitura, vem do contrato ao buscar (ou fica vazio no 1º desembolso)">Integralizado</label><CampoMoeda Value="_fpd.Integralizado" ReadOnly="true" /></div>
                            <div class="fpd-campo"><label class="fpd-label" title="Calculado automaticamente: CP Atual - (Contrapartida + Integralizado)">Saldo a integralizar</label><CampoMoeda Value="_fpd.SaldoIntegralizar" ReadOnly="true" /></div>
                        </div>
                    </div>
                </div>

                <div class="fpd-resumo-perc">
                    <div class="fpd-resumo-perc-titulo">Resumo de percentuais</div>
                    <div class="fpd-resumo-perc-grid">
                        <div class="fpd-resumo-perc-item">
                            <span class="fpd-resumo-perc-rotulo" title="Valor digitado em &quot;% de obra&quot;, na Etapa 1">Obra concluída</span>
                            <strong><i class="bi bi-graph-up fpd-resumo-perc-icone"></i>@FmtPerc(_fpd.PercObra)</strong>
                        </div>
                        <div class="fpd-resumo-perc-item">
                            <span class="fpd-resumo-perc-rotulo" title="(Desembolsado + Participação FGTS) / VE">Execução financeira</span>
                            <strong class="@ClassePercComparado(_fpd.PercExecucaoFinanceira, _fpd.PercObra)"><i class="bi bi-graph-up fpd-resumo-perc-icone"></i>@FmtPerc(_fpd.PercExecucaoFinanceira)</strong>
                        </div>
                        <div class="fpd-resumo-perc-item">
                            <span class="fpd-resumo-perc-rotulo" title="(Contrapartida + Integralizado) / CP Atual">Contrapartida integralizada</span>
                            <strong><i class="bi bi-graph-up fpd-resumo-perc-icone"></i>@FmtPerc(_fpd.PercContrapartidaIntegralizada)</strong>
                        </div>
                    </div>
                    @if (_fpd.PercObra is not null && _fpd.PercExecucaoFinanceira > _fpd.PercObra)
                    {
                        <div class="fpd-resumo-perc-alerta"><i class="bi bi-exclamation-triangle"></i> Execução financeira acima do percentual de obra executada.</div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="dialog-fpd-rodape">
        @if (!string.IsNullOrEmpty(_msgErroEnvio))
        {
            <div class="fpd-erro-envio"><i class="bi bi-exclamation-triangle-fill"></i> @_msgErroEnvio</div>
        }
        <div class="dialog-fpd-acoes">
            <button class="btn-fpd-cancelar" @onclick="AoVoltar" disabled="@_enviando">Cancelar</button>

            <div class="fpd-rodape-espaco"></div>

            @if (_etapaAtual > 1)
            {
                <button class="btn-fpd-etapa-voltar" @onclick="EtapaAnterior" disabled="@_enviando">
                    <i class="bi bi-chevron-left"></i> <span>Etapa anterior</span>
                </button>
            }

            @if (_etapaAtual < 3)
            {
                <button class="btn-fpd-etapa-proxima" @onclick="ProximaEtapa">
                    <span>Próxima etapa</span> <i class="bi bi-chevron-right"></i>
                </button>
            }
            else
            {
                <button class="btn-fpd-solicitar" @onclick="Enviar" disabled="@_enviando">
                    @if (_enviando) { <i class="bi bi-arrow-repeat spin"></i> <span>Enviando…</span> }
                    else if (ModoEdicao) { <i class="bi bi-send-check"></i> <span>Enviar Edição</span> }
                    else { <i class="bi bi-send-check"></i> <span>Solicitar Desembolso</span> }
                </button>
            }
        </div>
    </div>
</div>

@code {

    [Parameter, EditorRequired] public EventCallback AoVoltar { get; set; }
    [Parameter, EditorRequired] public EventCallback<PreenchimentoFpd> AoSolicitar { get; set; }

    [Parameter] public bool ModoEdicao { get; set; }
    [Parameter] public int? CoFpd { get; set; }
    [Parameter] public DesembolsoDetalheDto? DadosParaEdicao { get; set; }

    private readonly PreenchimentoFpd _fpd = new();
    private ElementReference _corpoRef;
    private ElementReference _inputArquivoRef;

    private async Task AbrirSeletorDeArquivo() =>
        await JS.InvokeVoidAsync("clicarElemento", _inputArquivoRef);
    private readonly HashSet<string> _itensAbertos = [];

    private const long TamanhoMaximoAnexoBytes = 20 * 1024 * 1024;
    private readonly List<(string Nome, long Tamanho)> _anexosLicencaOperacao = [];
    private string? _erroAnexoLicencaOperacao;

    private async Task AoSelecionarAnexosLicencaOperacao(InputFileChangeEventArgs e)
    {
        _erroAnexoLicencaOperacao = null;
        foreach (var arquivo in e.GetMultipleFiles(50))
        {
            if (arquivo.Size > TamanhoMaximoAnexoBytes)
            {
                _erroAnexoLicencaOperacao = $"\"{arquivo.Name}\" excede 20MB e não foi adicionado.";
                continue;
            }
            if (_anexosLicencaOperacao.Any(a => a.Nome == arquivo.Name))
                continue;

            _anexosLicencaOperacao.Add((arquivo.Name, arquivo.Size));
        }
        await Task.CompletedTask;
    }

    private void RemoverAnexoLicencaOperacao(string nome) =>
        _anexosLicencaOperacao.RemoveAll(a => a.Nome == nome);

    private static string FormatarTamanhoArquivo(long bytes) =>
        bytes < 1024 * 1024
            ? $"{bytes / 1024.0:0.#} KB"
            : $"{bytes / 1024.0 / 1024.0:0.#} MB";

    private string _percObraTexto = "";

    private List<ValidacaoTemplateDto> _catalogoValidacoes = [];

    private readonly Dictionary<int, List<Comentario>> _comentariosPorValidacao = new();

    private DesembolsoDetalheDto? _detalheAtual;

    private int _etapaAtual = 1;
    private bool _enviando, _buscando, _buscaOk;
    private string? _msgBusca;

    protected override async Task OnInitializedAsync()
    {
        if (ModoEdicao && DadosParaEdicao is not null)
        {
            PreencherParaEdicao(DadosParaEdicao);
            _detalheAtual = DadosParaEdicao;
        }
        else
        {
            _fpd.Solicitante = ServicoUsuario.Matricula;
        }

        try
        {
            _catalogoValidacoes = await ControleAnaliseDesembolsoService.ObterValidacoesTemplateAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FPD] Falha ao carregar catálogo de validações: {ex.Message}");
        }

        if (ModoEdicao && _detalheAtual is not null)
        {
            CarregarComentariosDoDetalhe();
        }
    }

    private static string FmtPerc(decimal? p) => p is null ? "—" : $"{p.Value.ToString("0.000", new CultureInfo("pt-BR"))}%";

    private static string ClassePercComparado(decimal? valor, decimal? referencia) =>
        valor is null || referencia is null ? "" : valor <= referencia ? "fpd-perc-ok" : "fpd-perc-alerta";
    private static string? BoolParaSimNao(bool? b) => b switch { true => "sim", false => "nao", _ => null };
    private static bool? SimNaoParaBool(string? s) => s switch { "sim" => true, "nao" => false, _ => null };


    private int? ResolverCoValidacao(string titulo) =>
        _catalogoValidacoes.FirstOrDefault(v => v.DeValidacao == titulo)?.CoValidacao;

    private List<Comentario> ObterComentarios(string titulo)
    {
        var coValidacao = ResolverCoValidacao(titulo);
        if (coValidacao is null) return [];
        return _comentariosPorValidacao.TryGetValue(coValidacao.Value, out var lista)
            ? lista
            : (_comentariosPorValidacao[coValidacao.Value] = []);
    }

    private void CarregarComentariosDoDetalhe()
    {
        _comentariosPorValidacao.Clear();
        if (_detalheAtual is null) return;

        foreach (var v in _detalheAtual.Checklist)
        {
            _comentariosPorValidacao[v.CoValidacao] = v.Comentarios
                .OrderBy(c => c.DtCriacao)
                .Select(c => new Comentario
                {
                    Id = c.CoMensagem,
                    Tipo = c.TipoMensagem,
                    Texto = c.Texto ?? "",
                    Autor = c.NomeAutor ?? c.MatriculaAutor ?? "",
                    MatriculaAutor = c.MatriculaAutor ?? "",
                    UnidadeAutor = c.UnidadeAutor,
                    Timestamp = c.DtCriacao,
                }).ToList();
        }
    }

    private async Task RecarregarDetalheAtual()
    {
        if (_detalheAtual is null) return;
        try
        {
            var atualizado = await ControleAnaliseDesembolsoService.ObterDetalheDesembolsoAsync(_detalheAtual.CoControleDesembolso.ToString());
            if (atualizado is not null) _detalheAtual = atualizado;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FPD] Falha ao recarregar detalhe: {ex.Message}");
        }
        CarregarComentariosDoDetalhe();
        StateHasChanged();
    }

    private async Task AdicionarComentario(string titulo, Comentario c)
    {
        var coValidacao = ResolverCoValidacao(titulo);
        if (coValidacao is null)
        {
            Snackbar.Add("Não foi possível identificar essa validação — o catálogo pode não ter carregado ainda. Tente de novo.", Severity.Error);
            return;
        }

        if (ModoEdicao && _detalheAtual is not null)
        {
            try
            {
                var resposta = await ControleAnaliseDesembolsoService.AdicionarComentarioAsync(_detalheAtual.CoControleDesembolso.ToString(), coValidacao.Value,
                    c.Texto, c.Tipo, ServicoUsuario.Matricula, ServicoUsuario.Nome, ServicoUsuario.UnidadeUsuario);
                if (!resposta.IsSuccessStatusCode)
                    Snackbar.Add(await ControleAnaliseDesembolsoService.ExtrairMensagemDeErroAsync(resposta), Severity.Error);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[FPD] Adicionar comentário: {ex.Message}");
                Snackbar.Add("Falha ao salvar o comentário. Tente novamente.", Severity.Error);
            }
            await RecarregarDetalheAtual();
        }
        else
        {
            ObterComentarios(titulo).Add(c);
        }
    }

    private async Task EditarComentario(string titulo, Comentario editado)
    {
        if (!ModoEdicao || _detalheAtual is null) return;

        var coValidacao = ResolverCoValidacao(titulo);
        if (coValidacao is null)
        {
            Snackbar.Add("Não foi possível identificar essa validação — o catálogo pode não ter carregado ainda. Tente de novo.", Severity.Error);
            return;
        }

        try
        {
            var resposta = await ControleAnaliseDesembolsoService.EditarComentarioAsync(_detalheAtual.CoControleDesembolso.ToString(), coValidacao.Value, editado.Id, editado.Texto, ServicoUsuario.Matricula);
            if (!resposta.IsSuccessStatusCode)
                Snackbar.Add(await ControleAnaliseDesembolsoService.ExtrairMensagemDeErroAsync(resposta), Severity.Error);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[FPD] Editar comentário: {ex.Message}");
            Snackbar.Add("Falha ao editar o comentário. Tente novamente.", Severity.Error);
        }
        await RecarregarDetalheAtual();
    }

    private async Task RemoverComentarioValidacao(string titulo, Comentario c)
    {
        var coValidacao = ResolverCoValidacao(titulo);
        if (coValidacao is null)
        {
            Snackbar.Add("Não foi possível identificar essa validação — o catálogo pode não ter carregado ainda. Tente de novo.", Severity.Error);
            return;
        }

        if (ModoEdicao && _detalheAtual is not null)
        {
            try
            {
                var resposta = await ControleAnaliseDesembolsoService.RemoverComentarioAsync(_detalheAtual.CoControleDesembolso.ToString(), coValidacao.Value, c.Id, ServicoUsuario.Matricula);
                if (!resposta.IsSuccessStatusCode)
                    Snackbar.Add(await ControleAnaliseDesembolsoService.ExtrairMensagemDeErroAsync(resposta), Severity.Error);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[FPD] Remover comentário: {ex.Message}");
                Snackbar.Add("Falha ao remover o comentário. Tente novamente.", Severity.Error);
            }
            await RecarregarDetalheAtual();
        }
        else
        {
            ObterComentarios(titulo).Remove(c);
        }
    }

