@using ControleAnaliseDesembolso.Modelos
@using ControleAnaliseDesembolso.Service
@inject ServicoUsuarioUI ServicoUsuario
@inject IJSRuntime JS

<div class="fio">
    @foreach (var c in Comentarios)
    {
        var cfg = TiposComentario.Configs.GetValueOrDefault(c.Tipo) ?? TiposComentario.Configs["informativo"];
        var emEdicao = _editandoId == c.Id;
        var podeEditar = !ApenasLeitura && c.MatriculaAutor == ServicoUsuario.Matricula;
        @if (emEdicao)
        {
            <div id="@("fio-edit-" + c.Id)" class="form-tratativa form-tratativa-foco">
                <textarea class="form-textarea" rows="3" @bind="_textoEdicao" @bind:event="oninput"></textarea>
                <div class="form-acoes-bar">
                    <span></span>
                    <div class="form-acoes-dir">
                        <button class="btn-cancelar" @onclick="CancelarEdicao">Cancelar</button>
                        <button class="btn-salvar-tratativa" @onclick="() => SalvarEdicao(c)" disabled="@string.IsNullOrWhiteSpace(_textoEdicao)">
                            <i class="bi bi-check2"></i> Salvar edição
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="comentario" style="background: @cfg.CorFundo">
                <div class="comentario-cabecalho">
                    <span class="comentario-ponto" style="background: @cfg.CorPonto"></span>
                    <span class="comentario-tipo" style="color: @cfg.CorTexto">@NomeTipo(c.Tipo)</span>
                    <span class="comentario-autor">@c.Autor</span>
                    <span class="comentario-unidade">@(c.UnidadeAutor == 7175 ? "CEFGA" : "GIGOV")</span>
                    @if (c.EditadoEm is not null)
                    {
                        <span class="comentario-editado">(editado)</span>
                    }
                    <span class="comentario-tempo">@ServicoMock.FormatarTempo(c.Timestamp)</span>
                    @if (podeEditar)
                    {
                        <button class="btn-editar-comentario" @onclick="() => IniciarEdicao(c)" title="Editar comentário">
                            <i class="bi bi-pencil"></i>
                        </button>
                        <button class="btn-editar-comentario" @onclick="() => RemoverComentario(c)" title="Remover comentário">
                            <i class="bi bi-trash3"></i>
                        </button>
                    }
                </div>
                <p class="comentario-texto">@c.Texto</p>
            </div>
        }
    }

    @if (_adicionando)
    {
        <div id="@_idFormAdicionar" class="form-tratativa @(_comFoco ? "form-tratativa-foco" : "")">

            <textarea class="form-textarea"
                      placeholder="Descreva a tratativa ou observação..."
                      rows="3"
                      @bind="_novoTexto"
                      @bind:event="oninput"
                      @onfocus="() => _comFoco = true"
                      @onblur="() => _comFoco = false"></textarea>

            <div class="form-acoes-bar">
                @if (!ApenasInformativo)
                {
                    <div class="seletor-tipo">
                        @foreach (var tipo in new[] { "justificativa", "informativo", "parecer" })
                        {
                            var cfg2 = TiposComentario.Configs[tipo];
                            var ativo = _novoTipo == tipo;
                            <button class="btn-tipo @(ativo ? "btn-tipo-ativo" : "")"
                                    style="@(ativo ? $"border-color:{cfg2.CorPonto};color:{cfg2.CorTexto};background:{cfg2.CorFundo}" : "")"
                                    @onclick="() => _novoTipo = tipo">
                                <span class="btn-tipo-dot" style="background: @cfg2.CorPonto"></span>
                                @NomeTipo(tipo)
                            </button>
                        }
                    </div>
                }
                else
                {
                    <span></span>
                }

                <div class="form-acoes-dir">
                    <button class="btn-cancelar" @onclick="CancelarAdicao">Cancelar</button>
                    <button class="btn-salvar-tratativa"
                            @onclick="SalvarComentario"
                            disabled="@string.IsNullOrWhiteSpace(_novoTexto)">
                        <i class="bi bi-check2"></i> Salvar comentário
                    </button>
                </div>
            </div>
        </div>
    }
    else if (!ApenasLeitura && !(LimitarUmComentario && Comentarios.Any()))
    {
        <button class="btn-adicionar-comentario" @onclick="AbrirAdicionar">
            <i class="bi bi-plus"></i> Adicionar comentário
        </button>
    }
    else if (!Comentarios.Any())
    {
        <span class="fio-sem-comentario">Sem comentários</span>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<Comentario> Comentarios           { get; set; } = [];
    [Parameter] public EventCallback<Comentario>        AoAdicionarComentario { get; set; }
    [Parameter] public EventCallback<Comentario>        AoEditarComentario    { get; set; }
    [Parameter] public EventCallback<Comentario>        AoRemoverComentario   { get; set; }
    [Parameter] public bool                             ApenasLeitura         { get; set; }
    [Parameter] public bool                             ApenasInformativo     { get; set; }
    [Parameter] public bool                             LimitarUmComentario   { get; set; }

    private bool   _adicionando = false;
    private bool   _comFoco     = false;
    private string _novoTipo    = "informativo";
    private string _novoTexto   = "";

    private int?   _editandoId;
    private string _textoEdicao = "";

    private readonly string _idFormAdicionar = $"fio-add-{Guid.NewGuid():N}";

    protected override void OnParametersSet()
    {
        if (ApenasInformativo) _novoTipo = "informativo";
    }

    private async Task SalvarComentario()
    {
        if (string.IsNullOrWhiteSpace(_novoTexto)) return;

        var novoComentario = new Comentario
        {
            Tipo           = _novoTipo,
            Texto          = _novoTexto.Trim(),
            Autor          = ServicoUsuario.Nome,
            MatriculaAutor = ServicoUsuario.Matricula,
            UnidadeAutor   = ServicoUsuario.UnidadeUsuario,
            Timestamp      = DateTime.Now
        };

        await AoAdicionarComentario.InvokeAsync(novoComentario);
        CancelarAdicao();
    }

    private void CancelarAdicao()
    {
        _adicionando = false;
        _novoTexto   = "";
        _novoTipo    = "informativo";
        _comFoco     = false;
    }

    private async Task AbrirAdicionar()
    {
        _adicionando = true;
        StateHasChanged();
        await Task.Delay(120);
        await JS.InvokeVoidAsync("scrollSubItemIntoView", _idFormAdicionar);
    }

    private async Task IniciarEdicao(Comentario c)
    {
        _editandoId  = c.Id;
        _textoEdicao = c.Texto;
        StateHasChanged();
        await Task.Delay(120);
        await JS.InvokeVoidAsync("scrollSubItemIntoView", $"fio-edit-{c.Id}");
    }

    private async Task RemoverComentario(Comentario c) => await AoRemoverComentario.InvokeAsync(c);

    private void CancelarEdicao()
    {
        _editandoId  = null;
        _textoEdicao = "";
    }

    private async Task SalvarEdicao(Comentario c)
    {
        if (string.IsNullOrWhiteSpace(_textoEdicao)) return;

        c.Texto     = _textoEdicao.Trim();
        c.EditadoEm = DateTime.Now;

        await AoEditarComentario.InvokeAsync(c);
        CancelarEdicao();
    }

    private static string NomeTipo(string tipo) => tipo switch
    {
        "justificativa" => "Justificativa",
        "parecer"       => "Parecer",
        _               => "Informativo"
    };
}


<style>
.fio { display: flex; flex-direction: column; gap: 8px; }

.comentario {
    border-radius: var(--radius-md);
    padding: 8px 10px;
}
.comentario-cabecalho {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 4px;
    flex-wrap: wrap;
}
.comentario-ponto  { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.comentario-tipo   { font-size: 10px; font-weight: 700; }
.comentario-autor  { font-size: 10px; color: var(--ink-700); font-weight: 500; }
.comentario-unidade {
    font-size: 9px;
    font-weight: 700;
    color: var(--ink-500);
    background: var(--ink-100);
    border-radius: var(--radius-full);
    padding: 1px 6px;
    letter-spacing: .03em;
    flex-shrink: 0;
}
.comentario-tempo  { font-size: 10px; color: var(--ink-500); margin-left: auto; }
.comentario-editado { font-size: 10px; color: var(--ink-400, var(--ink-300)); font-style: italic; }
.comentario-texto  { font-size: 12px; color: var(--ink-900); line-height: 1.5; }

.btn-editar-comentario {
    width: 18px; height: 18px;
    display: inline-flex; align-items: center; justify-content: center;
    border-radius: var(--radius-md);
    color: var(--ink-500); font-size: 10px;
    background: transparent;
    transition: background .12s, color .12s;
    flex-shrink: 0;
}
.btn-editar-comentario:hover { background: rgba(0,0,0,.06); color: var(--ink-900); }

.form-tratativa {
    display: flex;
    flex-direction: column;
    border: 1.5px solid var(--ink-200);
    border-radius: var(--radius-lg);
    background: #fff;
    overflow: hidden;
    transition: border-color .15s, box-shadow .15s;
}
.form-tratativa-foco {
    border-color: var(--brand-300);
    box-shadow: 0 0 0 3px var(--brand-50);
}

.form-rotulo {
    padding: 8px 12px 0;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .12em;
    color: var(--ink-500);
}

.form-textarea {
    resize: none;
    border: none;
    padding: 10px 12px 8px;
    font-size: 13px;
    font-family: inherit;
    color: var(--ink-900);
    line-height: 1.55;
    background: transparent;
    width: 100%;
}
.form-textarea:focus { outline: none; }
.form-textarea::placeholder { color: var(--ink-300); }

.form-acoes-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 8px 10px;
    border-top: 1px solid var(--ink-100);
    background: #FAFBFC;
    flex-wrap: wrap;
}

.seletor-tipo { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }

.btn-tipo {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 24px;
    padding: 0 10px;
    border-radius: var(--radius-full);
    font-size: 11px;
    font-weight: 600;
    font-family: inherit;
    border: 1px solid var(--ink-200);
    color: var(--ink-500);
    background: transparent;
    cursor: pointer;
    transition: all .15s;
}
.btn-tipo:hover { background: var(--ink-50); color: var(--ink-700); }
.btn-tipo-ativo { font-weight: 700; }

.btn-tipo-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
    display: inline-block;
}

.form-acoes-dir { display: flex; align-items: center; gap: 6px; }

.btn-cancelar {
    height: 26px; padding: 0 10px;
    border-radius: var(--radius-md);
    font-size: 11.5px;
    font-family: inherit;
    color: var(--ink-500);
    background: transparent;
    border: 1px solid var(--ink-200);
    cursor: pointer;
    transition: background .15s;
}
.btn-cancelar:hover { background: var(--ink-50); color: var(--ink-700); }

.btn-salvar-tratativa {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    height: 26px;
    padding: 0 12px;
    border-radius: var(--radius-md);
    font-size: 11.5px;
    font-weight: 600;
    font-family: inherit;
    color: var(--ink-500);
    background: #fff;
    border: 1px solid var(--ink-200);
    cursor: pointer;
    transition: all .15s;
    box-shadow: var(--shadow-card);
}
.btn-salvar-tratativa:hover:not(:disabled) {
    background: var(--brand-50);
    border-color: var(--brand-200);
    color: var(--brand-700);
}
.btn-salvar-tratativa:disabled { opacity: .4; cursor: not-allowed; }
.btn-salvar-tratativa i { font-size: 12px; }

.btn-adicionar-comentario {
    height: 28px;
    padding: 0 10px;
    border-radius: var(--radius-md);
    font-size: 11px;
    font-weight: 500;
    font-family: inherit;
    color: var(--brand-700);
    background: var(--brand-50);
    border: 1px dashed var(--brand-200);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    cursor: pointer;
    transition: background .15s, border-color .15s;
    width: fit-content;
}
.btn-adicionar-comentario:hover { background: var(--brand-100); border-color: var(--brand-300); }
.fio-sem-comentario { font-size: 11px; color: var(--ink-400, var(--ink-300)); font-style: italic; }
</style>
