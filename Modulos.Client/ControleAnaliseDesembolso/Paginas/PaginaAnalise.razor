    }
    .btn-toggle-modo-teste:hover { background: #FEF3C7; }
    .btn-toggle-modo-teste i { font-size: 12px; }

    .stats-consolidado {
        margin-top: 16px;
        overflow: hidden;
        border-radius: var(--radius-xl);
        border: 1px solid var(--ink-100);
        background: #fff;
        box-shadow: var(--shadow-card);
    }

    .stats-consolidado-header {
