    }

    .stats-cell-label {
        font-size: 10.5px;
        font-weight: 500;
        color: var(--ink-500);
        margin-top: 4px;
    }

    .filtros-area {
        background: #F4F7FB;
    }

    .filtros-container {
        max-width: 1200px;
        margin: 0;
        padding: 8px 32px;
        display: flex;
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
        border-bottom: 1px solid var(--ink-100);
    }

    .filtro-pill {
        display: inline-flex;
        align-items: center;
        border-radius: var(--radius-full);
