                color: var(--ink-300);
            }

            .busca-tabela input:focus {
                outline: none;
            }

    .btn-apresentacao {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-lg);
        background: #002A4D;
        padding: 6px 14px;
        font-size: 11.5px;
        font-weight: 700;
        font-family: inherit;
        color: #fff;
        box-shadow: var(--shadow-card);
        border: none;
        cursor: pointer;
        transition: background .15s, opacity .15s;
    }

        .btn-apresentacao:hover:not(:disabled) {
            background: #00437A;
        }

        .btn-apresentacao:disabled,
        .btn-apresentacao-off {
            opacity: .45;
            cursor: not-allowed;
        }

    .btn-fpd {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-lg);
        background: var(--amber-600);
        padding: 6px 14px;
        font-size: 11.5px;
        font-weight: 700;
        font-family: inherit;
        color: #fff;
        box-shadow: var(--shadow-card);
        border: none;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-fpd:hover {
            background: var(--amber-700);
        }

    .btn-processar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-lg);
        background: var(--brand-700);
        padding: 6px 14px;
        font-size: 11.5px;
        font-weight: 700;
        font-family: inherit;
        color: #fff;
        box-shadow: var(--shadow-card);
        border: none;
        cursor: pointer;
        transition: background .15s;
    }

        .btn-processar:hover:not(:disabled) {
            background: var(--brand-800);
        }

        .btn-processar:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .btn-processando {
        opacity: .75 !important;
        cursor: wait !important;
    }

    .contratos-area {
        flex: 1;
        background: #F4F7FB;
    }

    .contratos-container {
        max-width: 1200px;
        margin: 0;
        padding: 16px 32px 64px;
    }

    .skeletons {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .grupos-lista {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .grupo-card {
        overflow: hidden;
        border-radius: var(--radius-xl);
        border: 1px solid var(--ink-100);
        background: #fff;
        box-shadow: var(--shadow-card);
    }

    .grupo-card-header {
        display: flex;
        align-items: center;
        padding: 14px 20px;
        background: #fff;
    }

        .grupo-card-header.com-borda {
            border-bottom: 1px solid var(--ink-100);
        }

    .grupo-paginacao {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 14px;
        padding: 12px 0 16px;
        border-top: 1px solid var(--ink-50);
    }

    .grupo-btn-pagina {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: var(--radius-md);
        border: 1px solid var(--ink-100);
        background: #fff;
        color: var(--ink-700);
        cursor: pointer;
        transition: background .15s;
    }
    .grupo-btn-pagina:hover:not(:disabled) { background: var(--ink-50); }
    .grupo-btn-pagina:disabled { opacity: .4; cursor: not-allowed; }

    .grupo-paginacao-info { font-size: 11.5px; font-weight: 600; color: var(--ink-500); }

    .cols-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 8px 20px;
        background: #fff;
    }

    .col-h {
        font-size: 10px;
        font-weight: 700;
        color: var(--ink-500);
        text-transform: uppercase;
        letter-spacing: .08em;
        flex-shrink: 0;
    }

    .tabela-vazia {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 16px;
        padding: 80px 0;
        border-radius: var(--radius-xl);
        border: 1px dashed var(--ink-200);
        background: #fff;
        text-align: center;
        box-shadow: var(--shadow-card);
    }

        .tabela-vazia i {
            font-size: 32px;
            color: var(--ink-300);
        }

    .tabela-vazia-titulo {
        font-size: 15px;
        font-weight: 600;
        color: var(--ink-700);
    }

    .tabela-vazia-sub {
        font-size: 13px;
        color: var(--ink-500);
    }

    .overlay-atrib {
        position: fixed;
        inset: 0;
        z-index: 400;
        background: transparent;
    }

    .popover-atrib {
        position: fixed;
        z-index: 401;
        width: 220px;
        background: #fff;
        border: 1px solid var(--ink-100);
        border-radius: var(--radius-xl);
        box-shadow: 0 8px 24px rgba(0,0,0,.13), 0 2px 6px rgba(0,0,0,.07);
        overflow: hidden;
        animation: slideDown .15s ease;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .popover-atrib-titulo {
        padding: 10px 14px;
        font-size: 9.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .12em;
        color: var(--ink-400);
        border-bottom: 1px solid var(--ink-100);
    }

    .popover-atrib-lista {
        max-height: 210px;
        overflow-y: auto;
    }

    .popover-atrib-item {
        display: flex;
        align-items: center;
        gap: 9px;
        width: 100%;
        padding: 9px 14px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--ink-800);
        background: transparent;
        border: none;
        border-bottom: 1px solid var(--ink-50);
        cursor: pointer;
        transition: background .12s;
        font-family: inherit;
        text-align: left;
    }

        .popover-atrib-item:hover {
            background: var(--brand-50);
        }

    .popover-atrib-item-ativo {
        background: var(--brand-50);
        color: var(--brand-800);
        font-weight: 600;
    }

    .popover-atrib-avatar {
        width: 26px;
        height: 26px;
        border-radius: 50%;
        color: #fff;
        font-size: 9px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .popover-atrib-nome {
        flex: 1;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .popover-atrib-check {
        color: var(--brand-600);
        font-size: 12px;
    }

    .popover-atrib-remover {
        width: 100%;
        padding: 9px 14px;
        font-size: 11.5px;
        font-weight: 500;
        color: var(--err);
        background: transparent;
        border: none;
        border-top: 1px solid var(--ink-100);
        cursor: pointer;
        text-align: left;
        font-family: inherit;
        transition: background .12s;
    }

        .popover-atrib-remover:hover {
            background: var(--err-bg);
        }
</style>
@{
    var todos           = _todos;
    var totalVal        = todos.Sum(d => d.ValidacoesTotal);
    var totalOk         = todos.Sum(d => d.ValidacoesOk);
    var qtdPendencias   = todos.Count(d => d.Status == "pendencia" && !d.Sanepar);
    var qtdPendentes    = todos.Count(d => d.Status == "pendente" && !d.Sanepar);
    var qtdSanepar      = todos.Count(d => d.Sanepar && d.Status is "pendencia" or "pendente");
    var qtdAguardandoBaixa = todos.Count(d => d.Status == "aprovado");
    var totalPedidos    = qtdPendencias + qtdPendentes + qtdAguardandoBaixa + qtdSanepar;
    var totalPedidosGeral = qtdPendencias + qtdPendentes + qtdSanepar;

    var filtrados = _filtroAtivo switch
    {
        "invalidos" => todos.Where(d => d.Status == "pendencia" && !d.Sanepar).ToList(),
        "pendentes" => todos.Where(d => d.Status == "pendente" && !d.Sanepar).ToList(),
        "sanepar"   => todos.Where(d => d.Sanepar && d.Status is "pendencia" or "pendente").ToList(),
        _           => todos
    };

    var buscados = AplicarBusca(filtrados);

    var buscadosNaoDrp = buscados.Where(d => d.Status is not ("aprovado" or "baixado" or "negado" or "cancelado")).ToList();

    var grupoPendencias = buscados.Where(d => d.Status == "pendencia" && !d.Sanepar).ToList();
    var grupoPendentes  = buscados.Where(d => d.Status == "pendente" && !d.Sanepar).ToList();
    var grupoSanepar = buscados.Where(d => d.Sanepar && d.Status is "pendencia" or "pendente").ToList();

    var emAndamentoGigov = buscados.Where(d => d.Status is "pendencia" or "pendente").ToList();
    var concluidosGigov = todos.Where(d => d.Status is "aprovado" or "baixado" or "negado" or "cancelado").ToList();
}

<div class="pagina">

    <section class="pagina-header-secao">
        <div class="pagina-header-container">
           
            <h1 class="pagina-titulo">
                Controle <span class="titulo-destaque">Análise Desembolso</span>
                @if (ServicoUsuario.EhGigov && _meusGigov.Count > 0)
                {
                    <span class="titulo-gigov-sufixo"> - GIGOV @string.Join(", ", _meusGigov)</span>
                }
            </h1>

            <button class="btn-toggle-modo-teste" @onclick="AlternarModoTeste" title="Só pra teste — alterna a identidade simulada e recarrega a página">
                <i class="bi bi-arrow-repeat"></i>
                <span>Testando como: <strong>@(ServicoUsuario.ModoGigovForcado ? $"GIGOV {ServicoUsuarioUI.CodigoGigovTeste}" : "CEFGA 7175")</strong></span>
            </button>

            @if (!ServicoUsuario.EhGigov)
            {
                <div class="stats-consolidado">
                    <div class="stats-consolidado-header">
                        <span class="stats-consolidado-titulo">Relatório Consolidado</span>
                    </div>
                    <div class="stats-consolidado-cells">

                        <div class="stats-cell">
                            <div class="stats-cell-icon" style="background:#EBF5FF">
                                <i class="bi bi-list-check" style="color:#005CA9;font-size:14px"></i>
                            </div>
                            <div>
                                <div class="stats-cell-valor">@totalPedidos</div>
                                <div class="stats-cell-label">Total Pedidos</div>
                            </div>
                        </div>

                        <div class="stats-cell">
                            <div class="stats-cell-icon" style="background:#FEF2F2">
                                <i class="bi bi-exclamation-triangle" style="color:#C0392B;font-size:14px"></i>
                            </div>
                            <div>
                                <div class="stats-cell-valor">@qtdPendencias</div>
                                <div class="stats-cell-label">Com pendência</div>
                            </div>
                        </div>

                        <div class="stats-cell">
                            <div class="stats-cell-icon" style="background:#FFFBEB">
                                <i class="bi bi-clock" style="color:#D87B00;font-size:14px"></i>
                            </div>
                            <div>
                                <div class="stats-cell-valor">@qtdPendentes</div>
                                <div class="stats-cell-label">Para analisar</div>
                            </div>
                        </div>

                        <div class="stats-cell">
                            <div class="stats-cell-icon" style="background:#F0FDF4">
                                <i class="bi bi-check-circle" style="color:#1A7A4A;font-size:14px"></i>
                            </div>
                            <div>
                                <div class="stats-cell-valor">@qtdAguardandoBaixa</div>
                                <div class="stats-cell-label">Aguardando Baixa</div>
                            </div>
                        </div>

                        <div class="stats-cell">
                            <div class="stats-cell-icon" style="background:#EAF3FC">
                                <i class="bi bi-calendar-check" style="color:#2D8AD8;font-size:14px"></i>
                            </div>
                            <div>
                                <div class="stats-cell-valor">@qtdSanepar</div>
                                <div class="stats-cell-label">Total SANEPAR</div>
                            </div>
                        </div>

                    </div>
                </div>
            }

        </div>
    </section>

    <div class="filtros-area">
        <div class="filtros-container">

            <div class="grupo-consulta">
                <div class="filtro-pill">
                    <button class="filtro-btn @(_filtroAtivo == "geral"     ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("geral")'>
                        <span class="filtro-dot" style="background:#9EB2BB;opacity:@(_filtroAtivo=="geral"?"1":"0.5")"></span>
                        Geral
                        <span class="filtro-badge @(_filtroAtivo == "geral" ? "filtro-badge-ativo" : "")">@(ServicoUsuario.EhGigov ? emAndamentoGigov.Count : totalPedidosGeral)</span>
                    </button>

                    @if (!ServicoUsuario.EhGigov)
                    {
                        <button class="filtro-btn @(_filtroAtivo == "invalidos" ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("invalidos")' title="FPDs que acabaram de entrar, aguardando a 1ª validação da macro">
                            <span class="filtro-dot" style="background:#C0392B;opacity:@(_filtroAtivo=="invalidos"?"1":"0.5")"></span>
                            Pendente
                            @if (qtdPendencias > 0)
                            {
                                <span class="filtro-badge @(_filtroAtivo == "invalidos" ? "filtro-badge-ativo" : "")">@qtdPendencias</span>
                            }
                        </button>

                        <button class="filtro-btn @(_filtroAtivo == "pendentes" ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("pendentes")'>
                            <span class="filtro-dot" style="background:#D87B00;opacity:@(_filtroAtivo=="pendentes"?"1":"0.5")"></span>
                            Analisar
                            @if (qtdPendentes > 0)
                            {
                                <span class="filtro-badge @(_filtroAtivo == "pendentes" ? "filtro-badge-ativo" : "")">@qtdPendentes</span>
                            }
                        </button>

                        <button class="filtro-btn @(_filtroAtivo == "sanepar"  ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("sanepar")' title="Desembolsos SANEPAR — categoria própria, com seus próprios status Pendente/Analisar">
                            <span class="filtro-dot" style="background:#2D8AD8;opacity:@(_filtroAtivo=="sanepar"?"1":"0.5")"></span>
                            SANEPAR
                            @if (qtdSanepar > 0)
                            {
                                <span class="filtro-badge @(_filtroAtivo == "sanepar" ? "filtro-badge-ativo" : "")">@qtdSanepar</span>
                            }
                        </button>
                    }


                    <button class="filtro-btn @(_filtroAtivo == "drp"  ? "filtro-btn-ativo" : "")" @onclick='() => SelecionarFiltro("drp")'>
                        <span class="filtro-dot" style="background:#1074C8;opacity:@(_filtroAtivo=="drp"?"1":"0.5")"></span>
                        @(ServicoUsuario.EhGigov ? "Concluídos" : "Relatórios")
                    </button>
                </div>

                @if (_filtroAtivo != "drp")
                {
                    <div class="busca-tabela">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Buscar..." @bind="_textoBusca" @bind:event="oninput" @bind:after="ResetarPaginasGrupos" />
                    </div>
                }
            </div>

            @if (_filtroAtivo != "drp")
            {
            <div class="grupo-acoes">

                @if (!ServicoUsuario.EhGigov)
                {
                    <button class="btn-processar @(_processando ? "btn-processando" : "")" @onclick="AbrirValidarPendentes" disabled="@_processando"
                            title="Roda a validação em lote pra todo desembolso ainda no status inicial (pendência)">
                        <i class="bi bi-@(_processando ? "hourglass-split" : "shield-check")"></i>
                        <span>@(_processando ? "Validando..." : "Validar Pendentes")</span>
                    </button>
                }

                @if (ServicoUsuario.EhGigov)
                {
                    <button class="btn-fpd" @onclick="() => _fpdEtapasAberto = true" title="Registrar Ficha de Previsão de Desembolso em etapas">
                        <i class="bi bi-plus-lg"></i>
                        <span>Preencher FPD</span>
                    </button>
                }

            </div>
            }

        </div>
    </div>

    <BarraProgresso />

    <div class="contratos-area">
        <div class="contratos-container">

            @if (_filtroAtivo == "drp")
            {
                @if (ServicoUsuario.EhGigov)
                {
                    <TabelaConcluidosGigov Desembolsos="@concluidosGigov"
                                           Selecionado="@_idDialogAberto"
                                           AoClicar="@(id => AbrirDialog(id))" />
                }
                else
                {
                    <TabelaBaixaDrp />
                }
            }
            else if (_carregando)
            {
                <div class="skeletons">
                    @for (int i = 0; i < 6; i++)
                    {
                        <div class="skeleton" style="height:56px;border-radius:var(--radius-xl)"></div>
                    }
                </div>
            }
            else if (_filtroAtivo == "geral" && ServicoUsuario.EhGigov)
            {
                <div class="grupos-lista">
                    @if (emAndamentoGigov.Any())
                    {
                        <section class="grupo-card">
                            <div class="grupo-card-header @(_grupoEmAndamentoAberto ? "com-borda" : "")">
                                <CabecalhoGrupo Titulo="Em Andamento"
                                                Contagem="@emAndamentoGigov.Count"
                                                Tipo="geral"
                                                Aberto="@_grupoEmAndamentoAberto"
                                                AoAlternar="@(v => _grupoEmAndamentoAberto = v)" />
                            </div>
                            <div class="acc-body @(_grupoEmAndamentoAberto ? "aberto" : "")">
                                <div class="acc-inner">
                                    @ColsHeader
                                    @foreach (var d in emAndamentoGigov)
                                    {
                                        <LinhaContrato Desembolso="d"
                                                      MostrarAguardando="false"
                                                      MostrarMutuario="true"
                                                      MostrarResponsavel="false"
                                                      Analista="@ObterAnalista(d.Id)"
                                                      Selecionada="@(_idDialogAberto == d.Id)"
                                                      AoClicar="@(() => AbrirDialog(d.Id))"
                                                      AoAtribuir="@((MouseEventArgs e) => { _idAtribuicao = d.Id; _popoverX = e.ClientX; _popoverY = e.ClientY; })" />
                                    }
                                </div>
                            </div>
                        </section>
                    }

                    @if (!emAndamentoGigov.Any())
                    {
                        <div class="tabela-vazia">
                            <i class="bi bi-folder2-open"></i>
                            <div class="tabela-vazia-titulo">Nenhum desembolso em andamento</div>
                            <div class="tabela-vazia-sub">Seus desembolsos em análise aparecerão aqui.</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="grupos-lista">

                    @if (grupoPendencias.Any())
                    {
                        <section class="grupo-card">
                            <div class="grupo-card-header @(_grupoPendenciasAberto ? "com-borda" : "")">
                                <CabecalhoGrupo Titulo="Pendente"
                                                Contagem="@grupoPendencias.Count"
                                                Tipo="pendencia"
                                                Aberto="@_grupoPendenciasAberto"
                                                AoAlternar="@(v => _grupoPendenciasAberto = v)" />
                            </div>
                            <div class="acc-body @(_grupoPendenciasAberto ? "aberto" : "")">
                                <div class="acc-inner">
                                    @ColsHeader
                                    @{ _paginaPendencias = PaginaValidaGrupo(_paginaPendencias, grupoPendencias.Count); }
                                    @foreach (var d in Paginar(grupoPendencias, _paginaPendencias))
                                    {
                                        <LinhaContrato Desembolso="d"
                                                      MostrarAguardando="false"
                                                      MostrarMutuario="ServicoUsuario.EhGigov"
                                                      MostrarResponsavel="!ServicoUsuario.EhGigov"
                                                      Analista="@ObterAnalista(d.Id)"
                                                      Selecionada="@(_idDialogAberto == d.Id)"
                                                      AoClicar="@(() => AbrirDialog(d.Id))"
                                                      AoAtribuir="@((MouseEventArgs e) => { _idAtribuicao = d.Id; _popoverX = e.ClientX; _popoverY = e.ClientY; })" />
                                    }
                                </div>
                                @if (TotalPaginasGrupo(grupoPendencias.Count) > 1)
                                {
                                    <div class="grupo-paginacao">
                                        <button class="grupo-btn-pagina" disabled="@(_paginaPendencias <= 1)" @onclick="() => _paginaPendencias--">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>
                                        <span class="grupo-paginacao-info">Página @_paginaPendencias de @TotalPaginasGrupo(grupoPendencias.Count)</span>
                                        <button class="grupo-btn-pagina" disabled="@(_paginaPendencias >= TotalPaginasGrupo(grupoPendencias.Count))" @onclick="() => _paginaPendencias++">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (grupoPendentes.Any())
                    {
                        <section class="grupo-card">
                            <div class="grupo-card-header @(_grupoPendentesAberto ? "com-borda" : "")">
                                <CabecalhoGrupo Titulo="Analisar"
                                                Contagem="@grupoPendentes.Count"
                                                Tipo="pendente"
                                                Aberto="@_grupoPendentesAberto"
                                                AoAlternar="@(v => _grupoPendentesAberto = v)" />
                            </div>
                            <div class="acc-body @(_grupoPendentesAberto ? "aberto" : "")">
                                <div class="acc-inner">
                                    @ColsHeader
                                    @{ _paginaPendentes = PaginaValidaGrupo(_paginaPendentes, grupoPendentes.Count); }
                                    @foreach (var d in Paginar(grupoPendentes, _paginaPendentes))
                                    {
                                        <LinhaContrato Desembolso="d"
                                                      MostrarAguardando="false"
                                                      MostrarMutuario="ServicoUsuario.EhGigov"
                                                      MostrarResponsavel="!ServicoUsuario.EhGigov"
                                                      Analista="@ObterAnalista(d.Id)"
                                                      Selecionada="@(_idDialogAberto == d.Id)"
                                                      AoClicar="@(() => AbrirDialog(d.Id))"
                                                      AoAtribuir="@((MouseEventArgs e) => { _idAtribuicao = d.Id; _popoverX = e.ClientX; _popoverY = e.ClientY; })" />
                                    }
                                </div>
                                @if (TotalPaginasGrupo(grupoPendentes.Count) > 1)
                                {
                                    <div class="grupo-paginacao">
                                        <button class="grupo-btn-pagina" disabled="@(_paginaPendentes <= 1)" @onclick="() => _paginaPendentes--">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>
                                        <span class="grupo-paginacao-info">Página @_paginaPendentes de @TotalPaginasGrupo(grupoPendentes.Count)</span>
                                        <button class="grupo-btn-pagina" disabled="@(_paginaPendentes >= TotalPaginasGrupo(grupoPendentes.Count))" @onclick="() => _paginaPendentes++">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </section>
                    }


                    @if (grupoSanepar.Any())
                    {
                        <section class="grupo-card">
                            <div class="grupo-card-header @(_grupoSaneparAberto ? "com-borda" : "")">
                                <CabecalhoGrupo Titulo="SANEPAR"
                                                Contagem="@grupoSanepar.Count"
                                                Tipo="agendado"
                                                Aberto="@_grupoSaneparAberto"
                                                AoAlternar="@(v => _grupoSaneparAberto = v)" />
                            </div>
                            <div class="acc-body @(_grupoSaneparAberto ? "aberto" : "")">
                                <div class="acc-inner">
                                    @ColsHeader
                                    @{ _paginaSanepar = PaginaValidaGrupo(_paginaSanepar, grupoSanepar.Count); }
                                    @foreach (var d in Paginar(grupoSanepar, _paginaSanepar))
                                    {
                                        <LinhaContrato Desembolso="d"
                                                      MostrarAguardando="false"
                                                      MostrarMutuario="ServicoUsuario.EhGigov"
                                                      MostrarResponsavel="!ServicoUsuario.EhGigov"
                                                      Analista="@ObterAnalista(d.Id)"
                                                      Selecionada="@(_idDialogAberto == d.Id)"
                                                      AoClicar="@(() => AbrirDialog(d.Id))"
                                                      AoAtribuir="@((MouseEventArgs e) => { _idAtribuicao = d.Id; _popoverX = e.ClientX; _popoverY = e.ClientY; })" />
                                    }
                                </div>
                                @if (TotalPaginasGrupo(grupoSanepar.Count) > 1)
                                {
                                    <div class="grupo-paginacao">
                                        <button class="grupo-btn-pagina" disabled="@(_paginaSanepar <= 1)" @onclick="() => _paginaSanepar--">
                                            <i class="bi bi-chevron-left"></i>
                                        </button>
                                        <span class="grupo-paginacao-info">Página @_paginaSanepar de @TotalPaginasGrupo(grupoSanepar.Count)</span>
                                        <button class="grupo-btn-pagina" disabled="@(_paginaSanepar >= TotalPaginasGrupo(grupoSanepar.Count))" @onclick="() => _paginaSanepar++">
                                            <i class="bi bi-chevron-right"></i>
                                        </button>
                                    </div>
                                }
                            </div>
                        </section>
                    }

                    @if (!grupoPendencias.Any() && !grupoPendentes.Any() && !grupoSanepar.Any())
                    {
                        var buscando = !string.IsNullOrWhiteSpace(_textoBusca);
                        var (emptyIcone, emptyTitulo, emptySub) = buscando
                            ? ("bi-search", $"Nenhum resultado para \"{_textoBusca.Trim()}\"", "Busque por número do contrato, mutuário, GIGOV ou responsável.")
                            : _filtroAtivo switch
                            {
                                "sanepar"   => ("bi-calendar2-x",  "Nenhum desembolso SANEPAR",         "Não há contratos SANEPAR pendentes ou em análise no momento."),
                                "invalidos" => ("bi-x-circle",     "Nenhuma pendência encontrada",      "Não há contratos aguardando validação no momento."),
                                "pendentes" => ("bi-clock",        "Nenhum contrato para analisar",     "Não há contratos aguardando análise no momento."),
                                _           => ("bi-folder2-open", "Nenhum contrato encontrado",        "Tente outro filtro.")
                            };
                        <div class="tabela-vazia">
                            <i class="bi @emptyIcone"></i>
                            <div class="tabela-vazia-titulo">@emptyTitulo</div>
                            <div class="tabela-vazia-sub">@emptySub</div>
                        </div>
                    }

                </div>
            }

        </div>
    </div>

</div>

@if (_idAtribuicao is not null)
{
    <div class="overlay-atrib" @onclick="() => _idAtribuicao = null"></div>
    <div class="popover-atrib" style="left: @(Math.Max(4, _popoverX - 230))px; top: @(_popoverY + 6)px" @onclick:stopPropagation>
        <div class="popover-atrib-titulo">Vincular responsável</div>
        <div class="popover-atrib-lista">
            @foreach (var f in _analistas)
            {
                var ativo = ObterAnalista(_idAtribuicao)?.Matricula == f.Matricula;
                var fLocal = f;
                <button class="popover-atrib-item @(ativo ? "popover-atrib-item-ativo" : "")"
                        @onclick="async () => { await AtribuirAnalista(_idAtribuicao, fLocal); _idAtribuicao = null; }"
                        title="@fLocal.Nome">
                    <span class="popover-atrib-avatar" style="background:@fLocal.Cor">@fLocal.Iniciais</span>
                    <span class="popover-atrib-nome">@fLocal.Nome</span>
                    @if (ativo) { <i class="bi bi-check2 popover-atrib-check"></i> }
                </button>
            }
        </div>
        @if (ObterAnalista(_idAtribuicao) is not null)
        {
            <button class="popover-atrib-remover"
                    @onclick="async () => { await AtribuirAnalista(_idAtribuicao, null); _idAtribuicao = null; }">
                Remover atribuição
            </button>
        }
    </div>
}



@if (_fpdEtapasAberto)
{
    <PainelPreencherFpdEtapas AoVoltar="() => _fpdEtapasAberto = false" AoSolicitar="SolicitarDesembolso" />
}

@if (_dialogSenhaValidarPendentesAberto)
{
    <DialogSenhaBaixa SenhaParaDrp="false"
                      AoCancelar="() => _dialogSenhaValidarPendentesAberto = false"
                      AoConfirmar="ExecutarMacro" />
}

@if (_idDialogAberto is not null)
{
    var desembolsoDialog = _todos.FirstOrDefault(d => d.Id == _idDialogAberto);
    if (desembolsoDialog is not null)
    {
        <DialogDesembolsoFpd Desembolso="@desembolsoDialog"
                        Todos="@buscadosNaoDrp"
                        Analista="@ObterAnalista(_idDialogAberto)"
                        Analistas="@_analistas"
                        AoFechar="@FecharDialog"
                        AoNavegar="@AbrirDialog"
                        AoAtribuir="@(f => AtribuirAnalista(_idDialogAberto, f))" />
    }
}

@code {
    private string  _filtroAtivo           = "geral";
    private string? _idDialogAberto        = null;
    private string? _idAtribuicao          = null;
    private double  _popoverX              = 0;
    private double  _popoverY              = 0;
    private string  _textoBusca            = "";
    private bool    _grupoPendenciasAberto = true;
    private bool    _grupoPendentesAberto  = true;
    private bool    _grupoSaneparAberto = true;
    private bool    _grupoEmAndamentoAberto = true;
    private List<string> _meusGigov          = [];
    private bool    _carregando            = true;
    private bool    _processando           = false;
    private bool    _fpdEtapasAberto       = false;
    private bool    _dialogSenhaValidarPendentesAberto = false;
    private List<DesembolsoCAD> _todos     = [];

    private const int ItensPorPaginaGrupo = 10;
    private int _paginaPendencias = 1;
    private int _paginaPendentes  = 1;
    private int _paginaSanepar    = 1;

    private static List<DesembolsoCAD> Paginar(List<DesembolsoCAD> lista, int pagina) =>
        lista.Skip((pagina - 1) * ItensPorPaginaGrupo).Take(ItensPorPaginaGrupo).ToList();

    private static int TotalPaginasGrupo(int totalItens) =>
        Math.Max(1, (int)Math.Ceiling(totalItens / (double)ItensPorPaginaGrupo));

    private static int PaginaValidaGrupo(int pagina, int totalItens) =>
        Math.Min(pagina, TotalPaginasGrupo(totalItens));

    private void ResetarPaginasGrupos()
    {
        _paginaPendencias = 1;
        _paginaPendentes  = 1;
        _paginaSanepar    = 1;
    }

    private async Task AlternarModoTeste()
    {
        await ServicoUsuario.AlternarModoTesteAsync(JS);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private void SelecionarFiltro(string filtro)
    {
        _filtroAtivo = filtro;
        _fpdEtapasAberto = false;
        ResetarPaginasGrupos();
    }

    private List<Funcionario> _analistas = [];

    private RenderFragment ColsHeader =>
        @<div class="cols-header">
            <span class="col-h" style="width:144px">Contrato</span>
            @if (!ServicoUsuario.EhGigov) { <span class="col-h" style="width:144px">Contrato AO</span> }
            @if (ServicoUsuario.EhGigov) { <span class="col-h" style="width:208px">Mutuário</span> }
            <span class="col-h" style="width:80px;text-align:center">GIGOV</span>
            <span class="col-h" style="width:112px;text-align:right">Valor</span>
            <span class="col-h" style="width:128px;text-align:center">Situação</span>
            <span class="col-h" style="width:132px;text-align:center">Tipo</span>
            <span class="col-h" style="width:80px;text-align:center">Prazo</span>
            @if (!ServicoUsuario.EhGigov) { <span class="col-h" style="width:176px;text-align:center">Responsável</span> }
            <span class="col-h" style="width:20px"></span>
        </div>
    ;

    [SupplyParameterFromQuery(Name = "contratoId")]
    public string? ContratoIdQuery { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Hub.AoReceberProgresso += OnProgresso;

        await ServicoUsuario.CarregarModoTesteAsync(JS);

        if (ServicoUsuario.ModoGigovForcado)
            _meusGigov = [ServicoUsuarioUI.CodigoGigovTeste.ToString()];
        else if (ServicoUsuario.EhGigov)
            _meusGigov = await Service.ObterGigovDoUsuarioAsync(ServicoUsuario.Matricula);

        await CarregarDesembolsosAsync();

        _analistas = await Service.ObterAnalistasAsync("CEFGA06");

        _carregando = false;
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(ContratoIdQuery) && ContratoIdQuery != _idDialogAberto)
            AbrirDialog(ContratoIdQuery);
    }

    private async Task CarregarDesembolsosAsync()
    {
        try
        {
            var todos = await Service.ObterTodosAsync();

            _todos = ServicoUsuario.EhGigov
                ? todos.Where(d => _meusGigov.Contains(d.Gigov)).ToList()
                : todos;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CAD] Falha ao carregar desembolsos: {ex.Message}");
            _todos = [];
        }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("layoutHelper.alterarBackground", "#F4F7FB");
        }

    }
    private void OnProgresso(ObservadorAutomacaoUI obs)
    {
        if (obs.PercentualProcessado >= 100)
        {
            _processando = false;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Hub.AoReceberProgresso -= OnProgresso;
        _ = JS.InvokeVoidAsync("layoutHelper.restaurarBackground");
    }

    private void AbrirDialog(string id)
    {
        _idDialogAberto = id;
        _idAtribuicao   = null;
        Nav.NavigateTo($"/cad?contratoId={id}", replace: true);
    }

    private async Task FecharDialog()
    {
        _idDialogAberto = null;
        Nav.NavigateTo("/cad", replace: true);
        await CarregarDesembolsosAsync();
        StateHasChanged();
    }
    private List<Notificacao> _notificacaoes = [];
    private async Task ConsultarNotificacoesMatricula()
    {
        var matricula = "c151896";
        _notificacaoes = await NotificacaoService.CarregarHistoricoAsync(matricula);

        StateHasChanged();
    }
    private void AbrirValidarPendentes()
    {
        if (_processando) return;
        _dialogSenhaValidarPendentesAberto = true;
    }

    private async Task ExecutarMacro(string senha)
    {
        _dialogSenhaValidarPendentesAberto = false;
        if (_processando) return;
        _processando = true;
        StateHasChanged();
        try
        {
            var qtdAntes = _todos.Count(d => d.Status == "pendencia");
            if (qtdAntes == 0)
            {
                Snackbar.Add("Nenhum desembolso aguardando validação no momento.", Severity.Info);
                return;
            }

            var ok = await Service.ValidarTodosPendentesAsync(ServicoUsuario.Matricula, senha);
            if (!ok)
            {
                Snackbar.Add("Falha ao validar os desembolsos pendentes. Tente novamente.", Severity.Error);
                return;
            }

            await CarregarDesembolsosAsync();
            Snackbar.Add($"{qtdAntes} desembolso(s) validado(s).", Severity.Success);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[CAD] Falha ao validar pendentes em lote: {ex.Message}");
            Snackbar.Add("Falha ao validar os desembolsos pendentes. Tente novamente.", Severity.Error);
        }
        finally
        {
            _processando = false;
            StateHasChanged();
        }
    }

    private async Task SolicitarDesembolso(PreenchimentoFpd fpd)
    {
        _fpdEtapasAberto = false;
        await CarregarDesembolsosAsync();
        StateHasChanged();
    }

    private async Task AtribuirAnalista(string id, Funcionario? funcionario)
    {
        var ok = funcionario is null
            ? await Service.RemoverVinculoAsync(id)
            : await Service.VincularAnalistaAsync(id, funcionario.Matricula);

        if (!ok) return;

        var desembolso = _todos.FirstOrDefault(d => d.Id == id);
        if (desembolso is not null)
            desembolso.ResponsavelAnalise = funcionario?.Matricula;

        StateHasChanged();
    }

    private Funcionario? ObterAnalista(string id)
    {
        var matricula = _todos.FirstOrDefault(d => d.Id == id)?.ResponsavelAnalise;
        return string.IsNullOrEmpty(matricula) ? null : _analistas.FirstOrDefault(f => f.Matricula == matricula);
    }

    private List<DesembolsoCAD> AplicarBusca(List<DesembolsoCAD> lista)
    {
        if (string.IsNullOrWhiteSpace(_textoBusca)) return lista;
        var t = Normalizar(_textoBusca.Trim());
        return lista.Where(d =>
            Normalizar(d.Id).Contains(t)       ||
            Normalizar(d.Contrato).Contains(t) ||
            Normalizar(d.Mutuario).Contains(t) ||
            Normalizar(d.Gigov).Contains(t)    ||
            (ObterAnalista(d.Id) is { } analista && Normalizar(analista.Nome).Contains(t))
        ).ToList();
    }

    private static string Normalizar(string texto)
    {
        var decomposto = texto.Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder(decomposto.Length);
        foreach (var c in decomposto)
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) != System.Globalization.UnicodeCategory.NonSpacingMark)
                sb.Append(c);
        return sb.ToString().ToLowerInvariant();
    }
}



