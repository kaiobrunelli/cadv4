@page "/cad"
@using System.Net.Http.Json

@using ControleAnaliseDesembolso.Componentes
@using ControleAnaliseDesembolso.Modelos
@using ControleAnaliseDesembolso.Service
@using Plataforma.UI.Shared.Model
@inject NavigationManager Nav
@inject NotificacaoServiceUI NotificacaoService
@inject SignalRServiceUI Hub
@inject ServicoUsuarioUI ServicoUsuario
@inject ControleAnaliseDesembolsoService Service
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@implements IDisposable
<PageTitle>Análise de Desembolsos — SIPUB</PageTitle>
<style>
    ﻿
    .mud-container{
        margin:0px;
    }
    .pagina {
        display: flex;
        flex-direction: column;
        min-height: calc(100vh - var(--topbar-h));
        background: #F4F7FB;
    }

    .pagina-header-secao {
        background: #F4F7FB;
        border-bottom: 1px solid #E4EBF0;
    }

    .pagina-header-container {
        max-width: 1200px;
        margin: 0;
        padding: 24px 32px;
    }

    .pagina-titulo {
        font-size: 32px;
        font-weight: 700;
        line-height: 1.05;
        letter-spacing: -.02em;
        color: var(--ink-900);
    }

    .titulo-destaque {
        color: var(--brand-700);
    }

    .titulo-gigov-sufixo {
        font-size: 17px;
        font-weight: 600;
        color: var(--ink-500);
