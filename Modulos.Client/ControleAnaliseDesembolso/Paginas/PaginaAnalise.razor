        flex-shrink: 0;
    }

    .busca-tabela {
        display: flex;
        align-items: center;
        gap: 6px;
        border-radius: var(--radius-lg);
        border: 1px solid var(--ink-100);
        background: #fff;
        padding: 6px 10px;
        box-shadow: var(--shadow-card);
        font-size: 11.5px;
        color: var(--ink-500);
    }

        .busca-tabela i {
            font-size: 11px;
            color: var(--ink-300);
        }

        .busca-tabela input {
            width: 144px;
            background: transparent;
            border: none;
            font-size: 11.5px;
            color: var(--ink-900);
