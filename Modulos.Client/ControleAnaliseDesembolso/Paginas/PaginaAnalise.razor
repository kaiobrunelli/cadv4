    }

    .btn-toggle-modo-teste {
        display: inline-flex; align-items: center; gap: 6px;
        margin-top: 10px;
        padding: 5px 12px;
        border-radius: var(--radius-full);
        border: 1px dashed #E0A711;
        background: #FFFBEB;
        color: #9A5B00;
        font-size: 11.5px;
        font-weight: 600;
        font-family: inherit;
