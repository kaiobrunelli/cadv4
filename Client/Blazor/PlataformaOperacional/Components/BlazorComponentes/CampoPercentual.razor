@inject IJSRuntime JS
@using System.Globalization


<style>
	.cp-container {
		position: relative;
		width: 100%;
		margin-top: 8px;
	}

	.cp-label {
		position: absolute;
		top: -8px;
		left: 10px;
		background: #FAFBFD;
		padding: 0 4px;
		font-size: 0.75rem;
		line-height: 1;
		color: rgba(0, 0, 0, 0.6);
		white-space: nowrap;
		z-index: 1;
	}

	.cp-box {
		display: flex;
		align-items: center;
		box-sizing: border-box;
		height: 44px;
		border: 1px solid rgba(0, 0, 0, 0.38);
		border-radius: 4px;
		padding: 0 14px;
		background: white;
	}

	.cp-box:focus-within {
		border-color: #005ca9;
		border-width: 2px;
		padding: 0 13px;
	}

	.cp-input {
		flex: 1;
		min-width: 0;
		border: none;
		outline: none;
		background: transparent;
		font-size: 1rem;
		font-family: inherit;
		color: rgba(0, 0, 0, 0.87);
	}

	.cp-adornment {
		margin-left: 6px;
		color: rgba(0, 0, 0, 0.54);
		font-size: 0.875rem;
		pointer-events: none;
	}
</style>

<div class="cp-container @Class">
	<span class="cp-label">@Label</span>
	<div class="cp-box">
		<input class="cp-input"
			   id="@_inputId"
			   type="text"
			   inputmode="numeric"
			   autocomplete="off"
			   placeholder="0,0000"
			   @ref="_ref"
			   value="@_texto"
			   @onfocus="AoFocar"
			   @oninput="AoDigitar" />
		<span class="cp-adornment">%</span>
	</div>
</div>

@code {
	[Parameter] public decimal Value { get; set; }
	[Parameter] public EventCallback<(decimal Valor, int CasasDecimais)> ValueChanged { get; set; }
	[Parameter] public string Label { get; set; } = "";
	[Parameter] public decimal Max { get; set; } = 100m;
	[Parameter] public string? Class { get; set; }

	[Parameter] public int CasasDecimais { get; set; } = 4;

	private static readonly CultureInfo _br = new("pt-BR");
	private readonly string _inputId = $"campo-percentual-{Guid.NewGuid():N}";

	private ElementReference _ref;
	private string _texto = "";
	private decimal _ultimoValor = -1m;

	protected override void OnParametersSet()
	{
		if (Value != _ultimoValor)
		{
			_ultimoValor = Value;
			_texto = Value == 0 ? "" : Value.ToString("N" + CasasDecimais, _br);
		}
	}

	private async Task AoFocar()
	{
		await JS.InvokeVoidAsync("inputHelper.selecionarTextoAtivo");
	}

	private async Task AoDigitar(ChangeEventArgs e)
	{
		var digitos = new string((e.Value?.ToString() ?? "").Where(char.IsDigit).ToArray());
		if (digitos.Length > 6) digitos = digitos[..6];

		string texto;
		decimal valor;
		int casasDecimais;

		if (digitos == "100")
		{
			texto = "100";
			valor = 100m;
			casasDecimais = 0;
		}
		else if (digitos.Length <= 2)
		{
			texto = digitos;
			valor = digitos.Length == 0 ? 0m : decimal.Parse(digitos);
			casasDecimais = 0;
		}
		else
		{
			var parteInteira = digitos[..2].TrimStart('0');
			if (parteInteira.Length == 0) parteInteira = "0";
			var parteDecimal = digitos[2..];
			texto = $"{parteInteira},{parteDecimal}";
			valor = decimal.Parse(digitos[..2]) + (decimal.Parse(parteDecimal) / (decimal)Math.Pow(10, parteDecimal.Length));
			casasDecimais = parteDecimal.Length;
		}

		if (valor > Max) { valor = Max; texto = Max.ToString("N" + casasDecimais, _br); }

		_ultimoValor = valor;
		_texto = texto;
		Value = valor;

		await JS.InvokeVoidAsync("inputHelper.definirValorInput", _ref, _texto);
		await ValueChanged.InvokeAsync((valor, casasDecimais));
	}
}
