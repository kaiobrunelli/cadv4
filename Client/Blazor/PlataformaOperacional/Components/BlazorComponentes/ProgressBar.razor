
@inject SignalRService SignalRService


<style>

	.mud-alert {
		border: 1px solid var(--mud-palette-lines-default) !important;
	}

	.mud-alert-message {
		padding-top: 0px;
		padding-bottom: 0px;
	}

	.mud-progress-linear.mud-progress-linear-gradient {
		border-radius: 8px;
		background-color: var(--mud-palette-background-grey);
	}

		.mud-progress-linear.mud-progress-linear-gradient .mud-progress-linear-track {
			border-radius: 8px;
			background: transparent !important;
		}

		.mud-progress-linear.mud-progress-linear-gradient .mud-progress-linear-bar {
			background: linear-gradient(90deg, #12CA8D 15%, #1074C8 90%) !important;
			border-radius: 8px;
			transition: transform 0.4s ease-out;
		}
</style>

<MudStack Row="false" Style="width: 100%;">

	<MudStack Row="false" Style="width: 100%;" Spacing="0">
		@if (ProgressoIniciado)
		{
			<MudAlert Severity="_observerAutomacao.AlertaSeverity" Class="pa-2" NoIcon="true" Style="width: 100%; border-radius:8px;">


				@if (_observerAutomacao.AlertaSeverity == Severity.Error || _observerAutomacao.AlertaSeverity == Severity.Warning)
				{
					<MudStack Row="false" Justify="Justify.SpaceBetween" Spacing="0" AlignItems="AlignItems.Center">
						<MudText Typo="Typo.body1" Class="mb-1"><b>@_observerAutomacao.NomeProcesso</b></MudText>
						<MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Spacing="2">
							<MudIcon Icon="@Icons.Material.Filled.Error" Size="Size.Small" Color="@(_observerAutomacao.AlertaSeverity == Severity.Error ? Color.Error : Color.Warning)" />
							<MudText Typo="Typo.body2" Align="Align.Center" Color="@(_observerAutomacao.AlertaSeverity == Severity.Error ? Color.Error : Color.Warning)">
								@_observerAutomacao.Mensagem
							</MudText>
						</MudStack>
					</MudStack>
				}
				else if (MostrarBarraProgresso && _observerAutomacao.PercentualProcessado < 100)
				{
					<MudStack Row="false" Justify="Justify.Center" Spacing="0" AlignItems="AlignItems.Center">
						<MudText Typo="Typo.body1" Class="mb-1"><b>@_observerAutomacao.NomeProcesso</b></MudText>
						<MudProgressLinear Color="Color.Info"
										   Size="Size.Large"
										   Rounded="true"
										   Value="@_observerAutomacao.PercentualProcessado"
										   Class="mud-progress-linear-gradient " />

						<MudStack Row="true" Justify="Justify.SpaceBetween" Spacing="2" AlignItems="AlignItems.Center" Class="mt-2">
							<MudText Typo="Typo.body2">
								<b>@_observerAutomacao.PercentualProcessado %</b>
							</MudText>
							<MudText Typo="Typo.caption">
								Processados: @_observerAutomacao.TotalProcessado | A Processar: @_observerAutomacao.TotalAProcessar
							</MudText>
						</MudStack>

					</MudStack>
				}
				else if (ProgressoConcluido && _observerAutomacao.PercentualProcessado == 100)
				{
					<MudStack Row="false" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="0">
						<MudText Typo="Typo.body1" Class="mb-1"><b>@_observerAutomacao.NomeProcesso</b></MudText>
						<MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Spacing="2">
							@if (_observerAutomacao.PercentualProcessado == 100)
							{
								<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
							}
							<MudText Typo="Typo.caption" Class="mt-1">@_observerAutomacao.Mensagem</MudText>
						</MudStack>
					</MudStack>
				}

			</MudAlert>
		}
		<MudStack Row="true" Justify="Justify.FlexEnd" AlignItems="AlignItems.Center" Class="mt-3 md-2">
			<MudText Typo="Typo.body2" Style="color:#64748B">
				@FaseAtual
			</MudText>
		</MudStack>

		@if (Debug)
		{
			<MudStack Row="false" Spacing="4" Class="mt-4">
				<MudText Typo="Typo.body2"> ProgressoIniciado : @ProgressoIniciado</MudText>
				<MudText Typo="Typo.body2"> _observerAutomacao.AlertaSeverity : @_observerAutomacao.AlertaSeverity</MudText>
				<MudText Typo="Typo.body2"> TotalAProcessar : @_observerAutomacao.TotalAProcessar</MudText>
				<MudText Typo="Typo.body2"> TotalProcessado : @_observerAutomacao.TotalProcessado</MudText>
				<MudText Typo="Typo.body2"> TotalProcessado : @_observerAutomacao.Mensagem</MudText>
				<MudText Typo="Typo.body2"> MostrarBarraProgresso : @MostrarBarraProgresso</MudText>
				<MudText Typo="Typo.body2"> _observerAutomacao.PercentualProcessado : @_observerAutomacao.PercentualProcessado</MudText>
			</MudStack>
		}

	</MudStack>
</MudStack>





@code {
	[Parameter] public string HubConnectId { get; set; } = string.Empty;
	[Parameter] public string FaseAtual { get; set; } = "";
	[Parameter] public EventCallback AtualizarEstado { get; set; }
	[Parameter] public EventCallback SenhaInvalidaEvent { get; set; }



	[Parameter] public bool Debug  { get; set; } = false;
	private int ProgressValue { get; set; } = 0;
	public string ProgressMessage { get; set; } = "Aguardando...";
	private bool _isSubscribed = false;
	[Parameter] public Severity SeverityColor { get; set; }


	private bool MostrarBarraProgresso { get; set; } = false;
	private bool ProgressoIniciado { get; set; } = false;
	private bool ProgressoConcluido { get; set; } = false;
	private ObservadorAutomacao _observerAutomacao = new();
	private bool _primeiroAcionamento = false;
	[Parameter] public bool BotaoClicado { get; set; } = false;

	protected override void OnInitialized()
	{
		if (!string.IsNullOrEmpty(HubConnectId))
		{
			SignalRService.RegistrarObserver(HubConnectId, HandleProgressUpdate);
		}
	}
	protected override async Task OnParametersSetAsync()
	{
		if (!string.IsNullOrEmpty(HubConnectId))
		{
			await SignalRService.IniciarEscutaDaOperacao(HubConnectId);
		}
	}
	protected override async Task OnInitializedAsync()
	{
		if (!string.IsNullOrEmpty(HubConnectId))
		{
			var observarAtualizado = await SignalRService.ObterEstadoAtual(HubConnectId);
			if (observarAtualizado != null)
			{
				_observerAutomacao = observarAtualizado;

				if(_observerAutomacao.PercentualProcessado > 0 && _observerAutomacao.TotalProcessado < 100)
				{
					ProgressoIniciado = true;
					MostrarBarraProgresso = true;
					await InvokeAsync(StateHasChanged);
				}
			}
		}
	}


	private void HandleObserver(ObservadorAutomacao observer)
	{
		_observerAutomacao = observer;
		StateHasChanged();
	}


	public async Task ExibirProgressBar()
	{
		MostrarBarraProgresso = true;
		if (string.IsNullOrEmpty(_observerAutomacao.Severity))
		{
			_observerAutomacao.Severity = "Info";
		}
		ProgressoIniciado = true;
		await InvokeAsync(StateHasChanged);
	}
	public async Task ForcarAtualizacao()
	{
		await SignalRService.IniciarEscutaDaOperacao(HubConnectId);
		ProgressoIniciado = false;
		await InvokeAsync(StateHasChanged);
	}
	private async Task HandleProgressUpdatex(ObservadorAutomacao observer)
	{
		
		if (!observer.ChaveConexao.Equals(HubConnectId, StringComparison.OrdinalIgnoreCase))
			return;

		_observerAutomacao = observer;
		ProgressoIniciado = true;

		await InvokeAsync(StateHasChanged);

		if (_observerAutomacao.PercentualProcessado > 100)
		{
			Console.WriteLine("Cheguei no > 100");

			if (AtualizarEstado.HasDelegate)
			{
				await AtualizarEstado.InvokeAsync();
			}

			ProgressoConcluido = true;
			await AtualizarEstado.InvokeAsync();
			await InvokeAsync(StateHasChanged);
			


			return;
		}
		else if (_observerAutomacao.AlertaSeverity == Severity.Error)
		{
			if (AtualizarEstado.HasDelegate)
			{
				await AtualizarEstado.InvokeAsync();
			}
			if (SenhaInvalidaEvent.HasDelegate && _observerAutomacao.Mensagem == "Senha Inválida.")
			{
				await SenhaInvalidaEvent.InvokeAsync();
			}

			MostrarBarraProgresso = false;
			await Task.Delay(5000);
			await AtualizarEstado.InvokeAsync();
			await InvokeAsync(StateHasChanged);
		}
	}

	public void Dispose()
	{

		if (!string.IsNullOrEmpty(HubConnectId))
		{
			SignalRService.RemoverObserver(HubConnectId, HandleProgressUpdate);
		}
	}

	private async Task HandleProgressUpdate(ObservadorAutomacao observer)
	{

		if (observer.ChaveConexao.Equals(HubConnectId, StringComparison.OrdinalIgnoreCase))
		{
			_observerAutomacao = observer;

			await InvokeAsync(StateHasChanged);
			if (observer.PercentualProcessado == 100)
			{

				ProgressoConcluido = true;
				await AtualizarEstado.InvokeAsync();
				 _ = Task.Run(async () =>
				 {
				 	await Task.Delay(5000);
				 	ProgressoIniciado = false;
				 	ProgressoConcluido = false;
				 	MostrarBarraProgresso = false;
				 });
				await InvokeAsync(StateHasChanged);
				return;
			}

			if (_observerAutomacao.AlertaSeverity == Severity.Error)
			{
				MostrarBarraProgresso = false;
				await AtualizarEstado.InvokeAsync();
				await InvokeAsync(StateHasChanged);
				await Task.Delay(6000);
			}




		}
	}

}


