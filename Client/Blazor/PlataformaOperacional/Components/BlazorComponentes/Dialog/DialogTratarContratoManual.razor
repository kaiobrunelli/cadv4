
<MudDialog Class="blur dialog-background"
		   TitleClass="dialog-background-title"
		   ContentClass="dialog-background-surface py-10 mt-0 mb-0 rounded-0"
		   ActionsClass="dialog-background-surface"
		   Style="min-width:400px">
	<TitleContent>
		<MudElement HtmlTag="div" Class="d-flex">
			<MudIcon Icon="@Icons.Material.Filled.Chat" Class="mr-2" />
			<MudText Style="font-size: 125%">
				Tratativa manual:
			</MudText>
		</MudElement>
	</TitleContent>
	<DialogContent>
		<MudForm @bind-IsValid="FormularioValido">
			<MudTextField Lines="3"
						  Variant="Variant.Outlined"
						  Immediate
						  Required
						  RequiredError="Campo de preenchimento obrigatório."
						  Adornment="Adornment.End" @bind-Value="DescricacaoTratativa"></MudTextField>
		</MudForm>
	</DialogContent>
	<DialogActions>
		<MudButton Variant="Variant.Outlined"
				   Color="Color.Error"
				   OnClick="Cancel"
				   Style="min-width:100px">
			<MudText>Cancelar</MudText>
		</MudButton>
		<MudButton Variant="Variant.Filled"
				   Disabled="!FormularioValido"
				   Color="Color.Secondary"
				   OnClick="Submit"
				   Style="min-width:100px">
			<MudText>Tratar</MudText>
		</MudButton>
	</DialogActions>
</MudDialog>

<style>
	.blur {
		backdrop-filter: blur(10px);
	}

	.dialog-background {
		background-color: transparent;
	}

	.dialog-background-title {
		background: var(--mud-palette-secondary);
		color: var(--mud-palette-white);
	}

	.dialog-background-surface {
		background: var(--mud-palette-surface);
	}
</style>

@code
{
	[CascadingParameter] private IMudDialogInstance? MudDialog { get; set; } = default!;

	private bool FormularioValido;
	private string DescricacaoTratativa { get; set; } = string.Empty;

	private void Submit() => MudDialog?.Close(DialogResult.Ok(DescricacaoTratativa));
	private void Cancel() => MudDialog?.Cancel();
}










