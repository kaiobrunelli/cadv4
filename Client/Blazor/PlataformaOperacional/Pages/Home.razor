@page "/"
@using PlataformaOperacional.Pages.Contabilidade



<style>
	.rounded-button-home {
		display: flex;
		align-items: center;
		justify-content: center;
		background-color: #E7F0F9;
		border-radius: 50%;
		width: 40px;
		height: 40px;
		box-shadow: 0 2px 3px rgba(0, 0, 0, 0.1);
		transition: background-color 0.3s ease;
	}
</style>


<PageTitle>Plataforma Operacional</PageTitle>
<MudContainer>
	<MudGrid>
		<MudItem xs="12" Class="titulo-page">
			<MudCard Elevation="0" Class="d-flex flex-row gap-2">
				<MudText Typo="Typo.h3" Style="color:#005ca9;">Plataforma Operacional</MudText>
				<MudText Typo="Typo.h3">CEFGA</MudText>
			</MudCard>
			<MudDivider Class="mt-2 flex-grow-1" DividerType="DividerType.FullWidth"></MudDivider>
		</MudItem>
