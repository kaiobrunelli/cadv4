				</MudItem>
				<MudItem Class="d-flex  flex-row justify-end gap-2">
					<MudText Style="color:dimgrey" Typo="Typo.body2"><b>R$ 8,00 Bi </b></MudText>
					<MudText Style="color:dimgrey" Typo="Typo.caption">Orçamento</MudText>
				</MudItem>
			</MudItem>


			<MudItem Class="card-home-page px-4 py-2 " md="3" lg="3">
				<MudItem Class="card-border-left"></MudItem>
				<MudItem Class="d-flex flex-row justify-space-between mb-1 ">
					<MudText Class="ml-4 align-self-center" Typo="Typo.h6">Saneamento</MudText>
					<div class="rounded-button-home">
						<MudIcon Icon="@Icons.Material.Filled.WaterDrop" Style="color:#005ca9" Size="Size.Small" />
					</div>
				</MudItem>
				<MudItem Class=" d-flex flex-column align-end  justify-end flex-column align-end flex-wrap mb-2">
					<MudText Style="color:#005CA9" Typo="Typo.h5">R$ 3,64 Bi</MudText>
					<MudText Style="color:dimgrey" Typo="Typo.caption">Contratado</MudText>
				</MudItem>
				<MudItem Class="d-flex  flex-row align-end justify-end gap-2">
					<MudText Style="color:green" Typo="Typo.caption">66%</MudText>
					<MudText Style="color:dimgrey" Typo="Typo.caption">Percentual Contratado</MudText>
				</MudItem>
				<MudItem Class="d-flex  flex-row justify-end gap-2">
					<MudText Style="color:dimgrey" Typo="Typo.body2"><b>R$ 8,00 Bi </b></MudText>
					<MudText Style="color:dimgrey" Typo="Typo.caption">Orçamento</MudText>
				</MudItem>
			</MudItem>
		</MudItem>
		<MudItem lg="12" md="12" Class="d-flex justify-start">
			<MudText Style="color:grey" Typo="Typo.body2"> Dados processados em 17/12/2025. Posição dos dados em 16/12/2025.</MudText>
		</MudItem>
	</MudGrid>
</MudContainer>

