@page "/jornada2"
@layout EmptyLayout

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />

<style>



    *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    .wf-body {
        background-color: var(--bg-dark);
        color: var(--text-primary);
        font-family: 'Inter', sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        -webkit-font-smoothing: antialiased;
        overscroll-behavior-y: none;
    }

    .wf-header {
        position: sticky;
        top: 0;
        z-index: 50;
        background-color: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(12px);
        border-bottom: 1px solid var(--border-subtle);
        padding: 1rem 3rem;
    }

    .wf-header-inner {
        max-width: 72rem;
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .wf-logo-wrap {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .wf-logo-icon {
        width: 2.25rem;
        height: 2.25rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background-color: var(--brand-primary);
        color: white;
        box-shadow: var(--blue-glow);
    }

    .wf-logo-title {
        color: var(--text-primary);
        font-size: 1.125rem;
        font-weight: 700;
        letter-spacing: -0.025em;
    }

    .wf-nav {
        display: flex;
        align-items: center;
        gap: 2rem;
        background-color: transparent;
    }

        .wf-nav a {
            color: var(--text-secondary);
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            background: none !important;
            transition: color 0.2s;
        }

            .wf-nav a:hover {
                color: var(--brand-primary);
            }

    .wf-header-right {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .wf-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 9999px;
        background-color: var(--accent-blue-light);
        padding: 0.25rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--brand-primary);
        border: 1px solid var(--accent-blue-border);
    }

    .wf-avatar {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 9999px;
        border: 1px solid var(--border-subtle);
        overflow: hidden;
        background-color: var(--neutral-gray-200);
        padding: 2px;
    }

        .wf-avatar img {
            width: 100%;
            height: 100%;
            border-radius: 9999px;
            object-fit: cover;
        }

    .wf-main {
        max-width: 56rem;
        margin: 0 auto;
        width: 100%;
        padding: 4rem 1.5rem;
        flex: 1;
    }

    .wf-hero {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 2rem;
        margin-bottom: 4rem;
    }

    .wf-hero-text {
        max-width: 42rem;
    }

    .wf-hero h1 {
        color: var(--text-primary);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        letter-spacing: -0.025em;
        margin-bottom: 1rem;
        line-height: 1.1;
    }

        .wf-hero h1 span {
            color: var(--brand-primary);
        }

    .wf-hero p {
        color: var(--text-secondary);
        font-size: 1.125rem;
        line-height: 1.75;
    }

    .wf-steps {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .wf-step {
        position: relative;
        padding-left: 4rem;
    }

        .wf-step:not(.wf-step--last)::before {
            content: '';
            position: absolute;
            left: 23px;
            top: 48px;
            bottom: -24px;
            width: 2px;
            background-color: var(--neutral-gray-300);
            z-index: 0;
        }

    .wf-step--completed:not(.wf-step--last)::before {
        background-color: var(--brand-secondary);
    }

    .wf-step-icon {
        position: absolute;
        left: 0;
        top: 0;
        z-index: 10;
        width: 3rem;
        height: 3rem;
        border-radius: 9999px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .wf-step-icon--done {
        background-color: var(--brand-secondary);
        color: white;
        box-shadow: 0 0 15px rgba(0, 86, 179, 0.2);
    }

    .wf-step-icon--active {
        background-color: var(--brand-primary);
        color: white;
        box-shadow: var(--blue-glow);
        outline: 4px solid var(--bg-dark);
    }

    .wf-step-icon--locked {
        background-color: var(--neutral-gray-200);
        color: var(--neutral-gray-400);
        border: 2px solid var(--neutral-gray-300);
    }

    .wf-card {
        background-color: var(--card-dark);
        border-radius: 16px;
        padding: 1.5rem;
        transition: all 0.2s;
        box-shadow: var(--shadow-soft);
        border: 1px solid var(--border-subtle);
    }

    .wf-card--done {
        border-color: rgba(0, 86, 179, 0.2);
    }

    .wf-card--active {
        border: 2px solid var(--brand-primary);
        box-shadow: var(--blue-glow);
    }

    .wf-card--locked {
        border: 1px dashed var(--neutral-gray-300);
        opacity: 0.7;
        background-color: var(--neutral-gray-100);
        box-shadow: none;
    }

    .wf-card-inner {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
    }

    .wf-card-header-text {
        font-size: 18px !important;
    }

    .wf-card-meta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.25rem;
        flex-wrap: wrap;
        flex: 1;
    }

    .wf-phase-label {
        font-size: 0.625rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.2em;
    }

    .wf-phase-label--done {
        color: var(--brand-secondary);
    }

    .wf-phase-label--active {
        color: var(--brand-primary);
    }

    .wf-phase-label--locked {
        color: var(--neutral-gray-400);
    }

    .wf-status {
        font-size: 0.75rem;
        font-weight: 500;
    }

    .wf-status--done {
        color: var(--brand-secondary);
    }

    .wf-status--active {
        color: var(--brand-primary);
        font-weight: 700;
    }

    .wf-status--locked {
        color: var(--neutral-gray-400);
        font-style: italic;
    }

    .wf-date {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-secondary);
        margin-left: auto;
    }

    .wf-date--active {
        color: var(--brand-primary);
    }

    .wf-step-dot {
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .wf-dot {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 9999px;
        background-color: var(--brand-primary);
    }

    .wf-card h3 {
        font-weight: 700;
        color: var(--text-primary);
        font-size: 1.125rem;
    }

        .wf-card h3.wf-card-title--active {
            font-size: 1.25rem;
            font-weight: 800;
        }

        .wf-card h3.wf-card-title--locked {
            color: var(--neutral-gray-400);
        }

    .wf-card-desc {
        color: var(--text-secondary);
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .wf-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: 1rem;
    }

    .wf-tags--active {
        gap: 0.75rem;
        margin-top: 1.5rem;
    }

    .wf-tag {
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        background-color: var(--neutral-gray-100);
        border: 1px solid var(--border-subtle);
        font-size: 0.95rem;
        color: var(--text-secondary);
    }

    .wf-tag--highlight {
        padding: 0.375rem 0.75rem;
        border-radius: 8px;
        background-color: var(--brand-primary);
        color: white;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .wf-tag--outline-blue {
        padding: 0.375rem 0.75rem;
        border-radius: 8px;
        background-color: white;
        border: 1px solid var(--accent-blue-border);
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--brand-primary);
    }

    .wf-tag--locked {
        padding: 0.25rem 0.75rem;
        border-radius: 6px;
        background-color: var(--neutral-gray-100);
        border: 1px solid var(--neutral-gray-200);
        font-size: 0.75rem;
        color: var(--neutral-gray-400);
    }

    .wf-card-icon {
        font-size: 1.5rem;
        flex-shrink: 0;
        margin-left: 1rem;
    }

    .wf-card-icon--done {
        color: var(--brand-secondary);
        opacity: 0.6;
    }

    .wf-card-icon--active {
        color: var(--brand-primary);
        font-size: 1.875rem;
    }

    .wf-card-icon--locked {
        color: var(--neutral-gray-300);
    }

    .titulo-etapa {
        margin-top: 0.75rem;
    }

    .wf-stack-section {
        margin-top: 6rem;
        padding-top: 3rem;
        border-top: 1px solid var(--border-subtle);
    }

    .wf-stack-inner {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .wf-stack-label {
        font-size: 0.625rem;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: var(--text-secondary);
        margin-bottom: 1rem;
    }

    .wf-stack-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
    }

    .wf-tech-tag {
        display: flex;
        align-items: center;
        gap: 0.625rem;
        background-color: var(--card-dark);
        padding: 0.625rem 1rem;
        border-radius: 12px;
        border: 1px solid var(--border-subtle);
        box-shadow: var(--shadow-soft);
    }

    .wf-tech-tag--green {
        border-color: var(--brand-secondary);
    }

    .wf-tech-tag--blue {
        border-color: var(--brand-primary);
    }

    .wf-tech-dot {
        width: 0.625rem;
        height: 0.625rem;
        border-radius: 9999px;
    }

    .wf-tech-name {
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-primary);
    }

    .wf-footer {
        background-color: var(--card-dark);
        border-top: 1px solid var(--border-subtle);
        padding: 2rem 1.5rem;
        margin-top: 3rem;
    }

    .wf-footer-inner {
        max-width: 72rem;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5rem;
    }

    .wf-footer p {
        font-size: 0.75rem;
        color: var(--text-secondary);
        font-weight: 600;
    }
</style>

<div class="wf-body">

    <header class="wf-header">
        <div class="wf-header-inner">
