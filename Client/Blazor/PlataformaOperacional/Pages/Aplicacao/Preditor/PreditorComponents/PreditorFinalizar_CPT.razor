<MudPaper Class="rounded-custom border border-solid mud-border-lines-default pa-4 relative overflow-hidden" Elevation="0">
	<div class="absolute top-0 right-0 w-64 h-full bg-gradient-custom pointer-events-none" style="position: absolute; top:0; right:0; width: 300px; height: 100%;"></div>

	<div class="d-flex flex-column flex-sm-row justify-space-between align-center gap-4 relative z-10" style="position: relative; z-index: 10;">

		<div class="d-flex flex-column align-start">
			<MudText Typo="Typo.caption" Class="font-weight-bold mb-1 text-uppercase" Color="Color.Default" Style="letter-spacing: 0.05em;">
				<b>Status Desembolso</b>
			</MudText>

			<div class="d-flex align-center gap-2">
			<MudChip T="string" Size="Size.Medium" Variant="Variant.Outlined" Class="font-bold" Color="@StatusGeralCorTexto">
				@StatusTexto
				</MudChip> 
			</div>
		</div>

		<MudButton Variant="Variant.Filled"
				   Color="Color.Primary"
				   Size="Size.Medium"
				   StartIcon="@Icons.Material.Filled.CheckCircle"
				   OnClick="Finalizar"
				   Class="px-8 py-3 font-bold rounded-lg">
			Finalizar Desembolso
		</MudButton>
	</div>
</MudPaper>
@code {
	[Parameter] public EventCallback OnClickFinalizar { get; set; }
	[Parameter] public string StatusTexto { get; set; } = "";
	private Color StatusGeralCorTexto => StatusTexto=="Não iniciado" ? Color.Warning : Color.Success;
	private string CorIcone => StatusTexto == "Não iniciado" ? "F39200" : "00c5a9";
	private void Finalizar()
	{
		OnClickFinalizar.InvokeAsync();
	}
}
