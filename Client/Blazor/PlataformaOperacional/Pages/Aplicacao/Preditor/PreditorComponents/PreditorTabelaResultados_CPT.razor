@using System.Linq
@using System.Globalization
@using PlataformaOperacional.Model.AplicacaoModel.Preditor

<style>
    .tr3 *, .tr3 *::before, .tr3 *::after {
        box-sizing: border-box;
    }

    .tr3 {
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 14px;
        color: #374151;
    }

    .tr3-wrap {
        max-width: 1200px;
        margin: 0 auto;
    }

    .tr3-page-header {
        margin-bottom: 8px;
    }

    .tr3-page-title {
        margin: 0 0 4px;
        font-size: 22px;
        font-weight: 500;
    }

    .tr3-page-sub {
        margin: 0;
        color: #005ca9;
        font-size: 16px;
    }

    .tr3-card {
        background: #fff;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        box-shadow: 0 1px 4px rgba(0,0,0,.06);
        overflow: hidden;
    }

    .tr3-toolbar {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid #f3f4f6;
        flex-wrap: wrap;
    }

    .tr3-select {
        height: 36px;
        padding: 0 10px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #fff;
        font-size: 13px;
        color: #374151;
        cursor: pointer;
        outline: none;
        transition: border-color .15s;
    }

        .tr3-select:focus {
            border-color: #005ca9;
        }

    .tr3-date-input {
        height: 36px;
        padding: 0 10px;
        border: 1px solid #d1d5db;
        border-radius: 8px;
        background: #fff;
        font-size: 13px;
        color: #374151;
        outline: none;
        transition: border-color .15s;
        width: 148px;
        text-align: center;
    }

        .tr3-date-input:focus {
            border-color: #005ca9;
        }

    .tr3-period-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tr3-period-label {
        font-size: 12px;
        color: #9ca3af;
        white-space: nowrap;
    }

    .tr3-divider {
        width: 1px;
        height: 22px;
        background: #e5e7eb;
        flex-shrink: 0;
    }

    .tr3-btn {
        height: 36px;
        padding: 0 16px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: background .15s;
        white-space: nowrap;
    }

    .tr3-btn--primary {
        background: #005ca9;
        color: #fff;
    }

        .tr3-btn--primary:hover {
            background-color: #0074d4;
        }

    .tr3-scroll {
        overflow-x: auto;
    }

    .tr3-table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

        .tr3-table thead tr {
            background: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
        }

        .tr3-table th {
            padding: 10px 16px;
            font-size: 12px;
            font-weight: 600;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

            .tr3-table th.align-c,
            .tr3-table td.align-c {
                text-align: center;
            }

        .tr3-table tbody tr {
            border-bottom: 1px solid #f3f4f6;
            transition: background .1s;
        }

            .tr3-table tbody tr:hover {
                background: #f9fafb;
            }

            .tr3-table tbody tr.tr3-group-top td {
                border-top: 2px solid #e5e7eb;
            }

            .tr3-table tbody tr.tr3-total-row {
                background: #f0f4ff;
                font-weight: 600;
            }

        .tr3-table td {
            padding: 10px 16px;
            font-size: 13.5px;
            color: #374151;
            text-align: center;
        }

    .tr3-sort-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: none;
        border: none;
        padding: 0;
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
        text-transform: uppercase;
        letter-spacing: .5px;
        cursor: pointer;
    }

        .tr3-sort-btn.active {
            color: #005ca9;
        }

    .tr3-sort-arrow {
        font-size: 11px;
    }

    .tr3-date-cell {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .tr3-cal-icon {
        width: 28px;
        height: 28px;
        border-radius: 6px;
        background: #dbeafe;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .tr3-cal-icon svg {
            width: 14px;
            height: 14px;
            stroke: #1d4ed8;
        }

    .tr3-date-text {
        font-size: 13px;
        font-weight: 500;
        color: #374151;
    }

    .tr3-badge {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 11.5px;
        font-weight: 600;
    }

    .tr3-badge--hab {
        background: #d1fae5;
        color: #065f46;
    }

    .tr3-badge--infra {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .tr3-badge--total {
        color: #374151;
        font-size:13px;
    }

    .tr3-result {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .tr3-result-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .tr3-result--green, .tr3-result--red {
        background: #dcfce7 !important;
        color: #15803d !important;
    }

        .tr3-result--green .tr3-result-dot,
        .tr3-result--red .tr3-result-dot {
            background: #16a34a !important;
        }

    .tr3-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        background-color: #f7f8fa;
        padding: 12px 16px;
        border-top: 1px solid #f3f4f6;
    }

    .tr3-pager {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .tr3-pg-btn {
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        background: #fff;
        font-size: 13px;
        color: #374151;
        cursor: pointer;
        transition: all .15s;
    }

        .tr3-pg-btn.active {
            background: #005ca9;
            color: #fff;
            font-weight: 600;
        }

        .tr3-pg-btn:disabled {
            opacity: .35;
            cursor: default;
        }
</style>

<div class="tr3">
    <div class="tr3-wrap">
        <div class="tr3-page-header">
            <h1 class="tr3-page-title" style="color:#424242; letter-spacing:1px;">Relatório de Resultados</h1>
            <p class="tr3-page-sub">Acompanhe os resultados calculados, previstos e realizados.</p>
        </div>

        <div class="tr3-card">
            <div class="tr3-toolbar">
                <div class="tr3-period-wrap">
                    <span class="tr3-period-label">De</span>
                    <input class="tr3-date-input" type="date"
                           @bind="_dataInicioPendente"  />
                    <span class="tr3-period-label">até</span>
                    <input class="tr3-date-input" type="date"
                           @bind="_dataFimPendente" />
                </div>
            
                <button class="tr3-btn tr3-btn--primary" @onclick="Buscar">Buscar</button>

                <div class="tr3-divider"></div>

                <select class="tr3-select" @bind="_filtroSetor">
                    <option value="">Todos os setores</option>
                    <option value="Sane/Infra">Sane/Infra</option>
                    <option value="Habitação">Habitação</option>
                    <option value="Total">Total</option>
                </select>

                <div class="tr3-divider"></div>

                <select class="tr3-select" @bind="_datasPorPaginaStr">
                    <option value="1">1 data / pág.</option>
                    <option value="5">5 datas / pág.</option>
                </select>
            </div>

            <div class="tr3-scroll">
                <table class="tr3-table">
                    <thead>
                        <tr>
                            <th style="text-align:center;">
                                <button class="tr3-sort-btn @ActiveClass("Data")" @onclick='() => OrdenarPor("Data")'>
                                    Data <span class="tr3-sort-arrow">@SortIcon("Data")</span>
                                </button>
                            </th>
                            <th style="text-align:center;">Setor</th>
                            <th class="align-c">
                                <button class="tr3-sort-btn @ActiveClass("CalculadoInicial")" @onclick='() => OrdenarPor("CalculadoInicial")'>
                                    Calc. Inicial <span class="tr3-sort-arrow">@SortIcon("CalculadoInicial")</span>
                                </button>
                            </th>
                            <th class="align-c">
                                <button class="tr3-sort-btn @ActiveClass("TotalPrevisto")" @onclick='() => OrdenarPor("TotalPrevisto")'>
                                    Total Previsto <span class="tr3-sort-arrow">@SortIcon("TotalPrevisto")</span>
                                </button>
                            </th>
                            <th class="align-c">
                                <button class="tr3-sort-btn @ActiveClass("TotalRealizado")" @onclick='() => OrdenarPor("TotalRealizado")'>
                                    Total Realizado <span class="tr3-sort-arrow">@SortIcon("TotalRealizado")</span>
                                </button>
                            </th>
                            <th class="align-c">
                                <button class="tr3-sort-btn @ActiveClass("Resultado")" @onclick='() => OrdenarPor("Resultado")'>
                                    Resultado <span class="tr3-sort-arrow">@SortIcon("Resultado")</span>
                                </button>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!GruposParaExibir.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <div style="text-align:center; padding:40px; color:#9ca3af;">Nenhum resultado encontrado.</div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var grupo in GruposParaExibir)
                            {
                                @foreach (var row in grupo.Linhas)
                                {
                                    <tr class="@row.TrClass">
                                        <td>
                                            @if (row.ExibirData)
                                            {
                                                <div class="tr3-date-cell">
                                                    <div class="tr3-cal-icon">
                                                        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke="currentColor"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                                                    </div>
                                                    <span class="tr3-date-text">@row.Data?.ToString("dd/MM/yyyy")</span>
                                                </div>
                                            }
                                        </td>
                                        <td><span class="tr3-badge @row.BadgeClass align-c">@row.Setor</span></td>
                                        
                                        <td class="align-c">
                                            @if (row.CalculadoInicial is null)
                                            {
                                                <span class="tr3-badge @row.BadgeClass align-c">Não enviado</span>
                                            }
                                            else
                                            {
                                                @($"R$ {row.CalculadoInicial.Value.ToString("N0", CultureBR)}")
                                            }
                                        </td>

                                        <td class="align-c">
                                            @if (row.TotalPrevisto is null)
                                            {
                                                <span class="tr3-badge @row.BadgeClass align-c">Não enviado</span>
                                            }
                                            else
                                            {
                                                @($"R$ {row.TotalPrevisto.Value.ToString("N0", CultureBR)}")
                                            }
                                           
                                        </td>
                                        <td class="align-c" style="font-weight:600;">R$ @(row.TotalRealizado?.ToString("N0", CultureBR) ?? "0")</td>
                                        <td class="align-c">                                         
                                            <span class="tr3-result @row.ResultadoClass">
                                                <span class="tr3-result-dot"></span>
                                                @((row.TotalResultado ?? 0).ToString("N0", CultureBR))%
                                            </span>
                                       
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="tr3-footer">
                <div class="tr3-pager">
                    <button class="tr3-pg-btn" @onclick="PaginaAnterior" disabled="@(_paginaAtual == 1)">←</button>
                    @for (int p = JanelaPaginas.inicio; p <= JanelaPaginas.fim; p++)
                    {
                        int pg = p;
                        <button class="tr3-pg-btn @(_paginaAtual == pg ? "active" : "")" @onclick="() => IrPara(pg)">@pg</button>
                    }
                    <button class="tr3-pg-btn" @onclick="ProximaPagina" disabled="@(_paginaAtual == TotalPaginas)">→</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public List<ReadRelatorioDeResultados> DadosRelatorioDeResultados { get; set; } = new();

    private DateTime? _dataInicioPendente;
    private DateTime? _dataFimPendente;
    private DateTime? _dataInicio;
    private DateTime? _dataFim;

    private string _filtroSetor = "";
    private string _colOrdem = "Data";
    private bool _ordemAsc = false;
    private int _paginaAtual = 1;
    private int _datasPorPagina = 5;

    private static readonly CultureInfo CultureBR = new CultureInfo("pt-BR");

    protected override void OnInitialized()
    {
        CultureInfo.DefaultThreadCurrentCulture = CultureBR;
        CultureInfo.DefaultThreadCurrentUICulture = CultureBR;
    }

    protected override void OnParametersSet()
    {
        if (DadosRelatorioDeResultados != null && DadosRelatorioDeResultados.Any())
        {
            var dataMaisRecente = DadosRelatorioDeResultados.Max(d => d.DtPredicao);
            _dataInicioPendente = _dataInicio = dataMaisRecente;
            _dataFimPendente = _dataFim = dataMaisRecente;
        }
    }

    private string _datasPorPaginaStr
    {
        get => _datasPorPagina.ToString();
        set { if (int.TryParse(value, out int v)) { _datasPorPagina = v; _paginaAtual = 1; } }
    }

    private void Buscar() { _dataInicio = _dataInicioPendente; _dataFim = _dataFimPendente; _paginaAtual = 1; }

    private List<ReadRelatorioDeResultados> DiasFiltrados()
    {
        var diaFiltrado = DadosRelatorioDeResultados.Where(d => d.DtPredicao >= _dataInicio && d.DtPredicao <= _dataFim).ToList();
        return (_colOrdem == "Data" && _ordemAsc) ? diaFiltrado.OrderBy(d => d.DtPredicao).ToList() : diaFiltrado.OrderByDescending(d => d.DtPredicao).ToList();
    }

    private int TotalPaginas => Math.Max(1, (int)Math.Ceiling(DiasFiltrados().Count / (double)_datasPorPagina));

    private (int inicio, int fim) JanelaPaginas
    {
        get
        {
            int inicio = Math.Max(1, _paginaAtual - 2);
            int fim = Math.Min(TotalPaginas, inicio + 4);
            inicio = Math.Max(1, fim - 4);
            return (inicio, fim);
        }
    }

    private List<GrupoData> GruposParaExibir
    {
        get
        {
            var pagina = DiasFiltrados().Skip((_paginaAtual - 1) * _datasPorPagina).Take(_datasPorPagina).ToList();
            return ExpandirEFiltrar(pagina).GroupBy(r => r.Data).Select(g => new GrupoData
            {
                Data = g.Key,
                Linhas = g.Select((src, i) => new DisplayRow
                {
                    Data = src.Data,
                    Setor = src.Setor,
                    CalculadoInicial = src.CalculadoInicial,
                    TotalPrevisto = src.TotalPrevisto,
                    TotalRealizado = src.TotalRealizado,
                    TotalResultado = src.TotalResultado,
                    ExibirData = i == 0
                }).ToList()
            }).ToList();
        }
    }

    private List<DisplayRow> ExpandirEFiltrar(List<ReadRelatorioDeResultados> dias)
    {
        var linhas = new List<DisplayRow>();
        foreach (var d in dias)
        {
            linhas.Add(new DisplayRow { Data = d.DtPredicao, Setor = "Sane/Infra", CalculadoInicial = d.PubCalculado, TotalPrevisto = d.PubEfetivado, TotalRealizado = d.PubRealizado, TotalResultado = d.PubResultado });
            linhas.Add(new DisplayRow { Data = d.DtPredicao, Setor = "Habitação", CalculadoInicial = d.PriCalculado, TotalPrevisto = d.PriEfetivado, TotalRealizado = d.PriRealizado, TotalResultado = d.PriResultado });
            linhas.Add(new DisplayRow { Data = d.DtPredicao, Setor = "Total", CalculadoInicial = d.TotalCalculado, TotalPrevisto = d.TotalEfetivado, TotalRealizado = d.TotalRealizado, TotalResultado = d.TotalResultado});
        }

        if (!string.IsNullOrWhiteSpace(_filtroSetor)) linhas = linhas.Where(r => r.Setor == _filtroSetor).ToList();

        if (_colOrdem != "Data")
        {
            linhas = _colOrdem switch
            {
                "CalculadoInicial" => _ordemAsc ? linhas.OrderBy(r => r.CalculadoInicial).ToList() : linhas.OrderByDescending(r => r.CalculadoInicial).ToList(),
                "TotalPrevisto" => _ordemAsc ? linhas.OrderBy(r => r.TotalPrevisto).ToList() : linhas.OrderByDescending(r => r.TotalPrevisto).ToList(),
                "TotalRealizado" => _ordemAsc ? linhas.OrderBy(r => r.TotalRealizado).ToList() : linhas.OrderByDescending(r => r.TotalRealizado).ToList(),
                "Resultado" => _ordemAsc ? linhas.OrderBy(r => r.TotalResultado).ToList() : linhas.OrderByDescending(r => r.TotalResultado).ToList(),
                _ => linhas
            };
        }
        return linhas;
    }

    private void OrdenarPor(string col) { _ordemAsc = _colOrdem == col ? !_ordemAsc : true; _colOrdem = col; _paginaAtual = 1; }
    private string SortIcon(string col) => _colOrdem != col ? "" : (_ordemAsc ? "↑" : "↓");
    private string ActiveClass(string col) => _colOrdem == col ? "active" : "";
    private void IrPara(int p) => _paginaAtual = p;
    private void PaginaAnterior() => _paginaAtual = Math.Max(1, _paginaAtual - 1);
    private void ProximaPagina() => _paginaAtual = Math.Min(TotalPaginas, _paginaAtual + 1);

    private class DisplayRow
    {
        public DateTime? Data { get; set; }
        public string Setor { get; set; } = "";
        public decimal? CalculadoInicial { get; set; }
        public decimal? TotalPrevisto { get; set; }
        public decimal? TotalRealizado { get; set; }
        public bool ExibirData { get; set; }
        public decimal? TotalResultado;
        public string TrClass => (ExibirData ? "tr3-group-top " : "") + (Setor == "Total" ? "tr3-total-row" : "");
        public string BadgeClass => Setor switch { "Habitação" => "tr3-badge--hab", "Sane/Infra" => "tr3-badge--infra", "Total" => "tr3-badge--total", _ => "" };
        public string ResultadoClass => "tr3-result--green";
    }

    private class GrupoData { public DateTime? Data { get; set; } public List<DisplayRow> Linhas { get; set; } = new(); }
}
