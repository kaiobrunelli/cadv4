</style>
<MudDialog Style="border-radius:12px; min-height:585px; min-width:610px;" Class="mb-4  pb-2">

	<TitleContent>
		<div class=" d-flex justify-space-between align-center">
			<div>
				<MudText Typo="Typo.h5" Style="font-weight: 500; color: #0f172a; ">Gerenciar Acesso</MudText>
				<MudText Typo="Typo.body2" Class="mud-text-secondary">Controle permissões e comunicações.</MudText>
			</div>
			<MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="Cancel" Variant="Variant.Text" Color="Color.Default" />
		</div>
	</TitleContent>
	<DialogContent  >
	<MudExpansionPanels Elevation="25" Outlined="false" Dense=true Square="true"  Style="border-radius:6px">
		<MudExpansionPanel Text="Cadastrar Empregado" Class="pb-4"    Expanded="true" Style="color: #424242;  font-weight:500; ">
       <div>
					<section class="pb-3">
				<div class="card-adicionar-colaborador">
					<MudGrid Spacing="3" Style="align-items:center">
						<MudItem xs="12" sm="12" md="12" lg="12">
							<MudText Typo="Typo.body1" Style=" color: #0f172a;">Adicionar</MudText>					
						</MudItem>
						<MudItem xs="7" sm="7" md="7" lg="7">
							<MudForm @bind-IsValid="_isSuccess" ValidationDelay="0">
								<MudTextField @bind-Value="_matriculaCadastroEmpregadoAutorizado"
											  T="string"
											  Placeholder="Matrícula C999999"
											  Variant="Variant.Outlined"
											  Class="custom-input-field"
											  Validation="@(new Func<string, string?>(ValidateMatricula))"
											  Margin="Margin.Dense" />
							</MudForm>
						</MudItem>

						<MudItem xs="4" sm="4" lg="4" md="4">
							<MudTooltip Duration="300" Delay="500" Text="Define o tempo de acesso ao APP. Interminado: sem limitação de período. Temporário: limitado à data selecionada.">
										<MudCheckBox CheckedIcon="@Icons.Material.Filled.AccessTimeFilled" UncheckedIcon="@Icons.Material.Filled.TimerOff" @bind-Value="_cadastrarAutorizadoTemporario" Color="@Color.Primary">
									@(_cadastrarAutorizadoTemporario ? "Temporário" : "Indeterminado")
								</MudCheckBox>
							</MudTooltip>
						</MudItem>
						<MudItem xs="7" sm="7" lg="7" md="7">
							<MudForm @bind-IsValid="_isSuccess" ValidationDelay="0">
							
									<MudTextField @bind-Value="_dataAutorizadoTemporario"
												  T="DateTime?"
												  Mask="@(new DateMask("dd/MM/yyyy"))"
												  Placeholder="Inserir data fim"
												  ErrorText="Data inválida"
												  Variant="Variant.Outlined"
												  Disabled="@(!_cadastrarAutorizadoTemporario)"												
												  Class="custom-input-field "
												  Style="width:100% !important"
												  Margin="Margin.Dense" />
							
							</MudForm>
						</MudItem>
						<MudItem xs="12" sm="5" md="5" lg="5" Class="d-flex justify-center align-item-center">
							<MudButton FullWidth="true"
									   Variant="Variant.Outlined"
									   Color="Color.Primary"
									   Size="Size.Small"
									   OnClick="CadastrarAutorizado"
									   StartIcon="@Icons.Material.Filled.PersonAdd"
									   Class="mud-border-radius-md btn-match-input pa-3">
								Adicionar
							</MudButton>
						</MudItem>
					</MudGrid>



				</div>

				<MudStack Spacing="3" Class="mt-4">
					@if (_preditorAutorizados.Any())
					{
						@foreach (var autorizado in _preditorAutorizados)
						{
							<MudPaper Elevation="0" Class="px-4 py-2 d-flex align-center justify-space-between user-card-hover"
									  Style="border: 1px solid #E2E8F0; border-radius: 14px;">
								<div class="d-flex align-center gap-4">
									<MudAvatar Color="Color.Success"  Variant="Variant.Filled" Style=" font-size:1.1rem;">
										@GetInitials(autorizado.NomeOperador ?? "C X")
									</MudAvatar>
									<div>
										<div class="d-flex align-center gap-2">
											<MudText Typo="Typo.body1" Style="font-weight: 600; color: #0f172a;">@autorizado.NomeOperador</MudText>
											@if (autorizado.Eventual)
											{
												<MudChip T="string"
														 Size="Size.Small"
														 Color="Color.Warning"
														 Variant="Variant.Outlined"
																 Style="font-size: 10px; letter-spacing:1px;"
														 Class="px-2 py-0">Eventual</MudChip>
											}
										</div>
										<MudText Typo="Typo.caption" Style="color: #94a3b8; text-transform: uppercase;">Matrícula: @autorizado.CoMatricula</MudText>
									</div>
								</div>
								<div class="d-flex gap-2">
									<MudTooltip Text="@(autorizado.Eventual ? "Remover Eventualidade" : "Tornar Eventual")">
										<MudIconButton Icon="@(autorizado.Eventual? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"													   
													OnClick="@(autorizado.Eventual
													    ? (() => RemoverEventual(autorizado.CoMatricula))
													    : (() => CadastrarEventual(autorizado.CoMatricula)))"													
													   Color="Color.Warning"
													   Size="Size.Medium" />
									</MudTooltip>
									<MudTooltip Text="Remover">
										<MudIconButton Icon="@Icons.Material.Outlined.Delete"
													   OnClick="(()=> DesabilitarAutorizado(autorizado.CoMatricula))"
													   Color="Color.Error" Size="Size.Medium" />
									</MudTooltip>
								</div>
							</MudPaper>
						}
					}
					else
					{
						<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
							<MudAlert Severity="Severity.Warning" Class="flex-1 alerta-autorizados">
								Nenhum empregado cadastrado.
							</MudAlert>
						</MudStack>
					}
				</MudStack>
			</section>
		</div>
    </MudExpansionPanel>
    <MudExpansionPanel Text="Cadastrar E-Mail" Class="mb-4 "   Style="color: #424242;  font-weight:500; ">
				<section class="mb-4 pb-3">
					<div class="d-flex align-center gap-3 mb-3 mt-6">
						<div style="width: 4px; height: 24px; background-color: var(--mud-palette-primary); border-radius: 2px;"></div>
						<MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #0f172a;">Adicionar</MudText>
					</div>
					<MudGrid Spacing="3" Class="align-center " Justify="Justify.FlexStart">
						<MudItem xs="6" sm="6" lg="6" md="6" Class="mb-2">
							<MudRadioGroup T="string" Value="_tipoCadastroMatriculaOuUGC" ValueChanged="OnTipoCadastroChanged">
								<MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.Center">
									<MudRadio Color="Color.Primary" Value="@("matricula")">Matrícula</MudRadio>
									<MudRadio Color="Color.Primary" Value="@("ugc")">UGC</MudRadio>
								</MudStack>
							</MudRadioGroup>
						</MudItem>
						@if (_tipoCadastroMatriculaOuUGC == "matricula")
						{
							<MudItem xs="6" sm="6" lg="6" md="6" Class="mb-2">
								<MudForm @bind-IsValid="_isSuccessMatriculaouUGC" ValidationDelay="0">
									<MudTextField @bind-Value="_matriculaCadastroEmail"
												  T="string"
												  Style="text-transform: lowercase;"
												  FullWidth="true"
												  Placeholder="Matrícula  C999999"
												  Variant="Variant.Outlined"
												  Class="custom-input-field email-input-novo"
												  Validation="@(new Func<string, string?>(ValidateMatricula))"
												  Margin="Margin.Dense" />
								</MudForm>
							</MudItem>
						}
						else
						{
							<MudItem xs="6" sm="6" Class="mb-2">
								<MudForm @bind-IsValid="_isSuccessMatriculaouUGC" ValidationDelay="0">
									<MudTextField @bind-Value="_numeroUGCCadastroEmail"
												  T="string"
												  FullWidth="true"
												  Placeholder="UGC ex: CEFGA ou CEFGA99"
												  Variant="Variant.Outlined"
												  MaxLength="7"
												  Class="custom-input-field email-input-novo"
												  Validation="@(new Func<string, string?>(ValidateUGC))"
												  Margin="Margin.Dense" />
								</MudForm>
							</MudItem>
						}
						<MudItem xs="12" sm="12">
							<MudForm @bind-IsValid="_isSuccessNomeEmpregadoOuUGC" ValidationDelay="0">
								<MudTextField @bind-Value="_nomeEmpregadoOuNomeUGC"
											  T="string"
											  FullWidth="true"
											  Placeholder="Descritivo"
											  Variant="Variant.Outlined"
											  Class="custom-input-field email-input-novo"
											  Validation="@(new Func<string, string?>(ValidateNome))"
											  Margin="Margin.Dense" />

							</MudForm>
						</MudItem>
						<MudItem xs="7" sm="7">
							<MudRadioGroup @bind-Value="_tipoDestinatario">
								<MudStack Row="true" AlignItems="AlignItems.Start" Justify="Justify.Center">
									<MudTooltip Duration="300" Delay="300" Text="Destinatário">
										<MudRadio Color="Color.Primary" Value="@("PARA")">Para</MudRadio>
									</MudTooltip>
									<MudTooltip Duration="300" Delay="300" Text="Com cópia">
										<MudRadio Color="Color.Primary" Value="@("CC")">Cc</MudRadio>
									</MudTooltip>
									<MudTooltip Duration="300" Delay="300" Text="Com cópia oculta">
										<MudRadio Color="Color.Primary" Value="@("CCO")">Cco</MudRadio>
									</MudTooltip>
								</MudStack>
							</MudRadioGroup>
						</MudItem>
						<MudItem xs="5" sm="5">
							<MudButton FullWidth="true"
									   Variant="Variant.Outlined"
									   Color="Color.Primary"
									   Size="Size.Small"
									   StartIcon="@Icons.Material.Filled.Mail"
									   OnClick="CadastrarDestinatarioEmail"
									   Class=" btn-match-input mud-border-radius-md pa-2">
								Cadastrar E-mail
							</MudButton>
						</MudItem>
					</MudGrid>


					<div class="d-flex align-center gap-3 mb-3 mt-6">
						<div style="width: 4px; height: 24px; background-color: var(--mud-palette-secondary); border-radius: 2px;"></div>
						<MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #0f172a;">Gerenciar E-mail</MudText>
					</div>
				<MudStack Spacing="3" Class="mt-4">
						@if (DestinatarioEmail.Any())
					{
							@foreach (var destinatario in DestinatarioEmail)
						{
							<MudPaper Elevation="0" Class="px-4 py-2 d-flex align-center justify-space-between user-card-hover"
									  Style="border: 1px solid #E2E8F0; border-radius: 14px; width:100% !important">
								<div class="d-flex align-center gap-4">
										 <MudIcon Icon="@Icons.Material.Filled.Email" Color="Color.Success" Size="Size.Large"></MudIcon>
									<div>
										<div class="d-flex align-center gap-2" style="height:26px">
												<MudText GutterBottom="false" Typo="Typo.body1" Style="font-weight: 500; color: #0f172a;">@destinatario.EmailDestinatario</MudText>
												<MudChip T="string" Color="Color.Secondary" Style="font-weight:400;" Variant="Variant.Text">@destinatario.TipoDestinatario</MudChip>
										</div>
										<MudText Typo="Typo.caption"  Style="color: #94a3b8; text-transform: uppercase;">@destinatario.DeDestinatario</MudText>
									</div>
								</div>
								<div class="d-flex gap-2">
						
									<MudTooltip Text="Remover">
										<MudIconButton Icon="@Icons.Material.Outlined.Delete"
													   OnClick="(()=> RemoverEmail(destinatario.CoDestinatario))"
													   Color="Color.Error" Size="Size.Medium" />
									</MudTooltip>
								</div>
							</MudPaper>
						}
					}
					else
					{
						<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
							<MudAlert Severity="Severity.Warning" Class="flex-1 alerta-autorizados">
								Nenhum empregado cadastrado.
							</MudAlert>
						</MudStack>
					}
				</MudStack>


				</section>
    </MudExpansionPanel>
   
</MudExpansionPanels>
		


	
	</DialogContent>
</MudDialog>

@code {

	[CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
	[Parameter] public List<ReadDestinatarioEmail> DestinatarioEmail { get; set; }
	private bool teste_Avaliar = true;

	#region Propriedades Gerais
	private bool _isSuccess = false;
	private bool _isSuccessNomeEmpregadoOuUGC = false;
	private bool _isSuccessEmail = false;
	private bool _isSuccessMatriculaouUGC = false;
	private DateTime? _dataAutorizadoTemporario = DateTime.UtcNow.Date;
	private bool _cadastrarAutorizadoTemporario = false;
	private string _destinatarioEmailSelecionado = "";
	private List<ReadPreditorAutorizados> _preditorAutorizados = new();
	private string _matriculaCadastroEmpregadoAutorizado = "";
	private string _tipoCadastroMatriculaOuUGC = "matricula";
	private string _matriculaCadastroEmail = "";
	private string _numeroUGCCadastroEmail = "";
	private string _nomeEmpregadoOuNomeUGC = "";
	private string _tipoDestinatario = "PARA";


	#endregion

	private async Task AtualizarTeste()
	{
		var responseDestinatarioEmail = await PreditorService.ConsultarEmailPreditor();


		DestinatarioEmail = await HttpResponseHandler.ResponseHandler<List<ReadDestinatarioEmail>>(responseDestinatarioEmail, Snackbar);


	}
	private bool _carregouTodaPagina = false;

	protected override async Task OnInitializedAsync()
	{
		var responseAutorizados = await PreditorService.ConsultarPreditorAutorizados();
		_preditorAutorizados = await HttpResponseHandler.ResponseHandler<List<ReadPreditorAutorizados>>(responseAutorizados, Snackbar);
	}

	#region Endpoints API

	private async Task DesabilitarAutorizado(string matricula)
	{

		var response = await PreditorService.DesabilitarPreditorAutorizado(matricula.ToLower());
		await HttpResponseHandler.ResponseHandler(response, Snackbar);
		await RecarregarDadosDaPagina();
	}

	private async Task CadastrarAutorizado()
	{
		if (!ValidarCadastroDeAutorizado()) return;

		var novoAutorizado = new CreatePreditorAutorizados()
			{
				CoMatricula = _matriculaCadastroEmpregadoAutorizado,
				ValidadeAutorizacao = _cadastrarAutorizadoTemporario
																		? _dataAutorizadoTemporario
																		: null
			};
		var response = await PreditorService.CadastrarPreditorAutorizado(novoAutorizado);
		await HttpResponseHandler.ResponseHandler(response, Snackbar);
		await RecarregarDadosDaPagina();
	}

	private async Task CadastrarEventual(string matricula)
	{		
		var response = await PreditorService.CadastrarEventual(matricula);
		await HttpResponseHandler.ResponseHandler(response, Snackbar);
		await RecarregarDadosDaPagina();
	}

	private async Task RemoverEventual(string matricula)
	{
		var response = await PreditorService.RemoverEventual( matricula);
		await HttpResponseHandler.ResponseHandler(response, Snackbar);
		await RecarregarDadosDaPagina();
	}

	private async Task CadastrarDestinatarioEmail()
	{
		if (!HabilitarBotaoEnviarEmail()) return;

		var emailCadastrado = new CreateDestinatarioEmailPreditor()
			{
				DeDestinatario = _nomeEmpregadoOuNomeUGC,
				CoMatriculaDestinatario = _tipoCadastroMatriculaOuUGC == "ugc"
																								? _numeroUGCCadastroEmail
																								: _matriculaCadastroEmail,
				TipoDestinatario = _tipoDestinatario
			};

		var response = await PreditorService.CadastrarEmailPreditor(emailCadastrado);
		await HttpResponseHandler.ResponseHandler(response, Snackbar);
		await RecarregarDadosDaPagina();

	}
	private async Task RemoverEmail(int idEmail)
	{

		var response = await PreditorService.RemoverEmailPreditor(idEmail);
		await HttpResponseHandler.ResponseHandler(response, Snackbar);

		var responseDestinatarioEmail = await PreditorService.ConsultarEmailPreditor();
		DestinatarioEmail = await HttpResponseHandler.ResponseHandler<List<ReadDestinatarioEmail>>(responseDestinatarioEmail, Snackbar);

	}
