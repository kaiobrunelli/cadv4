@using MudBlazor
@using System.Collections.Generic
@using System.Linq
@using System.Threading.Tasks

<style>
	.borda-inferior-radius {
		border-bottom-left-radius: 8px;
		border-bottom-right-radius: 8px;
	}

	.mud-table .mud-table-toolbar {
		border-top-left-radius: 8px;
		border-top-right-radius: 8px;
	}
	.text-center {
		text-align: center !important;
	}

</style>

<MudTable T="MovimentacaoGeral" Virtualize="false" Class="mb-2 pa-4" 
		  Items="@Items" Context="item"
		  Filter="new Func<MovimentacaoGeral,bool>(FilterFunc1)" @bind-SelectedItem="selectedItem1"
		  Elevation="25"
		  Style="border-radius: 24px;"
		  AllowUnsorted="false"
		  Square="true"
		  Dense="true"
		  Hover="true"
		  Loading="@Loading"
		  Striped="true"
		  >

	<ToolBarContent>

		<MudItem Class="d-flex  justify-end flex-grow-1 borda-top-radius">
			<MudSpacer />
			<MudStack Row="true" Justify="Justify.FlexEnd" Class="d-flex  justify-end pa-1" Style="background-color:#005ca9; border-radius:8px;">
				<MudTextField @bind-Value="FiltroBuscarPalavra" Placeholder="Buscar" Style="width:200px" Class="mt-0 flex-none"></MudTextField>
				<MudButton Class="btn-caixa-small" Style="color:white" OnClick="ClearFilter">Limpar filtro</MudButton>
			</MudStack>
		</MudItem>
	</ToolBarContent>
	<LoadingContent>
		<MudProgressCircular Color="Color.Primary" Indeterminate="true" />
	</LoadingContent>

	<ColGroup>
		<col style="width: 10%;" />
		<col style="width: 20%;" />
		<col />
		<col />
		<col />
	</ColGroup>

	<HeaderContent>
		<MudTh  Class="text-center"><b>Código Apontamento</b></MudTh>
		<MudTh Class="text-center"><b>Nº Contrato</b></MudTh>
		<MudTh Class="text-center"><b>Tipo Movimento</b></MudTh>
		<MudTh Class="text-center"><b>Valor</b></MudTh>
		<MudTh Class="text-center"><b></b></MudTh>
	</HeaderContent>

	<RowTemplate>
		<MudTd Class="text-center">@item.CoApontamento</MudTd>
		<MudTd Class="text-center">@item.NuContrato - @item.NuContratoDv</MudTd>
		<MudTd Class="text-center">@item.TipoMovimentacao</MudTd>
		<MudTd Class="text-center">R$ @item.VrTotal?.ToString("N2")</MudTd>
		<MudTd Class="text-center">
			<MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary"
						   OnClick="@(() => ToggleExpand(item))" />
		</MudTd>
	</RowTemplate>

	<ChildRowContent>
		@if (item.ExpandirObservacao)
		{
			<DetalhesMovimentacaoGeral Item="item" />
		}
	</ChildRowContent>

	<PagerContent>
		@if (Items?.Count() > 10)
		{
			<MudTablePager Class="pager-buttons borda-inferior-radius"
						   RowsPerPageString="@RowsPerPageString"
						   InfoFormat="@InfoFormat" />
		}
	</PagerContent>

	<NoRecordsContent>
		<MudText Color="Color.Primary" Typo="Typo.h6">
			Nenhum registro encontrado
		</MudText>
	</NoRecordsContent>
</MudTable>

@code {
	[Parameter] public IEnumerable<MovimentacaoGeral> Items { get; set; }
	[Parameter] public bool Loading { get; set; }
	[Parameter] public string RowsPerPageString { get; set; } = "Itens por página";
	[Parameter] public string InfoFormat { get; set; } = "{first}–{last} de {total}";
	
	
	private bool IsRowExpanded(MovimentacaoGeral item) => item.ExpandirObservacao;
	void ToggleExpand(MovimentacaoGeral item)
	{
		item.ExpandirObservacao = !item.ExpandirObservacao;
		StateHasChanged();
	}


	protected override Task OnParametersSetAsync()
	{

		ItemsNaoFiltrados = Items;
		return base.OnParametersSetAsync();
	}
	private string ConverterData(DateTime? data)
	{
		if (data.HasValue)
		{
			return data.Value.ToString("dd/MM/yy");
		}
		return string.Empty; 
	}
	private string ConverterValor(decimal? valor)
	{

		return "R$ " + (valor.HasValue
				? valor.Value.ToString("N2", new System.Globalization.CultureInfo("pt-BR"))
				: "0,00");

	}
	private string FiltroBuscarPalavra = "";
	private MovimentacaoGeral selectedItem1;
	private bool FilterFunc1(MovimentacaoGeral element) => FilterFunc(element, FiltroBuscarPalavra);
	private IEnumerable<MovimentacaoGeral> ItemsNaoFiltrados { get; set; }
	private bool FilterFunc(MovimentacaoGeral element, string searchString)
	{
		if (string.IsNullOrWhiteSpace(searchString))
			return true;
		if (element.NuContrato!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
	
		if (element.CoApontamento!.ToString()!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		if (element.TipoMovimentacao!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;
		if (element.VrTotal.ToString()!.Contains(searchString, StringComparison.OrdinalIgnoreCase))
			return true;

		return false;
	}

	private void ClearFilter()
	{
		FiltroBuscarPalavra = "";
		Items = ItemsNaoFiltrados;
	}
}


