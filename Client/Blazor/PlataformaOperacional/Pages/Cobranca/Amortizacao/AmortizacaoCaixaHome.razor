	private async Task ReiniciarControleBotoes()
	{
		_isProcessing = false;
		await ControleGeralaHandle();
	}


	private async Task IniciarAutomacao()
	{
		var options = new DialogOptions { CloseOnEscapeKey = true };
		var parameters = new DialogParameters<BoxSenha>
		{
			{ x => x.Title, "Iniciar" }
		};
		var dialog = await DialogService.ShowAsync<BoxSenha>("", parameters, options);
		var result = await dialog.Result;


		if (!result!.Canceled)
		{
			_senhaCriptografada = result.Data.ToString();
			if (_senhaCriptografada == null) return;
			var usuario = new SenhaUsuario(_senhaCriptografada);

			var response = await CobrancaService.ProcessarAmortizacaoCaixa(usuario);
			if (response.IsSuccessStatusCode)
			{
				_isProcessing = true;
			}
			await HttpResponseHandler.ResponseHandler(response!, Snackbar);
			if (_movimentacaoControleGeral.DescBotaoExecutar.ToUpper() == "FINALIZADO")
			{
				await ReiniciarControleBotoes();
			}
	
			StateHasChanged();
			await InvokeAsync(StateHasChanged);
		}
	}


	private async Task SignalRTestButton()
	{
		await SignalRService.ReiniciarEscutaDaOperacao("TesteSignalR");
		_isProcessing = true;
		var response = await CobrancaService.TesteSignalR();
		await HttpResponseHandler.ResponseHandler(response!, Snackbar);
		StateHasChanged();
		await InvokeAsync(StateHasChanged);
	}
	private async Task CancelarAutomacao()
	{

		var options = new DialogOptions { CloseOnEscapeKey = true };
		var parameters = new DialogParameters<BoxSenha>
		{
			{ x => x.Title, _movimentacaoControleGeral.DescBotaoCancelar  }
		};
		var dialog = await DialogService.ShowAsync<BoxSenha>("", parameters, options);
		var result = await dialog.Result;


		if (!result!.Canceled)
		{
			_senhaCriptografada = result.Data.ToString();
			if (_senhaCriptografada == null) return;
			var usuario = new SenhaUsuario(_senhaCriptografada);
			var response = await CobrancaService.CancelarOperacaoAmortizacaoCaixa(usuario);
			await HttpResponseHandler.ResponseHandler(response!, Snackbar);
			await ControleGeralAmortizacaoCaixaHandle();
			_isProcessing = false;
			StateHasChanged();
			await InvokeAsync(StateHasChanged);
		}

	}
	#endregion

