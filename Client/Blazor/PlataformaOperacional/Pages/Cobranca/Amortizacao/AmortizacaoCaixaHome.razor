@page "/amortizacaocaixa"
@using System.Globalization

@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject CobrancaService CobrancaService
@inject MudThemeService MudThemeService
@inject SignalRService SignalRService
@inject IJSRuntime JS

<style>
	.mud-alert-position {
		display: flex;
		align-items: center;
		gap: 8px; 
	}

	.card-container {
		width: 100%;
		max-width: 1000px;
		border-radius: 14px;
		background-color: white;
		padding: 20px;
		box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
	}

	.header-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.form-section {
		border: 1px solid #e0e6ed;
		border-radius: 12px;
		padding: 24px;
		margin-top: 24px;
	}

	.form-title {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 16px;
	}

	.form-group {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

	.footer-buttons {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 24px;
	}

	.borda-inferior-radius {
		border-bottom-left-radius: 8px;
		border-bottom-right-radius: 8px;
	}

	.mud-alert-message {
		width: 100%;
	}

	.borda-inferior-radius {
		border-bottom-left-radius: 8px;
		border-bottom-right-radius: 8px;
	}

	.text-center {
		text-align: center !important;
	}
</style>

<MudThemeProvider Theme="_customTheme" />
<MudContainer Class="mb-6 mt-0">

	<div class="card-container">
		<MudGrid>
			<MudItem lg="3" md="3" />
			<MudItem lg="6" md="6" Class="pt-4">
				<MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center">
					<MudText Typo="Typo.h4" Style="color: #64748B;">
						Amortização Caixa
					</MudText>
				</MudStack>
			</MudItem>
			<MudItem lg="3" md="3" Class="pt-4">
				<MudStack Justify="Justify.FlexEnd" AlignItems="AlignItems.End">
					<MudTooltip Text="Copiar endereço da pasta de arquivos do servidor" Delay="200" Duration="200">
						<MudIconButton OnClick="CopiarEndereco" Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" />
					</MudTooltip>
				</MudStack>
			</MudItem>

			<MudItem lg="12" md="12" Class="pt-2">
				<MudStack Row="true"
						  Justify="Justify.FlexEnd"
						  AlignItems="AlignItems.Center"
						  Spacing="2">
				
					@if (_paginaCarregouPorCompleto)
					{
						<ProgressBarSignalR HubConnectId="@_connectHubId"
											AtualizarEstado="AtualizarEstadoDaPagina"
											FaseAtual="@_faseAtual"
											SenhaInvalidaEvent="ReiniciarControleBotoes"
											ModoDebug="false" />
					}


				
				</MudStack>
			</MudItem>

			<MudItem xs="12" sm="9" lg="9" md="9" Class="mt-n3">
				<MudGrid>
					<MudItem xs="12" lg="4" md="4">
						<AmortizacaoCaixaCardComponent OnClick="async () => await MostrarTabelaMovimentacao(TipoDeMovimentacaoAmortizacaoCaixa.TODAS)"
													   Titulo="Total Contratos"
													   IconCard="total"
													   PageIsLoading="_pageIsLoading"
													   QuantidadeContrato="@_movimentacaoControleGeral.QtdTotalApontamentos"
													   ValorTotal="@_movimentacaoControleGeral.VlTotalApontamentos">
						</AmortizacaoCaixaCardComponent>
					</MudItem>
					<MudItem xs="12" lg="4" md="4">
						<AmortizacaoCaixaCardComponent OnClick="async () => await MostrarTabelaMovimentacao(TipoDeMovimentacaoAmortizacaoCaixa.AE_CAIXA)"
													   Titulo="AE-CAIXA"
													   IconCard=""
													   PageIsLoading="_pageIsLoading"
													   QuantidadeContrato="@_movimentacaoControleGeral.QtdAmortizacoes"
													   ValorTotal="@_movimentacaoControleGeral.VlAmortizacoes">
						</AmortizacaoCaixaCardComponent>
					</MudItem>
					<MudItem xs="12" lg="4" md="4">
						<AmortizacaoCaixaCardComponent OnClick="async () => await MostrarTabelaMovimentacao(TipoDeMovimentacaoAmortizacaoCaixa.DEV_CAIXA)"
													   Titulo="DEV-CAIXA"
													   IconCard=""
													   PageIsLoading="_pageIsLoading"
													   QuantidadeContrato="@_movimentacaoControleGeral.QtdDevolucoes"
													   ValorTotal="@_movimentacaoControleGeral.VlDevolucoes">
						</AmortizacaoCaixaCardComponent>
					</MudItem>
					<MudItem xs="12" lg="4" md="4">
						<AmortizacaoCaixaCardComponent OnClick="async () => await MostrarTabelaMovimentacao(TipoDeMovimentacaoAmortizacaoCaixa.CCI)"
													   Titulo="CCI"
													   IconCard="cci"
													   PageIsLoading="_pageIsLoading"
													   QuantidadeContrato="@_movimentacaoControleGeral.QtdCci"
													   ValorTotal="@_movimentacaoControleGeral.VlCci">
						</AmortizacaoCaixaCardComponent>
					</MudItem>
					<MudItem xs="12" lg="4" md="4">
						<AmortizacaoCaixaCardComponent OnClick="async () => await MostrarTabelaMovimentacao(TipoDeMovimentacaoAmortizacaoCaixa.DRP)"
													   Titulo="DRP"
													   IconCard="drp"
													   PageIsLoading="_pageIsLoading"
													   QuantidadeContrato="@_movimentacaoControleGeral.QtdDrp"
													   ValorTotal="@_movimentacaoControleGeral.VlDrp">
						</AmortizacaoCaixaCardComponent>
					</MudItem>
					<MudItem xs="12" lg="4" md="4">
						<AmortizacaoCaixaCardComponent OnClick="async () => await MostrarTabelaMovimentacao(TipoDeMovimentacaoAmortizacaoCaixa.ANALISAR)"
													   StatusChip="true"
													   FaseDaAnalise="@_movimentacaoControleGeral.Situacao"
													   Titulo="Analisar"
													   IconCard="analisar"
													   PageIsLoading="_pageIsLoading"
													   QuantidadeContrato="@_movimentacaoesAnalisarData.Count()">
						</AmortizacaoCaixaCardComponent>
					</MudItem>
				</MudGrid>
			</MudItem>

			<MudItem lg="3" md="3" Class="mt-n3">
				<MudPaper Class="pa-4" Elevation="0" Style="border: 1px solid #e0e6ed; border-radius:10px;">
					@if (_desabilatarBotao)
					{
						<MudSkeleton SkeletonType="SkeletonType.Rectangle" Style="border-radius:16px;" Height="300px" Width="175px" />
					}
					else
					{
						<MudStack Row="false" Justify="Justify.FlexEnd">

							<MudButton Variant="Variant.Filled"
									   Color="Color.Primary"
									   Style="border-radius:24px;width:100%; "
									   Disabled="@(!_movimentacaoControleGeral.BotaoExecutar || _isProcessing)"
									   OnClick="IniciarAutomacao"
									   StartIcon="@Icons.Material.Filled.PlayArrow">
								@_movimentacaoControleGeral.DescBotaoExecutar
							</MudButton>					
							@if (_movimentacaoControleGeral.BotaoConfigurar)
							{
								<MudButton Variant="Variant.Filled"
										   Color="Color.Secondary"
										   Disabled="@((!_movimentacaoControleGeral.BotaoExecutar || _isProcessing) && _movimentacaoControleGeral.DescBotaoExecutar != "Finalizado")"
										   Style="border-radius:24px;"
										   OnClick="@(() => Navigation.NavigateTo($"{Navigation.BaseUri}amortizacaocaixaconfiguracoes"))"
										   StartIcon="@Icons.Material.Filled.Settings">
									Configuração
								</MudButton>
							}
							<MudButton Variant="Variant.Filled"
									   Color="Color.Secondary"
									   Disabled="@((!_movimentacaoControleGeral.BotaoExecutar || _isProcessing) && _movimentacaoControleGeral.DescBotaoExecutar != "Finalizado")"
									   Style="border-radius:24px;"
									   OnClick="@(() => Navigation.NavigateTo($"{Navigation.BaseUri}amortizacaocaixarelatorio"))"
									   StartIcon="@Icons.Material.Filled.ContentPasteSearch">
								Relatório
							</MudButton>
							@if (_movimentacaoControleGeral.BotaoCancelar)
							{
								<MudButton Variant="Variant.Filled"
										   Color="Color.Secondary"
										   Disabled="@(!_movimentacaoControleGeral.BotaoExecutar || _isProcessing)"
										   Style="border-radius:24px;"
										   OnClick="CancelarAutomacao"
										   StartIcon="@Icons.Material.Filled.Cancel">
									Cancelar
								</MudButton>
							}
							<MudStack Spacing="1" Class="mt-1" Justify="Justify.Center" AlignItems="AlignItems.Start">
								<MudStack Class="ml-6" Row="true" Justify="Justify.Center" AlignItems="AlignItems.Start" Spacing="1">
									<MudIcon Icon="@Icons.Material.Filled.CalendarMonth" Color="Color.Primary" Size="Size.Small"></MudIcon>
									<MudTooltip Delay="400" Duration="200"
												Text="Datas para amortização. Observar pendência na carga quando houver ícone de alerta ao lado da data.">
										<MudText Style="line-height: 1.6;" Typo="Typo.body2">Datas Pendentes</MudText>
									</MudTooltip>
								</MudStack>
								@foreach (var item in _controlesPentens)
								{
									var corChip = item.DtRecebimentoArquivo == null ? Color.Warning : Color.Primary;
									var corIcone = item.DtRecebimentoArquivo == null ? Color.Warning : Color.Success;
									var typeIcone = item.DtRecebimentoArquivo == null ? Icons.Material.Filled.AccessTimeFilled : Icons.Material.Filled.CheckCircle;

									<div class="d-flex justify-space-around align-center">
										<MudChip T="string" Variant="Variant.Outlined" Size="Size.Small" Class="ml-10" Color="@corChip">
											@item.DtReferencia.ToString("dd/MM/yyyy")
										</MudChip>
										@if (@item.DtRecebimentoArquivo == null)
										{
											<MudTooltip Text="Aguardando recebimento da carga para presente data" Delay="200" Duration="200">
												<MudIcon Icon="@Icons.Material.Filled.AccessTimeFilled"
														 Color="Color.Warning"
														 Class="mt-1"
														 Size="Size.Small" />
											</MudTooltip>
										}

									</div>
								}

							</MudStack>

						</MudStack>
					}
				</MudPaper>

			</MudItem>
		</MudGrid>
		@if (_movimentacaoControleGeral.Alertas.Count > 0)
		{
			foreach (var alerta in _movimentacaoControleGeral.Alertas)
			{
				@if (!string.IsNullOrEmpty(alerta.MensagemDeAlerta))
				{
					<MudItem xs="12" lg="12" md="12">
						<MudAlert Severity="@alerta.AlertaSeverity">
							@alerta.MensagemDeAlerta
						</MudAlert>
					</MudItem>
				}
			}
		}

		<MudItem xs="12" lg="12" md="12" Class="@(_mostrarTabelaMovimentacoes ? "d-block" : "d-none")">
			<TabelaMovimentacaoGeral Items="_movimentacaoesGeraisData"
									 Loading="_processandoMovimentacao" />
		</MudItem>
		<MudItem xs="12" lg="12" md="12" Class="@(_mostrarTabelaCCI ? "d-block" : "d-none")">
			<TabelaMovimentacaoCCI Items="_movimentacaoesCCI"
								   MovimentaoGeral="_movimentacaoesGeraisData"
								   CoControle="_movimentacaoControleGeral.CoControle"
								   Loading="_processandoMovimentacao" />
		</MudItem>
		<MudItem xs="12" lg="12" md="12" Class="@(_mostrarTabelaDrp ? "d-block" : "d-none")">
			<TabelaMovimentacaoDRP Items="@_movimentacoesDrpData"
								   Loading="_tabelaIsLoading"
								   RowsPerPageString="Itens por página"
								   InfoFormat="{first}–{last} de {total}" />
		</MudItem>
		<MudItem xs="12" lg="12" md="12" Class="@(_mostrarTabelaTratativas ? "d-block" : "d-none")">

			<MudTable T="MovimentacaoParaAnalise" Items="@_movimentacaoesAnalisarDataCache" Class="mb-2 pa-4" Context="context"
					  Elevation="25"
					  Style="border-radius: 24px;"
					  AllowUnsorted="false"
					  Square="true"
					  Hover="true"
					  Loading="_processandoMovimentacao"
					  Striped="true">
				<LoadingContent>
					<MudProgressCircular Color="Color.Primary" Indeterminate="true" />
				</LoadingContent>
				<ColGroup>
					<col style="width: 15%;" />
					<col style="width: 25%;" />
					<col style="width: 25%;" />
					<col style="width: 25%;" />
					<col />
				</ColGroup>
				<HeaderContent>
					<MudTh><b>Codigo Apontamento</b></MudTh>
					<MudTh><b>Nº Contrato</b></MudTh>
					<MudTh><b>TM</b></MudTh>
					<MudTh><b>Valor</b></MudTh>
					<MudTh><b></b></MudTh>
				</HeaderContent>
				<RowTemplate>
					@{
						bool isEditing = _idEditacao == context.CoApontamento;
					}
					<MudTd>@context.CoApontamento</MudTd>
					<MudTd>@context.NuContrato - @context.NuContratoDv</MudTd>
					<MudTd>@context.TipoMovimentacao</MudTd>
					<MudTd>R$ @context.VrTotal.ToString() </MudTd>
					<MudTd>
						<MudStack Row="true" Spacing="2">
							<MudTooltip Delay="400" Text="Tratar manual">
								<MudIconButton Icon="@Icons.Material.Filled.Create"
											   Disabled="_desativarBotaoTratativa"
											   OnClick="@(() => EditarMovimentacao(context.CoApontamento, context))"
											   Color="Color.Primary"
											   Size="Size.Small">
								</MudIconButton>
							</MudTooltip>
							<MudTooltip Delay="400" Text="Reprocessar">
								<MudIconButton Disabled="_desativarBotaoTratativa"
											   Icon="@Icons.Material.Filled.Loop"
											   OnClick="()  => LancarMovimentacaoDialog(context,  TiposDeProcessamentoAmortizacaoCaixaAmortizacaoCaixa.REPROCESSAR)"
											   Color="Color.Primary"
											   Size="Size.Small">
								</MudIconButton>
							</MudTooltip>
							<MudTooltip Delay="400" Text="Lançar Total em CCI">
								<MudIconButton Disabled="_desativarBotaoTratativa"
											   Icon="@Icons.Material.Filled.ArrowOutward"
											   OnClick="() => LancarMovimentacaoDialog(context,  TiposDeProcessamentoAmortizacaoCaixaAmortizacaoCaixa.LANCARTOTALCCI)"
											   Color="Color.Primary"
											   Size="Size.Small">
								</MudIconButton>
							</MudTooltip>
							<MudTooltip Delay="400" Text="Exibir detalhes">
								<MudIconButton Disabled="_desativarBotaoTratativa"
											   Icon="@Icons.Material.Filled.Search"
											   Color="Color.Primary"
											   OnClick="@(() => ToggleExpand(context))"
											   Size="Size.Small">
								</MudIconButton>
							</MudTooltip>
						</MudStack>
					</MudTd>
				</RowTemplate>
				<ChildRowContent>
					@if (context.ExpandirObservacao)
					{
						<MudTd ColSpan="5" Class="pa-0">
							<MudSimpleTable Dense Elevation="0" Style="background-color:#f5f5f5;">
								<colgroup>
									<col />
									<col />
								</colgroup>
								<thead>
									<tr>
										<th class="text-center">Log Carga</th>
										<th class="text-center">Log Usuário</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td>
											<MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false">
												@context.LogApontamentos
											</MudField>
										</td>
										<td>
											<MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false">
												@context.LogAcaoUsuario
											</MudField>
										</td>
									</tr>
								</tbody>
							</MudSimpleTable>
						</MudTd>
					}
					@if (context.EmTratamento)
					{
						<MudTd ColSpan="5" Class="pa-0">
							<MudSimpleTable Dense Elevation="0" Style="background-color:#f5f5f5;">

								<colgroup>
									<col style="width: 25%;" />
									<col style="width: 25%;" />
									<col style="width: 25%;" />
									<col style="width: 25%;" />
								</colgroup>

								<tbody>
									<tr>
										<td><MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false" Class="align-self-center">Movimentação 1</MudField></td>
										<td><MudNumericField Typo="Typo.body2" Immediate T="decimal" Min="0" Disabled="context.VrTo01 <= 0" ShrinkLabel HideSpinButtons AutoFocus @bind-Value="context.ValoresCCIEditar.valorCCI01" Label="Lançar em CCI" Variant="Variant.Text" Validation="@(new Func<decimal, string>((cci) => ValidaValorCCI(context.VrTo01, cci)))" /></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Contrato Original" Variant="Variant.Text">R$ @(context.VrTo01 - context.ValoresCCIEditar.valorCCI01)</MudField></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Total" Variant="Variant.Text">R$ @(context.VrTo01)</MudField></td>

									</tr>
									<tr>
										<td><MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false" Class="align-self-center">Movimentação 2</MudField></td>
										<td><MudNumericField Typo="Typo.body2" Immediate T="decimal" Min="0" Disabled="context.VrTo02 <= 0" ShrinkLabel HideSpinButtons @bind-Value="context.ValoresCCIEditar.valorCCI02" Label="Lançar em CCI" Variant="Variant.Text" Validation="@(new Func<decimal, string>((cci) => ValidaValorCCI(context.VrTo02, cci)))" /></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Contrato Original" Variant="Variant.Text">R$ @(context.VrTo02 - context.ValoresCCIEditar.valorCCI02)</MudField></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Total" Variant="Variant.Text">R$ @(context.VrTo02)</MudField></td>
									</tr>
									<tr>
										<td><MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false" Class="align-self-center">Movimentação 3</MudField></td>
										<td><MudNumericField Typo="Typo.body2" Immediate T="decimal" Min="0" Disabled="context.VrTo03 <= 0" ShrinkLabel HideSpinButtons @bind-Value="context.ValoresCCIEditar.valorCCI03" Label="Lançar em CCI" Variant="Variant.Text" Validation="@(new Func<decimal, string>((cci) => ValidaValorCCI(context.VrTo03, cci)))" /></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Contrato Original" Variant="Variant.Text">R$ @(context.VrTo03 - context.ValoresCCIEditar.valorCCI03)</MudField></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Total" Variant="Variant.Text">R$ @(context.VrTo03)</MudField></td>
									</tr>
									<tr>
										<td><MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false" Class="align-self-center">Movimentação 4</MudField></td>
										<td><MudNumericField Typo="Typo.body2" Immediate T="decimal" Min="0" Disabled="context.VrTo04 <= 0" ShrinkLabel HideSpinButtons @bind-Value="context.ValoresCCIEditar.valorCCI04" Label="Lançar em CCI" Variant="Variant.Text" Validation="@(new Func<decimal, string>((cci) => ValidaValorCCI(context.VrTo04, cci)))" /></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Contrato Original" Variant="Variant.Text">R$ @(context.VrTo04 - context.ValoresCCIEditar.valorCCI04)</MudField></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Total" Variant="Variant.Text">R$ @(context.VrTo04)</MudField></td>
									</tr>
									<tr>
										<td><MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false" Class="align-self-center">Movimentação 5</MudField></td>
										<td><MudNumericField Typo="Typo.body2" Min="0" Disabled="context.VrTo05 <= 0" Immediate T="decimal" ShrinkLabel HideSpinButtons @bind-Value="context.ValoresCCIEditar.valorCCI05" Label="Lançar em CCI" Variant="Variant.Text" Validation="@(new Func<decimal, string>((cci) => ValidaValorCCI(context.VrTo05, cci)))" /></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Contrato Original" Variant="Variant.Text">R$ @(context.VrTo05 - context.ValoresCCIEditar.valorCCI05)</MudField></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Total" Variant="Variant.Text">R$ @(context.VrTo05)</MudField></td>
									</tr>
									<tr>
										<td><MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false" Class="align-self-center">Movimentação 6</MudField></td>
										<td><MudNumericField Typo="Typo.body2" Immediate T="decimal" Min="0" Disabled="context.VrTo06 <= 0" ShrinkLabel HideSpinButtons @bind-Value="context.ValoresCCIEditar.valorCCI06" Label="Lançar em CCI" Variant="Variant.Text" Validation="@(new Func<decimal, string>((cci) => ValidaValorCCI(context.VrTo06, cci)))" /></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Contrato Original" Variant="Variant.Text">R$ @(context.VrTo06 - context.ValoresCCIEditar.valorCCI06)</MudField></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Total" Variant="Variant.Text">R$ @(context.VrTo06)</MudField></td>
									</tr>
									<tr>
										<td><MudField Typo="Typo.body2" Variant="Variant.Text" Underline="false" Class="align-self-center">Movimentação 7</MudField></td>
										<td><MudNumericField Typo="Typo.body2" Immediate T="decimal" Min="0" Disabled="context.VrTo07 <= 0" ShrinkLabel HideSpinButtons @bind-Value="context.ValoresCCIEditar.valorCCI07" Label="Lançar em CCI" Variant="Variant.Text" Validation="@(new Func<decimal, string>((cci) => ValidaValorCCI(context.VrTo07, cci)))" /></td>
										<td><MudField Underline="false" Typo="Typo.body2" Label="Contrato Original" Variant="Variant.Text">R$ @(context.VrTo07 - context.ValoresCCIEditar.valorCCI07)</MudField></td>
