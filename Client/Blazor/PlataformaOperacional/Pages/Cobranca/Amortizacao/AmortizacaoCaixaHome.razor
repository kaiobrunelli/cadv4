	private async Task LancarMovimentacaoDialog(MovimentacaoParaAnalise context, TiposDeProcessamentoAmortizacaoCaixaAmortizacaoCaixa tipoProcessametno, ConjuntoTo conjuntoTOParametro = null)
	{

		var parameters = new DialogParameters();
		var options = new DialogOptions() { CloseOnEscapeKey = true };
		var dialog = await DialogService.ShowAsync<DialogCobrancaComentario>("Inserir Observação", options);
		var result = await dialog.Result;
		var conjuntoTO = new ConjuntoTo(0, 0, 0, 0, 0, 0, 0);
		if (!result!.Canceled && result.Data != null)
		{
			var observacaoPreenchidaPeloEmpregado = result.Data as string;
			if (TiposDeProcessamentoAmortizacaoCaixaAmortizacaoCaixa.REPROCESSAR == tipoProcessametno)
			{
				var resetarMovimentacaoFinanceira = new AlteracaoMovimentacaoFinanceira(context.CoMovimentacao, observacaoPreenchidaPeloEmpregado!, conjuntoTO);
				var response = await CobrancaService.ResetarMovimentacaoFinanceira(resetarMovimentacaoFinanceira);
				await HttpResponseHandler.ResponseHandler(response, Snackbar);
			}
			else if (TiposDeProcessamentoAmortizacaoCaixaAmortizacaoCaixa.TRATARMANUAL == tipoProcessametno)
			{
				if (conjuntoTO == null)
				{
					return;
				}
				var resetarMovimentacaoFinanceira = new AlteracaoMovimentacaoFinanceira(context.CoMovimentacao, observacaoPreenchidaPeloEmpregado!, conjuntoTO);
				var response = await CobrancaService.LancarMovimentacaoFinanceiraParcialCci(resetarMovimentacaoFinanceira);
				await HttpResponseHandler.ResponseHandler(response, Snackbar);
			}
			else if (TiposDeProcessamentoAmortizacaoCaixaAmortizacaoCaixa.LANCARTOTALCCI == tipoProcessametno)
			{

				var lancarTotalEmCCI = new AlteracaoMovimentacaoFinanceira(context.CoMovimentacao, observacaoPreenchidaPeloEmpregado!, conjuntoTO);
				var response = await CobrancaService.LancarMovimentacaoFinanceiraTotalEmCci(lancarTotalEmCCI);
				await HttpResponseHandler.ResponseHandler(response, Snackbar);
				context.EmTratamento = false;
			}
			_processandoMovimentacao = true;
			StateHasChanged();
			var responseHttpMessage = await CobrancaService.ConsultarMovimentacoesParaAnalise(_movimentacaoControleGeral.CoControle);
			var movimentacoesParaAnalise = await HttpResponseHandler.ResponseHandler<List<MovimentacaoParaAnalise>>(responseHttpMessage, Snackbar);

			if (movimentacoesParaAnalise != null)
			{
				_movimentacaoesAnalisarDataCache = new List<MovimentacaoParaAnalise>(movimentacoesParaAnalise);
				_movimentacaoesAnalisarData = movimentacoesParaAnalise;

			}
			Snackbar.Add("Ação realizada com sucesso!", Severity.Success);
			StateHasChanged();

			_processandoMovimentacao = false;
		}
	}

	private string ValidaValorCCI(decimal? total, decimal? cci)
	{
		if (cci > total)
		{
			valoresCCIValidos = false;
			return "Valor de CCI supera valor total.";
		}
		valoresCCIValidos = true;
		return string.Empty;
	}

	private void EditarMovimentacao(int? nr, MovimentacaoParaAnalise contexto)
	{
		if(nr is null){
				Snackbar.Add("NR null", Severity.Warning);
		}
		if(contexto is null){
					Snackbar.Add("contexto null", Severity.Warning);
		}
		contexto.ExpandirObservacao = false;
		Movimentacao contrato = _movimentacaoesAnalisarDataCache.FirstOrDefault(f => f.CoApontamento == nr);
		if(contrato is null){
			Snackbar.Add("Movimentação para Analise não encontrada", Severity.Warning);
			return;
		}
		contrato.EmTratamento = !contrato.EmTratamento;
	}



	private ControlePendente ConsultarControlePendenteATratar()
	{
		_controlePendenteTratar = _controlesPentens.OrderBy(d => d.DtReferencia).FirstOrDefault();
		if (_controlePendenteTratar == null)
		{
			_mensagemDataSemRegistroATratar = "Período não encontrado";
			_controlePendenteTratar = new();
		}
		return _controlePendenteTratar;
	}


