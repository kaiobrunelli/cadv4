	public async Task MostrarTabelaMovimentacao(TipoDeMovimentacaoAmortizacaoCaixa tipoMovimentacao)
	{
		if (_controleTabela == tipoMovimentacao)
		{
			_mostrarTabelaMovimentacoes = false;
			_mostrarTabelaDrp = false;
			_mostrarTabelaTratativas = false;
			_mostrarTabelaCCI = false;
			_controleTabela = TipoDeMovimentacaoAmortizacaoCaixa.OUTRO;
			StateHasChanged();
			return;
		}

		_controleTabela = tipoMovimentacao;
		_processandoMovimentacao = true;

		_mostrarTabelaMovimentacoes = false;
		_mostrarTabelaDrp = false;
		_mostrarTabelaTratativas = false;
		_mostrarTabelaCCI = false;

		StateHasChanged();

		switch (tipoMovimentacao)
		{
			case TipoDeMovimentacaoAmortizacaoCaixa.DRP:
				await CarregarMovimentacaoDRP();
				_mostrarTabelaDrp = true;
				break;
			case TipoDeMovimentacaoAmortizacaoCaixa.ANALISAR:
				await CarregarMovimentacaoParaAnalisar();
				_mostrarTabelaTratativas = true;
				break;
			case TipoDeMovimentacaoAmortizacaoCaixa.CCI:
				await CarregarMovimentacaoCCI();
				_mostrarTabelaCCI = true;
				break;
			default:
				await CarregarMovimentacaoGeral(tipoMovimentacao);
				_mostrarTabelaMovimentacoes = true;
				break;
		}
		_processandoMovimentacao = false;
		StateHasChanged();
	}
	private async Task CarregarMovimentacaoGeral(TipoDeMovimentacaoAmortizacaoCaixa tipoMovimentacao)
	{
		_tabelaIsLoading = true;
		if (_movimentacoesGeraisDataCache.TryGetValue(tipoMovimentacao, out var cachedList))
		{
			_movimentacaoesGeraisData = cachedList;
			_tabelaIsLoading = false;
			return;
		}

		var response = tipoMovimentacao switch
		{
			TipoDeMovimentacaoAmortizacaoCaixa.TODAS => await CobrancaService.ConsultarTodasMovimentacoesDoControle(_movimentacaoControleGeral.CoControle),
			TipoDeMovimentacaoAmortizacaoCaixa.AE_CAIXA => await CobrancaService.ConsultarMovimentacoesDeAmortizacao(_movimentacaoControleGeral.CoControle),
			TipoDeMovimentacaoAmortizacaoCaixa.DEV_CAIXA => await CobrancaService.ConsultarMovimentacoesDeDevolucao(_movimentacaoControleGeral.CoControle),
			TipoDeMovimentacaoAmortizacaoCaixa.CCI => await CobrancaService.ConsultarMovimentacoesDeCci(_movimentacaoControleGeral.CoControle),
			_ => null
		};

		var data = await HttpResponseHandler.ResponseHandler<List<MovimentacaoGeral>>(response!, Snackbar);

		if (data != null)
		{
			_movimentacoesGeraisDataCache[tipoMovimentacao] = data;
			_movimentacaoesGeraisData = data;
		}
		else
		{
			_movimentacaoesGeraisData = new List<MovimentacaoGeral>();
		}
		_tabelaIsLoading = false;
	}
