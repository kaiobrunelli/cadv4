@page "/encontrodecontasconfiguracoes"
@using MudBlazor
@using System.Collections.Generic
@using System.Linq
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject CobrancaService CobrancaService
@using MudBlazor.Utilities

<style>

	.card-container {
		width: 100%;
		max-width: 1000px;
		border-radius: 10px;
		background-color: white;
		padding: 20px;
		box-shadow: 0 1px 2px rgba(15, 23, 41, 0.04);
	}

	.background-circle-color {
		background-color: #FAF8F5;
	}

	.header-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	.form-section {
		border: 1px solid #e0e6ed;
		border-radius: 12px;
		padding: 24px;
		margin-top: 24px;
	}

	.form-title {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 16px;
	}

	.form-group {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
	}

	.footer-buttons {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-top: 24px;
	}

	.mud-select .mud-select-input .mud-input-slot {
		color: white;
	}
	.btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 38px;
    padding: 0 14px;
    border-radius: var(--r-md);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.01em;
    border: 1px solid transparent;
    transition: all 120ms ease;
    white-space: nowrap;
}

    .btn:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

.btn-primary {
    background: var(--brand-600);
    color: white;
    border-color: var(--brand-600);
    box-shadow: 0 1px 2px rgba(0, 92, 169, 0.3), inset 0 1px 0 rgba(255,255,255,0.12);
}

    .btn-primary:hover:not(:disabled) {
        background: var(--brand-700);
        border-color: var(--brand-700);
    }

.btn-secondary {
    background: var(--accent-600);
    color: white;
    border-color: var(--accent-600);
    box-shadow: 0 1px 2px rgba(243, 146, 0, 0.25), inset 0 1px 0 rgba(255,255,255,0.14);
}
.app {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

.page {
    flex: 1;
    padding: 24px 28px 48px;
    max-width: 1440px;
    width: 100%;
    margin: 0 auto;
}
</style>


<MudThemeProvider Theme="_customTheme" />
<div class="app">
    <main class="page">


	<div class="card-container pb-2">
		<MudGrid>
			<MudItem xs="12" lg="12" md="12" Class="d-flex justify-space-between">
				<MudText Typo="Typo.h5" Style="color: #64748B;">Configurações</MudText>
				<MudButton Variant="Variant.Outlined"
						   Color="Color.Primary"
						   Size="Size.Small"
						   Style="border-radius:8px;"
						   OnClick="VoltarPagina"					
						   StartIcon="@Icons.Material.Filled.ArrowBack">
					Voltar
				</MudButton>
			</MudItem>
			<MudItem lg="12" md="12">
				<MudGrid Spacing="4" Class="px-4 py-2">
					<MudItem xs="12" md="3" Class="d-flex align-center ">
						<MudAvatar Variant="Variant.Filled" Size="Size.Medium" Class="mr-3 background-circle-color">
							<MudIcon Icon="@Icons.Material.Filled.Apps" Color="Color.Primary" Size="Size.Medium" />
						</MudAvatar>
						<div>
							<MudText Typo="Typo.caption" Style="color: #616161;">Unidade De Movimento</MudText>					

							@if (_configuracoesGerais.UnidadeMovimento == null)
							{
									 <MudSkeleton Animation="Animation.Wave" Width="100%" />

							}
							else
							{
								<MudText Typo="Typo.subtitle1" Class="font-weight-bold">
									@_configuracoesGerais.UnidadeMovimento-@_configuracoesGerais.UnidadeMovimentoDv
								</MudText>
								
							}
						</div>
					</MudItem>

					<MudItem xs="12" md="3" Class="d-flex align-center">
						<MudAvatar Variant="Variant.Filled" Size="Size.Medium" Class="mr-3 background-circle-color">
							<MudIcon Icon="@Icons.Material.Filled.Layers" Color="Color.Primary" Size="Size.Medium" />
						</MudAvatar>
						<div>
							<MudText Typo="Typo.caption" Style="color: #616161;">Quantidade Máxima DRP</MudText>
							@if (_configuracoesGerais.UnidadeMovimento == null)
							{
								<MudSkeleton t Width="60px" Height="18px" />
								<MudSkeleton Animation="Animation.Wave" Width="100%" />

							}
							else
							{
								<MudText Typo="Typo.subtitle1" Class="font-weight-bold">
									@_configuracoesGerais.QtdMaximaPorDrp
								</MudText>
							}
						
						</div>
					</MudItem>

					<MudItem xs="12" md="3" Class="d-flex align-center">
						<MudAvatar Variant="Variant.Filled" Size="Size.Medium" Class="mr-3 background-circle-color">
							<MudIcon Icon="@Icons.Material.Filled.Description" Color="Color.Primary" Size="Size.Medium" />
						</MudAvatar>
						<div>
							<MudText Typo="Typo.caption" Style="color: #616161;">Tipo Execução</MudText>
							<MudText Typo="Typo.subtitle1" Class="font-weight-bold">
						
								Automática
							</MudText>
						</div>
					</MudItem>

					<MudItem xs="12" md="3" Class="d-flex align-center">
						<MudAvatar Variant="Variant.Filled" Size="Size.Medium" Class="mr-3 background-circle-color">
							<MudIcon Icon="@Icons.Material.Filled.Print" Color="Color.Primary" Size="Size.Medium" />
						</MudAvatar>
						<div>
							<MudText Typo="Typo.caption" Style="color: #616161;">Impressora Rede Caixa</MudText>
							<MudText Typo="Typo.subtitle1" Class="font-weight-bold">
								@_configuracoesGerais.ImpressoraVirutalRedeCaixa
							</MudText>
						</div>
					</MudItem>

					<MudItem xs="12" md="12" Class="d-flex align-center">
						<MudAvatar Variant="Variant.Filled" Size="Size.Medium" Class="mr-3 background-circle-color">
							<MudIcon Icon="@Icons.Material.Filled.Folder" Color="Color.Primary" Size="Size.Medium" />
						</MudAvatar>
						<div>
							<MudText Typo="Typo.caption" Style="color: #616161;">Destino Do Arquivo</MudText>
							<MudText Typo="Typo.subtitle1" Class="font-weight-bold">
								@_configuracoesGerais.DestinoArquivo
							</MudText>
						</div>
					</MudItem>
					<MudItem xs="12" sm="12" Class="d-flex align-center">
						<MudAvatar Variant="Variant.Filled" Size="Size.Medium" Class="mr-3 background-circle-color">
							<MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" Size="Size.Medium" />
						</MudAvatar>
						<div>
							<MudText Typo="Typo.caption" Style="color: #616161;">Impressora Server</MudText>
							<MudText Typo="Typo.subtitle1" Class="font-weight-bold">
								@_configuracoesGerais.ImpressoraVirtualServer
							</MudText>
						</div>
					</MudItem>

				</MudGrid>

				<MudDivider Style="height:1.5px;" Class="my-2"></MudDivider>

			</MudItem>
			<MudItem xs="12" lg="12" md="12" Class="pt-2 mb-2">
				<MudStack Row="true" Justify="Justify.FlexEnd">
					<button class="btn btn-secondary" @onclick="AlterarConfiguracao">Editar Configurações</button>	
			
				</MudStack>
			</MudItem>
			@if (_mostrarTabela)
			{
				<MudItem xs="12" lg="12" md="12" Class="pt-2 mb-3">
					<MudItem xs="12" lg="12" md="12" Class="pt-2">
						<MudTable T="HistoricoDeTm" Items="@_historicoDeTms" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Context="HistoricoTm">
							<HeaderContent>
								<MudTh><MudTableSortLabel SortBy="new Func<HistoricoDeTm, object>(x=>x.Processo)">Processo</MudTableSortLabel></MudTh>
								<MudTh><MudTableSortLabel SortBy="new Func<HistoricoDeTm, object>(x=>x.Tipo)">Tipo</MudTableSortLabel></MudTh>
								<MudTh><MudTableSortLabel SortBy="new Func<HistoricoDeTm, object>(x=>x.Tm)">TM</MudTableSortLabel></MudTh>

								<MudTh><b>Histórico</b></MudTh>
								<MudTh Style="width: 80px;"><b>Ações</b></MudTh>
							</HeaderContent>
							<ColGroup>
								<col  />
								<col  />
								<col  />
								<col style="width: 50%;" />
								<col style="width: 15%;" />
							</ColGroup>
							<RowTemplate>
								@{
									bool isEditing = _idEditacao == HistoricoTm.IdModelo;
								}
								<MudTd DataLabel="ID">@HistoricoTm.Processo</MudTd>
								<MudTd DataLabel="ID">@HistoricoTm.Tipo</MudTd>
								<MudTd DataLabel="Tipo de Movimentação">
									<MudChip T="string" Color="@GetColorStatusMudChip(HistoricoTm.Tipo)" Variant="Variant.Text">@HistoricoTm.Tm</MudChip>
								</MudTd>

								<MudTd DataLabel="Histórico">
									@if (isEditing)
									{
										<MudTextField @bind-Value="HistoricoTm.ModeloHistorico"
													  Lines="4" Variant="Variant.Outlined"
													  Margin="Margin.Dense"
													  Typo="Typo.caption"
													  T="string" />
									}
									else
									{
										<MudText Typo="Typo.caption" Class="mud-text-secondary">
											@HistoricoTm.ModeloHistorico
										</MudText>
									}
								</MudTd>

								<MudTd DataLabel="Ações">
									@if (isEditing)
									{
										<MudTooltip Text="Salvar Alterações">
											<MudIconButton Icon="@Icons.Material.Filled.Check"
														   Size="Size.Small"
														   Color="Color.Success"
														   OnClick="@(() => SalvarEdicao(HistoricoTm))" />
										</MudTooltip>
										<MudTooltip Text="Cancelar">
											<MudIconButton Icon="@Icons.Material.Filled.Close"
														   Size="Size.Small"
														   Color="Color.Error"
														   OnClick="@CancelarEdicao" />
										</MudTooltip>
									}
									else
									{
										<MudTooltip Text="Editar Histórico">
											<MudIconButton Icon="@Icons.Material.Filled.Edit"
														   Size="Size.Small"
														   Color="Color.Secondary"
														   OnClick="@(() => EditarHistorico(HistoricoTm))" />
										</MudTooltip>
									}
								</MudTd>
							</RowTemplate>
							<PagerContent>
								<MudTablePager Style="border-bottom-left-radius:8px;border-bottom-right-radius:8px;" RowsPerPageString="@rowsPerPageString" />
							</PagerContent>
						</MudTable>

					</MudItem>


				</MudItem>
			}
		</MudGrid>
	</div>
	</main>
</div>
	


@code {

	private bool _mostrarTabela = false;
	private int _idEditacao = 0;
	private string _historicoOriginal = string.Empty;
	private string rowsPerPageString = "Linhas por página:";
	private ConfiguracoesGerais _configuracoesGerais = new();
	private List<HistoricoDeTm> _historicoDeTms = new();


	private async Task VoltarPagina()
	{
		await JS.InvokeVoidAsync("history.back");
	}
	private MudTheme _customTheme = new()
		{
			PaletteLight = new PaletteLight()
			{
				Primary = "#005ca9",
				Secondary = "#f39200",
				Tertiary = "#FF0000",
				Background = "#EDF2FF"
			}
		};

	protected override async Task OnInitializedAsync()
	{
		await ConsultarConfiguracoesGeraisHandle();
		await ConsultarHistoricoDeTmsHandle();
	}

	private async Task AlterarConfiguracao()
	{
		var parameters = new DialogParameters<DialogConfiguracao>
		{
			{ nameof(DialogConfiguracao.ConfiguracoesGeraisData),_configuracoesGerais}
		};
		var options = new DialogOptions()
		{
			CloseOnEscapeKey = true,
			CloseButton = true,
		};

		var dialog = await DialogService.ShowAsync<DialogConfiguracao>("Inserir Observação", parameters, options);
		var result = await dialog.Result;

		if (result!.Canceled)
		{			
			await ConsultarConfiguracoesGeraisHandle();			
		}
	}


	#region Metodos do Service - Amortização Caixa
	private async Task ConsultarConfiguracoesGeraisHandle()
	{
		var response = await CobrancaService.ConsultarConfiguracoesGerais();
		var responseData = await HttpResponseHandler.ResponseHandler<ConfiguracoesGerais>(response, Snackbar);
		_configuracoesGerais = responseData!;
	}
	private async Task ConsultarHistoricoDeTmsHandle()
	{
		var response = await CobrancaService.ConsultarHistoricoDeTms();
		var responseData = await HttpResponseHandler.ResponseHandler<List<HistoricoDeTm>>(response, Snackbar);
		_historicoDeTms = responseData!;
	}

	#endregion

	#region Metodos Gerais
	private void MostrarTabela()
	{
		_mostrarTabela = !_mostrarTabela;
	}

	private async Task SalvarEdicao(HistoricoDeTm tm)
	{
		await AlterarHistoricoDeTmsHandle(tm.IdModelo, tm.ModeloHistorico);
		_idEditacao = 0;
		_historicoOriginal = string.Empty;
	}
	private async Task AlterarHistoricoDeTmsHandle(int idModelo, string historicoTm)
	{
		var response = await CobrancaService.AlterarHistoricoTms(idModelo, historicoTm);
		 await HttpResponseHandler.ResponseHandler(response, Snackbar);		
		await ConsultarHistoricoDeTmsHandle();
		StateHasChanged();
	}
	private void EditarHistorico(HistoricoDeTm tm)
	{
		_idEditacao = tm.IdModelo;
		_historicoOriginal = tm.ModeloHistorico;
	}
	private void CancelarEdicao()
	{
		if (_idEditacao != 0)
		{
			var tmParaReverter = _historicoDeTms.FirstOrDefault(m => m.IdModelo == _idEditacao);
			if (tmParaReverter != null)
			{
				tmParaReverter.ModeloHistorico = _historicoOriginal;
			}
		}
		_idEditacao = 0;
		_historicoOriginal = string.Empty;
	}
	private Color GetColorStatusMudChip(string tipoTM)
	{
		if (string.IsNullOrEmpty(tipoTM))
		{
			return Color.Default;
		}

		var tipoNormalizado = tipoTM.ToUpperInvariant();

		return tipoNormalizado switch
		{
			"AMORTIZACAO" => Color.Primary,
			"DEVOLUCAO" => Color.Secondary,
			_ => Color.Default,
		};

	}
	#endregion

	public enum TipoConfiguracao
	{
		UNIDADEMOVIMENTO, QUANTIDADEMAXIMADRP, TIPOEXECUCAO, IMPRESSORASERVER, IMPRESSORAREDECAIXA,DESTINOARQUIVO
	}
	public class TipoMovimentacao
	{
		public int Id { get; set; }
		public string TipoMovimentacaoTM { get; set; } = "";
		public string HistoricoAtual { get; set; } = "";
	}





}