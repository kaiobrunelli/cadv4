@page "/EncontroDeContas"

@using Microsoft.Extensions.Options
@using Plataforma.Components.Shared
@using PlataformaOperacional.Pages.Cobranca.Amortizacao
@inject  IOptions<SimulacaoB> Settings
@inject EncontroDeContasService EncontroDeContas
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Navigation
@implements IDisposable
<MudThemeProvider Theme="_customTheme" />
<div class="app">
    <main class="page">
        <PageHead ReferenciaData="@_encontroDeContasControle?.DtInicioExecucao" />
        <ProgressBarECT Executando="@EncontroDeContas.IsRunning"
                        Pct="@EncontroDeContas.ProgressoPercentual"
                        DescricaoEtapas="@EncontroDeContas.DescricaoEtapa"
                        DrescricaoProcesso="@EncontroDeContas.NomeProcesso"
                        CurrentStep="@EncontroDeContas.EtapaAtual"
                        TotalSteps="@EncontroDeContas.TotalEtapas"
                        ExecutandoSP="@EncontroDeContas.ExecutandoSP"
                        ErroSP = "@EncontroDeContas.ErroSP"
                        MensagemErroSP="@EncontroDeContas.MensagemErroSP"
                        TotalProcessado="@EncontroDeContas.ObservadorAutomacaoAPI.TotalProcessado"
                        LocationSignalR="@(_encontroDeContasControle?.PainelControle?.LocationSignalR ?? "")" />
      
        @if (_encontroDeContasControle?.PainelControle is not null)
        {
            
            {
                <Toolbar CanExecute="true"
                         PaginaCarregada="_carregamentoPaginaCompleto"
                         Running="@EncontroDeContas.IsRunning"
                         UseList="@EncontroDeContas.UsarLista"
                         ContagemDeContratos="@(EncontroDeContas.Contratos?.Count() ?? 0)"
                         Controle="@_encontroDeContasControle"
                         OnExecute="IniciarAutomacao"
                         OnCancel="Cancel"
                         OnRelatorioPage="NavegarParaRelatorio"
                         OnConfig="NavegarParaConfiguracoes"
                         OnToggleUseList="ToggleUseList" />

          

            }
        }
      
        <FaseProgresso2_CPT FaseAtual="@_ultimaFaseConsultada"
                            PaginaCarregada="_carregamentoPaginaCompleto"
                            IdDemanda="@_encontroDeContasControle?.CoControle"
                            Executando="@EncontroDeContas.EmExecucaoFase"
                            Fases="@_fasesEncontroDeContas" />     
  
        @if (EncontroDeContas.UsarLista)
        {
            <ContractsPanel Contracts="@EncontroDeContas.Contratos"
                            Running="@EncontroDeContas.IsRunning"
                            OnAdd="AddContract"
                            OnRemove="RemoveContract" />
        }       

        @if (_carregamentoPaginaCompleto)
        {
            <RelatorioConsolidado DadosRelatorio="@_dadosTabelaRelatorio" OnDrpClick="MostrarTabelaDRP" />
        }
        else
        {
            <MetricsSkeleton></MetricsSkeleton>
        }
        <div class="mt-4">
            <MudItem xs="12" lg="12" md="12" Class="@(_mostrarTabelaDrp ? "d-block" : "d-none")">
                <TabelaDRPNova Items="@_movimentacoesDrpData"
                               Loading="_tabelaDRPIsLoading"
                               RowsPerPageString="Itens por página"
                               InfoFormat="{first}–{last} de {total}" />
            </MudItem>
        </div>             
       

        @{
            var alertasHome = EncontroDeContas.IsRunning
            ? EncontroDeContas.AlertasInformativos        
            : EncontroDeContas.Alertas;                   
        }        
        @if (alertasHome.Count > 0)
        {
            <Alerta_CPT Alertas="@alertasHome.ToList()" OnFechar="Fechar" />
        }
    

    </main>
</div>

@code {
    private Severity _severity = new();
    private  SimulacaoB _settings = new();
    private List<FaseEtapas> _fasesEncontroDeContas = new()
    {

        new() { Numero = 1, Titulo = "Gerar Demanda",   Subtitulo = "Fase 1"    },
        new() { Numero = 2, Titulo = "Gerar Relatório",   Subtitulo = "Fase 1" },
        new() { Numero = 3, Titulo = "Carregar ",   Subtitulo = "Fase 1"    },
        new() { Numero = 4, Titulo = "Gerar Relatório",   Subtitulo = "Fase 2" },
        new() { Numero = 5, Titulo = "Carregar",   Subtitulo = "Fase2"  },
        new() { Numero = 6, Titulo = "Incluir ",           Subtitulo = "Condicionais" },
        new() { Numero = 7, Titulo = "Projetar",           Subtitulo = "DRP"   },
        new() { Numero = 8, Titulo = "Emitir",           Subtitulo = "DRP"   },
        new() { Numero = 9, Titulo = "Baixar ",   Subtitulo = "DRP" },
        new() { Numero = 10, Titulo = "Estornar",   Subtitulo = "Condicionais" },
        new() { Numero = 11, Titulo = "Finalizado",   Subtitulo = "" },
    };

    private ReadEncontroDeContasControleDto? _encontroDeContasControle = new()
    {
        PainelControle = new PainelControle
        {
            Botoes = new BotoesConfig(),
            Alertas = new()
        }
    };

    private DadosRelatorioTabela _dadosTabelaRelatorio = new();
    private string? _senhaCriptografada = "";
    private bool _mostrarTabelaDrp = false;
    private bool _tabelaDRPIsLoading = false;
    private List<MovimentacaoDrp> _movimentacoesDrpData = new();
    private bool _carregamentoPaginaCompleto;

    private void MostrarTabelaDRP()
    {
        
        _tabelaDRPIsLoading = true;
        _mostrarTabelaDrp = !_mostrarTabelaDrp;
        _tabelaDRPIsLoading = false;
    }
    private int _etapaInicial = 99;
    protected override async Task OnInitializedAsync()
    {
        EncontroDeContas.TotalDeFases = _fasesEncontroDeContas.Count();
        _etapaInicial = EncontroDeContas.NumeroFaseAtualProgresso;
        var response = await EncontroDeContas.ControleGeralEncontroDeContas();
        _encontroDeContasControle = await HttpResponseHandler.ResponseHandler<ReadEncontroDeContasControleDto>(response, Snackbar);
        if (EncontroDeContas.NumeroFaseAtualProgresso < 0)
        {
            EncontroDeContas.NumeroFaseAtualProgresso = IdentificarFase(_encontroDeContasControle.Situacao);
        }
        _ultimaFaseConsultada = EncontroDeContas.NumeroFaseAtualProgresso;

        await EncontroDeContas.IniciarEscutaSignalR();

        _dadosTabelaRelatorio = new()
        {
            Condicionais = _encontroDeContasControle.QtdCondicionais is null ? 0 : _encontroDeContasControle.QtdCondicionais,
            Reaberturas = _encontroDeContasControle.QtdReaberturas is null ? 0 : _encontroDeContasControle.QtdReaberturas,
            Drp = _encontroDeContasControle.QtdDrps is null ? 0 : _encontroDeContasControle.QtdDrps,
        };

        EncontroDeContas.AlertaControleGeral(
            _encontroDeContasControle.PainelControle?.Alertas ?? new()
        );

        _carregamentoPaginaCompleto = true;
    }

    protected override void OnInitialized()
    {
        _settings = Settings.Value;
        EncontroDeContas.StateChanged += OnStateChanged;
    }
 
    public async Task ConsultaControleGeral()
    {
        var response = await EncontroDeContas.ControleGeralEncontroDeContas();
     
        _encontroDeContasControle = await HttpResponseHandler
            .ResponseHandler<ReadEncontroDeContasControleDto>(response, Snackbar);

        _dadosTabelaRelatorio = new DadosRelatorioTabela
        {
            Condicionais = _encontroDeContasControle?.QtdCondicionais ?? 0,
            Reaberturas = _encontroDeContasControle?.QtdReaberturas ?? 0,
            Drp = _encontroDeContasControle?.QtdDrps ?? 0,
        };        
        EncontroDeContas.AlertaControleGeral(
            _encontroDeContasControle?.PainelControle?.Alertas ?? new()
        );
    }
   
    private int _ultimaFaseConsultada;
    private void OnStateChanged()
    {
        InvokeAsync(async () =>
        {
            StateHasChanged();
            var faseAtual = EncontroDeContas.NumeroFaseAtualProgresso;
            if (faseAtual > 0 && faseAtual > _ultimaFaseConsultada)
            {
                _ultimaFaseConsultada = faseAtual;
                await ConsultaControleGeral();
            }
            StateHasChanged();
        });
    }
  
    private void NavegarParaConfiguracoes()
    {
        Navigation.NavigateTo("encontrodecontasconfiguracoes");
    }
    private void NavegarParaRelatorio()
    {
        Navigation.NavigateTo("Relatorio");
    }
    private int IdentificarFase(string? faseAtual)
    {
        return faseAtual?.ToLower() switch
        {
            "gerar relatório fase 1" => 2,
            "carregar fase 1" => 3,
            "gerar relatório fase 2" => 4,
            "carregar fase 2" => 5,
            "incluir condicionais" => 6,
            "projetar drps" => 7,
            "emitir drps" => 8,
            "baixar drps" => 9,
            "estornar condicionais" => 10,
            "finalizado" => 11,
            _ => 0

        };
    }
  
    private async Task IniciarAutomacao()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters<BoxSenha>
        {
            { x => x.Title, "Iniciar" }
        };
        var dialog = await DialogService.ShowAsync<BoxSenha>("", parameters, options);
        var result = await dialog.Result;

        if (result!.Canceled) return;

        _senhaCriptografada = result.Data?.ToString();
        if (_senhaCriptografada == null) return;

        try
        {
            var usuario = new SenhaUsuario(_senhaCriptografada);
            var response = await EncontroDeContas.ProcessarEncontroDeContas(usuario);
          
            
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Erro HTTP {response.StatusCode}", Severity.Error);
                return;
            }

            var content = await response.Content.ReadAsStringAsync();

            await HttpResponseHandler.ResponseHandler(response, Snackbar);
           
        }
        catch (Exception ex)
        {
            EncontroDeContas.PushAlert(TipoDeAlerta.Err, "Falha ao iniciar execução", ex.Message);
        }
    }

    private async Task Cancel()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters<BoxSenha>
        {
            { x => x.Title, "Cancelar" }
        };
        var dialog = await DialogService.ShowAsync<BoxSenha>("", parameters, options);
        var result = await dialog.Result;

        if (result!.Canceled) return;

        _senhaCriptografada = result.Data?.ToString();
        if (_senhaCriptografada == null) return;

        try
        {
            var usuario = new SenhaUsuario(_senhaCriptografada);
            var response = await EncontroDeContas.CancelarExecucao(usuario);
          
            
            if (!response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Erro HTTP {response.StatusCode}", Severity.Error);
                return;
            }

            var content = await response.Content.ReadAsStringAsync();         
            await HttpResponseHandler.ResponseHandler(response, Snackbar);
           
        }
        catch (Exception ex)
        {
            EncontroDeContas.PushAlert(TipoDeAlerta.Err, "Falha ao cancelar a execução", ex.Message);
        }
  
    }

    private void ToggleUseList(bool usarLista)
    {
        EncontroDeContas.UsarLista = usarLista;
        StateHasChanged();
    }

    private MudTheme _customTheme = new()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = "#005ca9",
            Secondary = "#f39200",
            Background = "#EDF2FF",
        }
    };

    private void AddContract((string numeroContrato, TipoDeMovimentacao tipoMovimentacao) contrato)
        => EncontroDeContas.AddContract(contrato.numeroContrato, contrato.tipoMovimentacao);

    private void RemoveContract(string id) => EncontroDeContas.RemoveContract(id);

    private void Fechar(string id) => EncontroDeContas.FecharAlerta(id);

    public void Dispose() => EncontroDeContas.StateChanged -= OnStateChanged;

    private async Task TestarProgressBarSP()
    {
        await EncontroDeContas.SimularProgressBarSP();
    }
}
